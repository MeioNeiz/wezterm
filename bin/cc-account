#!/bin/bash
# Which claude.ai account a session runs on. Claude Code keeps one login per config folder
# (CLAUDE_CONFIG_DIR, and the keychain item is named after the folder), so two folders hold
# two logins at once and a /login in one never moves the other's sessions. ~/.claude is the
# default account; every other account's folder is links back into it, so all sessions
# share settings, hooks, skills, transcripts and the registry, and the fleet sees them all.
#
# The map is ~/.claude/accounts, kept out of the repo (emails, paths):
#   <name> <config folder> <login email> <folder>...
# A session started under one of the folders gets that account; `*` marks the default.
#
# Overrides lend a folder to another account until a time, ~/.claude/account-overrides:
#   <name> <folder> <until epoch>
# Limits cap an account's usage, ~/.claude/account-limits, read by hooks/cc-limits.sh:
#   <name|*> <folder|*> <5h|7d> <stop> [warn]
# stop is a percentage, or one a day of the window, its first day first: 11,23,47,65,90 (the
# last holds to the end). Every matching line applies, so the strictest wins.
#   <name|*> <folder|*> unlock <Mon..Sun> <HH:MM> [stop]
# lifts the weekly caps there from that time to the account's weekly reset, but for its own
# stop on the week if given; of two open at once, the looser holds. 5h caps still apply.
#   <name|*> <folder|*> fallback <account>
# at a cap there, moves the session to that account instead of stopping it, if that one is
# below its own caps; an account with no such line stops.
#
# Sourced as a library by statusline.sh, cc-spawn and the limits hook, which cannot afford
# a fork:
#   source ~/.claude/bin/cc-account --lib
#   acct_load; acct_for <dir>; acct_start <dir>; acct_current; acct_env <name>
#   acct_suffix <name>; acct_limits <name> <dir>; acct_fallback <name> <dir>

ACCT_FILE="$HOME/.claude/accounts"
ACCT_OVR_FILE="$HOME/.claude/account-overrides"
ACCT_LIM_FILE="$HOME/.claude/account-limits"
ACCT_HOME="$HOME/.claude"
ACCT_NAMES=""
ACCT_DEFAULT=""
ACCT=""
ACCT_BASE=""
ACCT_UNTIL=""
ACCT_OVR_DIR=""
ACCT_OVR=""
ACCT_NOW=0
ACCT_ENV=()
ACCT_LOADED=false

# ACCT_NAMES, ACCT_DEFAULT, and acct_dir_<name>, acct_email_<name>, acct_dirs_<name>;
# ACCT_OVR the live overrides, `name folder until` a line.
# No file means one account and nothing to choose: ACCT_NAMES stays empty
acct_load() {
	$ACCT_LOADED && return 0
	ACCT_LOADED=true
	acct_load_overrides
	[[ -r $ACCT_FILE ]] || return 0
	local name dir email rest d dirs home_name=""
	while read -r name dir email rest; do
		[[ -n $name && $name != \#* && -n $dir ]] || continue
		[[ $name =~ ^[A-Za-z0-9_]+$ ]] || continue
		dir=${dir/#\~/$HOME}
		dir=${dir%/}
		dirs=""
		for d in $rest; do
			if [[ $d == "*" ]]; then
				ACCT_DEFAULT=$name
			else
				d=${d/#\~/$HOME}
				dirs+=" ${d%/}"
			fi
		done
		printf -v "acct_dir_$name" '%s' "$dir"
		printf -v "acct_email_$name" '%s' "${email:--}"
		printf -v "acct_dirs_$name" '%s' "$dirs"
		ACCT_NAMES+=" $name"
		[[ $dir == "$ACCT_HOME" ]] && home_name=$name
	done <"$ACCT_FILE"
	ACCT_NAMES=${ACCT_NAMES# }
	[[ -n $ACCT_DEFAULT ]] || ACCT_DEFAULT=${home_name:-${ACCT_NAMES%% *}}
}

# The clock costs a fork, so only when there is an override to expire
acct_load_overrides() {
	local name dir until
	ACCT_OVR=""
	[[ -s $ACCT_OVR_FILE ]] || return 0
	ACCT_NOW=$(date +%s)
	while read -r name dir until _; do
		[[ $name =~ ^[A-Za-z0-9_]+$ && $until =~ ^[0-9]+$ ]] || continue
		((until > ACCT_NOW)) || continue
		dir=${dir/#\~/$HOME}
		ACCT_OVR+="$name ${dir%/} $until"$'\n'
	done <"$ACCT_OVR_FILE"
}

# ACCT: the account a session started in $1 gets; ACCT_BASE what the map alone says;
# ACCT_UNTIL and ACCT_OVR_DIR when an override lending the folder to ACCT ends, and its
# folder. The longest matching folder wins, an override's over the map's
acct_for() {
	local dir=${1%/} name d k until best=0
	ACCT_BASE=$ACCT_DEFAULT
	ACCT_UNTIL=""
	ACCT_OVR_DIR=""
	for name in $ACCT_NAMES; do
		k="acct_dirs_$name"
		for d in ${!k}; do
			if [[ $dir == "$d" || $dir == "$d"/* ]] && ((${#d} > best)); then
				ACCT_BASE=$name
				best=${#d}
			fi
		done
	done
	ACCT=$ACCT_BASE
	best=0
	while read -r name d until; do
		[[ -n $name ]] || continue
		if [[ $dir == "$d" || $dir == "$d"/* ]] && ((${#d} > best)); then
			ACCT=$name
			ACCT_UNTIL=$until
			ACCT_OVR_DIR=$d
			best=${#d}
		fi
	done <<<"$ACCT_OVR"
}

# Local calendar day of an epoch, so a window's days turn at midnight across a clock change;
# ACCT_OFF its offset from UTC
acct_day() {
	local z off
	if [[ $OSTYPE == darwin* ]]; then
		z=$(date -r "$1" +%z)
	else
		z=$(date -d "@$1" +%z)
	fi
	off=$((10#${z:1:2} * 3600 + 10#${z:3:2} * 60))
	[[ ${z:0:1} == - ]] && off=$((-off))
	ACCT_OFF=$off
	ACCT_DAY=$((($1 + off) / 86400))
}

# Whether the last day $1 at $2 (local) is inside the week that resets at $3: the quota
# left after it is spent or lost at the reset anyway
acct_unlocked() {
	local days=SunMonTueWedThuFriSat want h m wd at
	[[ $3 =~ ^[0-9]+$ ]] && (($3 > ACCT_NOW)) || return 1
	want=${days%%"$1"*}
	((${#want} < 21 && ${#want} % 3 == 0)) || return 1
	want=$((${#want} / 3))
	[[ $2 =~ ^([0-9]{1,2}):([0-9]{2})$ ]] || return 1
	h=$((10#${BASH_REMATCH[1]}))
	m=$((10#${BASH_REMATCH[2]}))
	acct_day "$ACCT_NOW"
	# 1 Jan 1970 was a Thursday
	wd=$(((ACCT_DAY + 4) % 7))
	at=$(((ACCT_DAY - (wd - want + 7) % 7) * 86400 + h * 3600 + m * 60))
	((at - ACCT_OFF > ACCT_NOW)) && at=$((at - 604800))
	# that day's own offset, should the clocks have changed since
	acct_day $((at - ACCT_OFF))
	((at - ACCT_OFF > $3 - 604800))
}

# Whether a limits line for account $1 and folder $2 covers account $3 working in $4
acct_covers() {
	local d=$2
	[[ -n $1 && $1 != \#* ]] && [[ $1 == "*" || $1 == "$3" ]] || return 1
	[[ $d == "*" ]] && return 0
	d=${d/#\~/$HOME}
	d=${d%/}
	[[ $4 == "$d" || $4 == "$d"/* ]]
}

# For account $1 in folder $2, from its rate-limits cache and the limits file:
# LIM_STOP the first cap reached, LIM_WARN the first warning, LIM_TAG the nearest cap as
# "week 21/23%" when a folder rule applies, LIM_KEY what a toast dedupes on. All empty
# when nothing applies or the cache knows nothing
acct_limits() {
	local acct=$1 dir=${2%/} f now pct at stop warn caps start i n
	local r5 r5_at r7 r7_at a d win where ceil allow=-1
	LIM_STOP="" LIM_WARN="" LIM_TAG="" LIM_KEY="" LIM_GAP=0
	[[ -r $ACCT_LIM_FILE ]] || return 0
	acct_suffix "$acct"
	f="$ACCT_HOME/cache/rate-limits$ACCT_SUFFIX"
	[[ -r $f ]] || return 0
	IFS=$'\t' read -r _ r5 r5_at r7 r7_at _ <"$f"
	((ACCT_NOW)) || ACCT_NOW=$(date +%s)
	now=$ACCT_NOW
	# an unlock lifts the week's caps but never the 5h ones, so it is known before either
	while read -r a d win stop warn ceil _; do
		[[ $win == unlock ]] && acct_covers "$a" "$d" "$acct" "$dir" || continue
		[[ $ceil =~ ^[0-9]+$ ]] || ceil=101
		acct_unlocked "$stop" "$warn" "$r7_at" && ((ceil > allow)) && allow=$ceil
	done <"$ACCT_LIM_FILE"
	while read -r a d win stop warn ceil _; do
		[[ -n $stop ]] && acct_covers "$a" "$d" "$acct" "$dir" || continue
		case $win in
		5h) pct=$r5 at=$r5_at n=18000 ;;
		7d)
			((allow < 0)) || continue
			pct=$r7 at=$r7_at n=604800
			;;
		*) continue ;;
		esac
		# past its reset the window is new and its figure unknown, which is as good as 0
		[[ $pct =~ ^[0-9]+$ && $at =~ ^[0-9]+$ ]] && ((at > now)) || continue
		if [[ $stop == *,* ]]; then
			start=$((at - n))
			acct_day "$start"
			i=$ACCT_DAY
			acct_day "$now"
			i=$((ACCT_DAY - i))
			IFS=, read -r -a caps <<<"$stop"
			((i < ${#caps[@]})) || i=$((${#caps[@]} - 1))
			stop=${caps[i]}
		fi
		[[ $stop =~ ^[0-9]+$ ]] || continue
		win=${win/7d/week}
		where=""
		[[ $d != "*" ]] && where=" here"
		if [[ $d != "*" ]] && [[ -z $LIM_TAG || $((stop - pct)) -lt $LIM_GAP ]]; then
			LIM_TAG="$win $pct/$stop%"
			LIM_GAP=$((stop - pct))
		fi
		if [[ -z $LIM_STOP ]] && ((pct >= stop)); then
			LIM_STOP="$acct is at $pct% of its $win limit, capped at $stop%$where"
			LIM_KEY="$acct-$win-$at-stop"
		elif [[ -z $LIM_WARN && $warn =~ ^[0-9]+$ ]] && ((pct >= warn)); then
			LIM_WARN="$acct is at $pct% of its $win limit, stops at $stop%"
			[[ -n $LIM_STOP ]] || LIM_KEY="$acct-$win-$at-warn"
		fi
	done <"$ACCT_LIM_FILE"
	((allow >= 0)) || return 0
	LIM_TAG="unlocked"
	if ((allow <= 100)); then
		LIM_TAG="unlocked to $allow%"
		if [[ -z $LIM_STOP && $r7 =~ ^[0-9]+$ ]] && ((r7 >= allow)); then
			LIM_STOP="$acct is at $r7% of its week limit, unlocked only to $allow%"
			LIM_KEY="$acct-week-$r7_at-stop"
		fi
	fi
	acct_day "$r7_at"
	at=$((r7_at + ACCT_OFF))
	d=SunMonTueWedThuFriSat
	printf -v LIM_TAG '%s till %s %02d:%02d' "$LIM_TAG" "${d:$(((at / 86400 + 4) % 7 * 3)):3}" \
		$((at % 86400 / 3600)) $((at % 3600 / 60))
}

# ACCT_FALLBACK: where account $1 working in $2 goes at a cap; empty when it stops there
# shellcheck disable=SC2034
acct_fallback() {
	local a d win to
	ACCT_FALLBACK=""
	[[ -r $ACCT_LIM_FILE ]] || return 0
	while read -r a d win to _; do
		[[ $win == fallback && -n $to && $to != "$1" ]] || continue
		acct_covers "$a" "$d" "$1" "$2" || continue
		ACCT_FALLBACK=$to
		return 0
	done <"$ACCT_LIM_FILE"
}

# ACCT for a new session in $1: acct_for's, or its fallback when that account is at a cap
# there and the fallback is not. Else the session would start on the capped account, only
# for the limits hook to refuse its first prompt
acct_start() {
	acct_for "$1"
	acct_limits "$ACCT" "$1"
	[[ -n $LIM_STOP ]] || return 0
	acct_fallback "$ACCT" "$1"
	[[ -n $ACCT_FALLBACK ]] || return 0
	acct_limits "$ACCT_FALLBACK" "$1"
	[[ -n $LIM_STOP ]] || ACCT=$ACCT_FALLBACK
}

# ACCT: the account this process runs on, from CLAUDE_CONFIG_DIR
acct_current() {
	local dir=${CLAUDE_CONFIG_DIR:-$ACCT_HOME} name k
	dir=${dir%/}
	ACCT=""
	for name in $ACCT_NAMES; do
		k="acct_dir_$name"
		[[ ${!k} == "$dir" ]] && { ACCT=$name; return 0; }
	done
	if [[ $dir == "$ACCT_HOME" ]]; then
		ACCT=default
	else
		ACCT=${dir##*/}
		ACCT=${ACCT#.claude-}
	fi
}

# ACCT_ENV: the env(1) arguments that start claude on account $1. ~/.claude is reached by
# leaving CLAUDE_CONFIG_DIR unset: set to it, Claude would look for ~/.claude/.claude.json
# and a keychain item of another name, which is a third login
acct_env() {
	local k="acct_dir_$1"
	ACCT_ENV=()
	[[ -n ${!k:-} ]] || return 1
	if [[ ${!k} == "$ACCT_HOME" ]]; then
		ACCT_ENV=(-u CLAUDE_CONFIG_DIR)
	else
		ACCT_ENV=("CLAUDE_CONFIG_DIR=${!k}")
	fi
}

# ACCT_SUFFIX: what tells this account's per-account files apart (cache/rate-limits),
# empty for the default folder's
# shellcheck disable=SC2034
acct_suffix() {
	local k="acct_dir_$1"
	ACCT_SUFFIX=""
	[[ ${!k:-$ACCT_HOME} == "$ACCT_HOME" || $1 == default ]] || ACCT_SUFFIX="-$1"
}

[[ ${1-} == --lib ]] && return 0

set -u
export PATH="$HOME/.claude/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
wzcli() { "$HOME/.claude/bin/wzcli" "$@"; } # 5s deadline, --no-auto-start

# Never shared between accounts: the login and what Claude caches about it. A dotfile is
# never linked either (~/.claude.json is per folder, and Linux keeps .credentials.json here)
own() {
	case $1 in
	backups | daemon* | policy-limits.json* | remote-settings.json* | stats-cache.json | \
		ide | feedback | statsig | settings.json.bak*) return 0 ;;
	esac
	return 1
}
# Copied into a new folder's .claude.json, so its first start skips onboarding and the
# trust dialog. Nothing about the account or its org
readonly SEED='installMethod autoUpdates autoUpdatesProtectedForNative
	hasCompletedOnboarding lastOnboardingVersion lastReleaseNotesSeen deepLinkTerminal hasSeenTasksHint
	hasUsedBackslashReturn workflowSizeGuideline mcpServers githubRepoPaths'
readonly SEED_PROJECT='hasTrustDialogAccepted allowedTools mcpServers enabledMcpjsonServers
	disabledMcpjsonServers hasClaudeMdExternalIncludesApproved
	hasClaudeMdExternalIncludesWarningShown'
readonly CTX_DIR="$HOME/.claude/cache/context"
# Must match cc-board, cc-fleet, cc-handover
readonly PROMPT_CACHE_TTL=3600
# A queued switch, one file a session id: `to\tuntil epoch (0: none)\tname\tqueued epoch`,
# its follow-up prompt in <sid>.then. One watcher serves them all (cc-roster is 0.4s)
readonly SWITCH_DIR="$HOME/.claude/fleet/switch"
readonly SWITCH_POLL=5
# The session environment a plain shell would not have; as cc-spawn's CLEAN_ENV
readonly CLEAN=(-u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT -u CLAUDE_CODE_SESSION_ID
	-u CLAUDE_CODE_CHILD_SESSION -u CLAUDE_CODE_MESSAGING_SOCKET
	-u CLAUDE_CODE_MESSAGING_TOKEN -u CLAUDE_CODE_EXECPATH -u CLAUDE_PID -u AI_AGENT)

usage() {
	cat <<'USAGE'
cc-account - which claude.ai account a session runs on

  cc-account                 this session's account, and the one this folder defaults to
  cc-account status          every account: its folder and who is signed in there
  cc-account for [dir]       the account a session started in dir gets (the fallback
                             while the folder's own is at a cap)
  cc-account of <T>          the account a live session is on
  cc-account login <name>    sign that account's folder in (from a shell, not /login)
  cc-account switch [T] [--to <name>] [--force] [--then <prompt>] [--until <time>]
                             carry on that session (default: this one) on the other
                             account: once its turn ends it closes and resumes in its
                             place, whole conversation. The first reply re-reads all of
                             it at full price, so refused when cold unless --force;
                             cc-handover --new --account is cheaper for a big one;
                             --then sends it a prompt once resumed. It waits for a turn
                             end with only servers left in the background, however long;
                             dropped, with a toast, at --until (default: the end of the
                             override lending its folder to that account, if one does)
  cc-account switch --pending   the switches waiting, and on what
  cc-account switch [T] --cancel
  cc-account use <name> [dir] --until <HH:MM|+2h|+90m|epoch>
                             lend dir (default: here) to that account until then: new
                             sessions there start on it; running ones stay put (switch)
  cc-account use             the overrides still running
  cc-account use --end [dir] end the override covering dir now
  cc-account limits [dir]    every account's usage and the caps that apply in dir
  cc-account link            make or repair the account folders' links (setup.sh does)
  cc-account env [name] [--cwd dir]
                             env(1) arguments starting claude on that account (default:
                             the folder's), one per line; the zsh `claude` uses it

T is a session name, a session id or a pane id, as for cc-roster.

The map is ~/.claude/accounts, one account a line:
  <name> <config folder> <login email> <folder>...
A session started under one of the folders gets that account, `*` marks the default, and
~/.claude must be one of the config folders. `claude --<name>` and `cc-spawn --account`
pick one by hand.

Caps are ~/.claude/account-limits, one a line, every matching line applying:
  <name|*> <folder|*> <5h|7d> <stop%> [warn%]
  work ~/personal/meiolol 7d 11,23,47,65,90    a cap a day of the window, the last holding
  * ~/personal unlock Fri 17:00 [95]             no weekly cap there from then to the reset
                                                 (but 95% of the week, if given; 5h caps hold)
  work * fallback personal                       at a cap, move there rather than stop
At stop, hooks/cc-limits.sh refuses every prompt and tool call there and ends an override
lending the folder to that account; at warn it toasts. Once a window, either way. With a
fallback below its own caps, the session moves to it instead (cc-account switch, resumed
in place) and carries on.
USAGE
}

# epoch for HH:MM (the next one), +Nh, +Nm or an epoch
until_epoch() {
	local t=$1 now h m s
	now=$(date +%s)
	if [[ $t =~ ^\+([0-9]+)([hm])$ ]]; then
		m=${BASH_REMATCH[1]}
		[[ ${BASH_REMATCH[2]} == h ]] && m=$((m * 60))
		echo $((now + m * 60))
	elif [[ $t =~ ^([0-9]{1,2}):([0-9]{2})$ ]]; then
		h=$((10#${BASH_REMATCH[1]})) m=$((10#${BASH_REMATCH[2]}))
		IFS=: read -r _h _m s <<<"$(date +%H:%M:%S)"
		t=$((now - 10#$_h * 3600 - 10#$_m * 60 - 10#$s + h * 3600 + m * 60))
		((t > now)) || t=$((t + 86400))
		echo "$t"
	elif [[ $t =~ ^[0-9]{10}$ ]]; then
		echo "$t"
	else
		return 1
	fi
}

hhmm() {
	if [[ $OSTYPE == darwin* ]]; then date -r "$1" +%H:%M; else date -d "@$1" +%H:%M; fi
}

# Rewrite the live overrides less those covering $1, or only the one on it with $2=exact.
# Expired lines go too
drop_overrides() {
	local dir=${1%/} exact=${2:-} name d until keep=""
	while read -r name d until; do
		[[ -n $name ]] || continue
		[[ $dir == "$d" ]] && continue
		[[ -z $exact && $dir == "$d"/* ]] && continue
		keep+="$name ${d/#$HOME/~} $until"$'\n'
	done <<<"$ACCT_OVR"
	printf '%s' "$keep" >"$ACCT_OVR_FILE.$$" && mv -f "$ACCT_OVR_FILE.$$" "$ACCT_OVR_FILE"
}

die() {
	echo "cc-account: $*" >&2
	exit 1
}

need_accounts() {
	acct_load
	[[ -n $ACCT_NAMES ]] || die "no accounts: write $ACCT_FILE (cc-account --help)"
}

known() {
	local k="acct_dir_$1"
	[[ $1 =~ ^[A-Za-z0-9_]+$ && -n ${!k:-} ]] || die "no account \"$1\" in $ACCT_FILE"
}

# The account a running claude is on, from its environment: ps -E on macOS, /proc on Linux
acct_of_pid() {
	local pid=$1 dir
	if [[ -r /proc/$pid/environ ]]; then
		dir=$(tr '\0' '\n' </proc/"$pid"/environ | sed -n 's/^CLAUDE_CONFIG_DIR=//p')
	else
		dir=$(ps -E -p "$pid" -o command= 2>/dev/null | tr ' ' '\n' |
			sed -n 's/^CLAUDE_CONFIG_DIR=//p' | tail -1)
	fi
	CLAUDE_CONFIG_DIR=$dir acct_current
}

# signed-in email of a folder, or "-"
signed_in() {
	acct_env "$1"
	env "${CLEAN[@]}" "${ACCT_ENV[@]}" claude auth status 2>/dev/null |
		jq -r 'if .loggedIn then .email // "?" else "-" end' 2>/dev/null || echo "-"
}

link_all() {
	local name k dir e base made=0
	for name in $ACCT_NAMES; do
		k="acct_dir_$name"
		dir=${!k}
		[[ $dir == "$ACCT_HOME" ]] && continue
		mkdir -p "$dir" || die "cannot make $dir"
		for e in "$ACCT_HOME"/*; do
			base=${e##*/}
			own "$base" && continue
			if [[ -L $dir/$base ]]; then
				[[ $(readlink "$dir/$base") == "$e" ]] && continue
				ln -sfn "$e" "$dir/$base"
				made=$((made + 1))
			elif [[ ! -e $dir/$base ]]; then
				ln -s "$e" "$dir/$base"
				made=$((made + 1))
			else
				# Claude replaces settings.json by rename when it writes it, which cuts
				# the link: the account then runs on a copy that drifts
				echo "cc-account: $dir/$base is a real file, not a link to $e;" \
					"merge it into $e, delete it, and rerun" >&2
			fi
		done
		seed "$dir/.claude.json"
		((made)) && echo "linked $made into $dir"
		made=0
	done
	return 0
}

# A new folder's .claude.json is empty but for the login: onboarding, trust dialogs and
# release notes would all come round again. Only before the first real start
seed() {
	local file=$1 src="$HOME/.claude.json" tmp
	[[ -r $src ]] || return 0
	[[ -f $file ]] && jq -e '.hasCompletedOnboarding' "$file" >/dev/null 2>&1 && return 0
	tmp=$(mktemp) || return 0
	# what the folder already has (its login) wins over the seed
	jq --arg keys "$SEED" --arg pkeys "$SEED_PROJECT" --slurpfile have <(
		if [[ -s $file ]]; then cat "$file"; else echo '{}'; fi) '
		($keys | split("\\s+"; null) | map(select(. != ""))) as $k
		| ($pkeys | split("\\s+"; null) | map(select(. != ""))) as $pk
		| (with_entries(select(.key as $x | $k | index($x)))
		   + { projects: ((.projects // {}) | map_values(
				with_entries(select(.key as $x | $pk | index($x))))) })
		  * $have[0]
	' "$src" >"$tmp" 2>/dev/null && [[ -s $tmp ]] && mv -f "$tmp" "$file" &&
		chmod 600 "$file" && echo "seeded $file"
	rm -f "$tmp"
}

# warm or cold, as every reader decides it: expires_at, else last activity + the TTL
cache_cold() {
	local sid=$1 seen_ms=$2 exp="-" now
	now=$(date +%s)
	[[ -r $CTX_DIR/$sid ]] && IFS=$'\t' read -r _ _ _ exp _ <"$CTX_DIR/$sid"
	[[ $exp =~ ^[0-9]+$ ]] || exp=$((${seen_ms:-0} / 1000 + PROMPT_CACHE_TTL))
	((now > exp))
}

# The resume that replaces the session's pane, one argument a line
switch_spawn() {
	local sid=$1 to=$2 pane=$3 cwd=$4 pid=$5 follow=$6 effort
	printf '%s\n' cc-spawn --replace "$pane" --resume "$sid" --account "$to" --cwd "$cwd"
	# effort is per process and a resume starts at the default; a /effort since is lost
	effort=$(ps -o command= -p "$pid" 2>/dev/null |
		sed -n 's/.*--effort[ =]\([a-z]*\).*/\1/p')
	[[ -n $effort ]] && printf '%s\n' --effort "$effort"
	[[ -n $follow ]] && printf '%s\n' -- "$follow"
}

switch_toast() {
	"$HOME/.claude/bin/wz" notify --sticky "$1" "$2" </dev/null >/dev/null 2>&1 &
}

# Detached and alone: a mkdir lock holding the watcher's pid
switch_start_watcher() {
	local lock="$SWITCH_DIR/.watcher" pid=""
	if [[ -d $lock ]]; then
		{ IFS= read -r pid <"$lock/pid"; } 2>/dev/null
		[[ -n $pid ]] && kill -0 "$pid" 2>/dev/null && return 0
	fi
	nohup "$HOME/.claude/bin/cc-account" switch --watch </dev/null >/dev/null 2>&1 &
	disown 2>/dev/null
}

# Every queued switch, until none is left: a session goes when its turn has ended and
# nothing of its own runs in the background but servers, which a resume would kill (the
# resumed session is told what stopped). Waits as long as that takes; a switch is dropped,
# with a toast, only when its --until (its override's end) passes or the resume fails. A
# session that has gone (closed, handed over) takes its switch with it
switch_watch() {
	local lock="$SWITCH_DIR/.watcher" f sid to until name queued roster row status pane cwd
	local pid now follow tasks stopped spawn line old
	mkdir "$lock" 2>/dev/null || {
		{ IFS= read -r old <"$lock/pid"; } 2>/dev/null
		[[ -n $old ]] && kill -0 "$old" 2>/dev/null && return 0
		rm -rf "$lock"
		mkdir "$lock" 2>/dev/null || return 0
	}
	echo $$ >"$lock/pid"
	# expanded now: the local is gone by the time EXIT fires, and set -u stops the trap
	# shellcheck disable=SC2064
	trap "rm -rf '$lock'" EXIT
	trap '' HUP
	while :; do
		set -- "$SWITCH_DIR"/*-*-*-*-*
		[[ -e $1 ]] || return 0
		roster=$(cc-roster 2>/dev/null)
		[[ -n $roster ]] || { sleep "$SWITCH_POLL"; continue; }
		now=$(date +%s)
		for f in "$@"; do
			sid=${f##*/}
			[[ $sid == *.then ]] && continue
			IFS=$'\t' read -r to until name queued <"$f" || continue
			row=$(printf '%s\n' "$roster" | awk -F'\t' -v s="$sid" '$1 == s { print; exit }')
			if [[ -z $row ]]; then
				rm -f "$f" "$f.then"
				continue
			fi
			IFS=$'\x1f' read -r _ name status _ pane cwd pid _ <<<"${row//$'\t'/$'\x1f'}"
			if [[ $until =~ ^[0-9]+$ ]] && ((until && now > until)); then
				rm -f "$f" "$f.then"
				switch_toast "Switch to $to dropped: $name" \
					"Still mid-turn or running a background task at $(hhmm "$until"), so it stays."
				continue
			fi
			acct_of_pid "$pid"
			[[ $ACCT == "$to" ]] && { rm -f "$f" "$f.then"; continue; }
			[[ $pane =~ ^[0-9]+$ ]] || continue
			stopped=""
			case $status in
			busy | asking) continue ;;
			shell)
				tasks=$("$HOME/.claude/bin/ccx" --tasks "$pid" 2>/dev/null)
				printf '%s\n' "$tasks" | awk -F'\t' '$2 == "-" { f = 1 } END { exit !f }' &&
					continue
				stopped=$(printf '%s\n' "$tasks" | awk -F'\t' 'NF { print "- `" $3 "`" }')
				;;
			esac
			follow=""
			[[ -r $f.then ]] && follow=$(<"$f.then")
			if [[ -n $stopped ]]; then
				follow="${follow:+$follow

}Moving you to $to stopped these background servers of yours; restart any you still need:
$stopped"
			fi
			spawn=()
			while IFS= read -r line; do spawn+=("$line"); done < <(switch_spawn "$sid" "$to" \
				"$pane" "$cwd" "$pid" "")
			[[ -n $follow ]] && spawn+=(-- "$follow")
			local doomed=""
			[[ -n $stopped ]] && doomed=$("$HOME/.claude/bin/ccx" --descendants "$pid")
			rm -f "$f" "$f.then"
			if "${spawn[@]}" </dev/null >/dev/null 2>&1; then
				# shellcheck disable=SC2086 # a pid a word
				[[ -n $doomed ]] && kill $doomed 2>/dev/null
			else
				switch_toast "Switch to $to failed: $name" "cc-spawn could not resume it in pane $pane."
			fi
		done
		sleep "$SWITCH_POLL"
	done
}

# Each queued switch and what it waits on; starts the watcher if one is needed
switch_pending() {
	local f sid to until name queued roster status any=false
	roster=$(cc-roster 2>/dev/null)
	for f in "$SWITCH_DIR"/*-*-*-*-*; do
		[[ -e $f && $f != *.then ]] || continue
		IFS=$'\t' read -r to until name queued <"$f" || continue
		sid=${f##*/}
		status=$(printf '%s\n' "$roster" | awk -F'\t' -v s="$sid" '$1 == s { print $3; exit }')
		printf '%s | to %s | queued %s | %s%s\n' "$name" "$to" "$(hhmm "$queued")" \
			"${status:-gone}" "$( ((until)) && echo " | until $(hhmm "$until")")"
		any=true
	done
	$any || { echo "no switches pending"; return 0; }
	switch_start_watcher
}

cmd=${1:-}
(($#)) && shift
case $cmd in
"" | which)
	need_accounts
	acct_current
	mine=$ACCT
	acct_for "$PWD"
	if [[ -n ${CLAUDECODE:-} || -n ${CLAUDE_CODE_SESSION_ID:-} ]]; then
		echo "this session: $mine"
	else
		echo "this shell: $mine"
	fi
	echo "here ($PWD): $ACCT"
	;;
status)
	need_accounts
	for name in $ACCT_NAMES; do
		k="acct_dir_$name"
		e="acct_email_$name"
		got=$(signed_in "$name")
		note=""
		if [[ $got == "-" ]]; then
			note="not signed in: cc-account login $name"
		elif [[ ${!e} != "-" && $got != "${!e}" ]]; then
			note="expected ${!e}"
		fi
		mark=""
		[[ $name == "$ACCT_DEFAULT" ]] && mark=" (default)"
		printf '%s%s | %s | %s%s\n' "$name" "$mark" "${!k/#$HOME/~}" "$got" \
			"${note:+ | $note}"
	done
	;;
for)
	need_accounts
	acct_start "${1:-$PWD}"
	echo "$ACCT"
	;;
of)
	[[ -n ${1:-} ]] || die "of needs a session"
	acct_load
	row=$(cc-roster --row "$1") || die "no live session \"$1\""
	pid=$(printf '%s' "$row" | cut -f7)
	acct_of_pid "$pid"
	echo "$ACCT"
	;;
env)
	acct_load
	name="" cwd=$PWD
	while (($#)); do
		case $1 in
		--cwd) shift; cwd=${1:-$PWD} ;;
		*) name=$1 ;;
		esac
		shift
	done
	# no map: leave the environment as it is
	[[ -n $ACCT_NAMES ]] || exit 0
	if [[ -z $name ]]; then
		acct_start "$cwd"
		name=$ACCT
	fi
	known "$name"
	acct_env "$name"
	printf '%s\n' "${ACCT_ENV[@]}"
	;;
use)
	need_accounts
	if (($# == 0)); then
		[[ -n $ACCT_OVR ]] || { echo "no overrides"; exit 0; }
		while read -r name d until; do
			[[ -n $name ]] && echo "${d/#$HOME/~} on $name until $(hhmm "$until")"
		done <<<"$ACCT_OVR"
		exit 0
	fi
	name="" dir=$PWD until="" end=false
	while (($#)); do
		case $1 in
		--until) shift; until=${1:-} ;;
		--end) end=true ;;
		-*) die "unknown option $1" ;;
		*) if [[ -z $name ]] && ! $end; then name=$1; else dir=$1; fi ;;
		esac
		shift
	done
	dir=$(cd "$dir" 2>/dev/null && pwd) || die "no folder $dir"
	if $end; then
		acct_for "$dir"
		[[ -n $ACCT_UNTIL ]] || die "no override covers ${dir/#$HOME/~}"
		drop_overrides "$dir"
		echo "${dir/#$HOME/~} is back on $ACCT_BASE"
		exit 0
	fi
	known "$name"
	[[ -n $until ]] || die "use needs --until"
	until=$(until_epoch "$until") || die "--until takes HH:MM, +2h, +90m or an epoch"
	acct_limits "$name" "$dir"
	[[ -z $LIM_STOP ]] || die "$LIM_STOP"
	drop_overrides "$dir" exact
	echo "$name ${dir/#$HOME/~} $until" >>"$ACCT_OVR_FILE"
	acct_for "$dir"
	echo "${dir/#$HOME/~} on $name until $(hhmm "$until"), then $ACCT_BASE again." \
		"Running sessions keep theirs: cc-account switch"
	;;
limits)
	need_accounts
	dir=$(cd "${1:-$PWD}" 2>/dev/null && pwd) || die "no folder ${1:-}"
	ACCT_NOW=$(date +%s)
	for name in $ACCT_NAMES; do
		acct_suffix "$name"
		f="$ACCT_HOME/cache/rate-limits$ACCT_SUFFIX"
		r5=- r7=- r5_at=0 r7_at=0
		[[ -r $f ]] && IFS=$'\t' read -r _ r5 r5_at r7 r7_at _ <"$f"
		[[ $r5_at =~ ^[0-9]+$ ]] && ((r5_at > ACCT_NOW)) || r5=-
		[[ $r7_at =~ ^[0-9]+$ ]] && ((r7_at > ACCT_NOW)) || r7=-
		acct_limits "$name" "$dir"
		printf '%s | 5h %s%% | week %s%%' "$name" "$r5" "$r7"
		[[ -n $LIM_TAG ]] && printf ' | here %s' "$LIM_TAG"
		if [[ -n $LIM_STOP ]]; then
			printf ' | STOPPED: %s' "$LIM_STOP"
		elif [[ -n $LIM_WARN ]]; then
			printf ' | warning: %s' "$LIM_WARN"
		fi
		echo
	done
	;;
link)
	acct_load
	link_all
	;;
login)
	need_accounts
	[[ -n ${1:-} ]] || die "login needs an account: $ACCT_NAMES"
	known "$1"
	link_all
	acct_env "$1"
	e="acct_email_$1"
	args=(claude auth login)
	[[ ${!e} != "-" ]] && args+=(--email "${!e}")
	echo "signing $1 in; sessions on other accounts are not touched"
	exec env "${CLEAN[@]}" "${ACCT_ENV[@]}" "${args[@]}"
	;;
switch)
	need_accounts
	target="" to="" force=false dry=false follow="" until="" mode=queue
	while (($#)); do
		case $1 in
		--to) shift; to=${1:-}; [[ -n $to ]] || die "--to needs an account" ;;
		--then) shift; follow=${1:-} ;;
		--until) shift; until=${1:-} ;;
		--force) force=true ;;
		--dry-run) dry=true ;;
		--cancel) mode=cancel ;;
		--pending) mode=pending ;;
		--watch) mode=watch ;;
		-*) die "unknown option $1" ;;
		*) target=$1 ;;
		esac
		shift
	done
	mkdir -p "$SWITCH_DIR"
	case $mode in
	watch) switch_watch; exit 0 ;;
	pending) switch_pending; exit 0 ;;
	esac
	target=${target:-${WEZTERM_PANE:-}}
	[[ -n $target ]] || die "switch which session? (not in a wezterm pane)"
	row=$(cc-roster --row "$target") || die "no live session \"$target\""
	# detail is often empty, and a tab IFS would fold it away
	IFS=$'\x1f' read -r sid name _ _ pane cwd pid seen _ <<<"${row//$'\t'/$'\x1f'}"
	if [[ $mode == cancel ]]; then
		[[ -e $SWITCH_DIR/$sid ]] || die "no switch pending for $name"
		rm -f "$SWITCH_DIR/$sid" "$SWITCH_DIR/$sid.then"
		echo "$name stays where it is"
		exit 0
	fi
	[[ $pane =~ ^[0-9]+$ ]] || die "$name has no pane to resume in"
	acct_of_pid "$pid"
	from=$ACCT
	if [[ -z $to ]]; then
		set -- $ACCT_NAMES
		(($# == 2)) || die "more than two accounts: say which with --to"
		to=$1
		[[ $to == "$from" ]] && to=$2
	fi
	known "$to"
	[[ $to != "$from" ]] || die "$name is already on $to"
	if ! $force && cache_cold "$sid" "$seen"; then
		die "$name is cold: resuming re-reads its whole context. cc-handover $sid --new \
--account $to starts fresh with a brief; --force resumes anyway"
	fi
	if [[ -n $until ]]; then
		until=$(until_epoch "$until") || die "--until takes HH:MM, +2h, +90m or an epoch"
	else
		# for the override that lends its folder to $to, it lasts as long as that does
		acct_for "$cwd"
		until=0
		[[ $ACCT == "$to" && -n $ACCT_UNTIL ]] && until=$ACCT_UNTIL
	fi
	if $dry; then
		printf '%s -> %s: %s\n' "$from" "$to" "$(switch_spawn "$sid" "$to" "$pane" "$cwd" \
			"$pid" "$follow" | tr '\n' ' ')"
		exit 0
	fi
	printf '%s\t%s\t%s\t%s\n' "$to" "$until" "$name" "$(date +%s)" >"$SWITCH_DIR/$sid"
	if [[ -n $follow ]]; then
		printf '%s' "$follow" >"$SWITCH_DIR/$sid.then"
	else
		rm -f "$SWITCH_DIR/$sid.then"
	fi
	switch_start_watcher
	printf '%s moves from %s to %s at the end of a turn with %s, resumed in place (pane %s)%s\n' \
		"$name" "$from" "$to" "nothing but servers left running in its background" "$pane" \
		"$( ((until)) && echo "; dropped at $(hhmm "$until") if it has not happened")"
	;;
-h | --help | help) usage ;;
*) die "unknown command \"$cmd\" (cc-account --help)" ;;
esac
