#!/bin/bash
# Every Claude session in a workspace on one screen, coloured by what it wants from you.
# Grid when wide, rows below 88 columns; the selected row opens underneath itself. The
# one thing only this knows: a closing line that ends in a question. docs/cc-board.md
#
# bash 3.2. Fields travel on a unit separator, because tab is IFS whitespace and an empty
# field would fold into its neighbour.

set -u
# file mtime: BSD stat on macOS; GNU elsewhere, where `stat -f` means the filesystem
if [[ $OSTYPE == darwin* ]]; then MTIME=(-f %m); else MTIME=(-c %Y); fi

readonly FLEET="$HOME/.claude/bin/cc-fleet"
# Sourced: a fork per row is what the render path may not do.
# shellcheck source=bin/cc-colour
source "$HOME/.claude/bin/cc-colour" --lib
readonly ROSTER_CACHE="$HOME/.claude/cache/fleet-rows"
readonly PANE_MAP="$HOME/.claude/wezterm-sessions"
readonly PANE_STATE="$HOME/.claude/wezterm-state"
readonly US=$'\x1f'
readonly STALE_SECS=$((8 * 3600))
# Must match FRESH_SECONDS in wezterm.lua, or the two ✓ age out apart.
readonly FRESH_SECS=90
readonly REFRESH_SECS=6
# Must match PARKED_* in wezterm.lua and cc-roster. A Monitor cannot outlive an hour.
readonly PARKED_MONITOR_MAX=3600
readonly PARKED_MAX=14400
readonly CACHE_TTL=${CC_CACHE_TTL:-3600}
# Every clock is arithmetic on NOW and TZOFF, never a date fork per row. A timestamp from
# across a DST change reads an hour out.
NOW=0
TZOFF=0
NOW0=0
SEC0=0
DAYNAME=(Sun Mon Tue Wed Thu Fri Sat)
MONNAME=(Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec)

stamp_now() {
	local s
	s=$( { date '+%s %z'; } 2>/dev/null)
	NOW=${s%% *}
	[[ $NOW =~ ^[0-9]+$ ]] || NOW=0
	s=${s##* }
	if [[ $s =~ ^[+-][0-9][0-9][0-9][0-9]$ ]]; then
		TZOFF=$((10#${s:1:2} * 3600 + 10#${s:3:2} * 60))
		[[ ${s:0:1} == - ]] && TZOFF=$((-TZOFF))
	fi
	NOW0=$NOW
	SEC0=$SECONDS
}

# NOW moved on by $SECONDS since the last stamp_now, without a fork.
tick_now() {
	((NOW0 > 0)) && NOW=$((NOW0 + SECONDS - SEC0))
	return 0
}

readonly BLUE=$'\033[38;2;135;215;250m'
readonly MAUVE=$'\033[38;2;203;166;247m'
readonly GREEN=$'\033[38;2;166;227;161m'
readonly YELLOW=$'\033[38;2;249;226;175m'
readonly ORANGE=$'\033[38;2;250;179;135m'
# The tab bar's waiting colour, not Mocha peach, so ✓ and a stopped ● are a hue apart.
readonly AMBER=$'\033[38;2;255;215;175m'
readonly RED=$'\033[38;2;243;139;168m'
readonly TEXT=$'\033[38;2;205;214;244m'
# DIM and FAINT for text, RULE only for things that are not text.
readonly DIM=$'\033[38;2;147;153;178m'
readonly FAINT=$'\033[38;2;127;132;156m'
readonly RULE=$'\033[38;2;88;91;112m'
readonly SELECTED=$'\033[48;2;49;50;68m'
readonly MARKED=$'\033[48;2;69;71;90m'
readonly BOLD=$'\033[1m'
readonly RESET=$'\033[0m'

# Repaint in place with these, never a clear-screen, or the frame blinks.
readonly EOL=$'\033[K'
readonly EOS=$'\033[J'
readonly HOME_POS=$'\033[H'

usage() {
	cat <<'USAGE'
cc-board - every Claude session in a workspace, on one screen

  cc-board                 the workspace this pane is in
  cc-board <workspace>     a named workspace instead
  cc-board --all           the whole machine, grouped by workspace
  cc-board --rows          start in rows rather than in the grid
  cc-board --once          print one frame and exit
  cc-board --watch         redraw on a loop, no keyboard
  cc-board --tsv           ws, pane, name, state, asks, idle, pct, title, last-line, colour -
                           the enriched roster, for the wezterm pickers and for scripts

  h j k l  move            enter  jump to it          m  mark / unmark
  v        grid or rows    x      close it            M  move marked onto this tab
  t        regroup         c      hide cold           /  filter    r refresh    q leave

Grid view is a frame per session: state, name, time since your last prompt, the topic, and
context drawn as a bar. It wants about ninety columns a frame, which a full width tab has
and a split of one does not.

Below that the board switches to rows: one line a session at any width, where the line is
state, topic, age and the bar, and the selected line opens underneath itself for the name to
address it by, where it is, and the whole of what it last said. v toggles the two wherever
both fit. A mauve frame or line is waiting on you: either blocked on a permission prompt, or
its closing line was a question nobody answered.

Grouping starts from the tab a session physically sits in, so the view is your own layout.
t cycles it: tab, then state, then the prefix before a colon in the session name, which is
an axis you create yourself with /rename billing:invoices.

In wezterm LEADER+b opens this zoomed down the left of the tab and puts it away again;
LEADER+z unzooms to the tab with the board still beside it, LEADER+; is the quick fuzzy jump.
USAGE
}

workspace=""
mode=interactive
view=grid
all=false

while (($#)); do
	case $1 in
	--once) mode=once ;;
	--tsv) mode=tsv ;;
	--watch) mode=watch ;;
	--grid) view=grid ;;
	--list | --rows) view=rows ;;
	--all) all=true ;;
	-h | --help)
		usage
		exit 0
		;;
	-*)
		usage >&2
		exit 2
		;;
	*) workspace=$1 ;;
	esac
	shift
done

work=$(mktemp -d) || exit 1
# Only undone if done: --tsv must not end its output with an alt-screen restore.
ALTSCREEN=false
CURSOR_HIDDEN=false
cleanup() {
	# A kill inside esc_tail would otherwise leave the tty raw.
	[[ -n ${TTY_SAVED:-} ]] && stty "$TTY_SAVED" </dev/tty 2>/dev/null
	$CURSOR_HIDDEN && printf '\033[?25h'
	$ALTSCREEN && printf '\033[?1049l'
	rm -rf "$work"
}
trap cleanup EXIT INT TERM

# ---------------------------------------------------------------- reading the panes

# Candidate closing lines above the input box, nearest first: the bottom one is often a
# thinking summary. Chrome is judged in the shell, where a glyph compares whole.
readonly LASTLINE_AWK='
{ buf[NR] = $0 }
END {
	rules = 0
	found = 0
	for (i = NR; i > 0 && found < 6; i--) {
		line = buf[i]
		gsub(/^[ \t]+|[ \t]+$/, "", line)
		# Literal sequences, not a bracket expression: this awk is byte-based.
		if (line ~ /^───/ || line ~ /^━━━/ || line ~ /^---/) { rules++; continue }
		if (rules < 2) continue
		if (line == "") continue
		if (line ~ /new task\?/) continue
		if (line ~ /\(click\)/) continue
		if (line ~ /Update installed/) continue
		if (line ~ /Tip: /) continue
		print line
		found++
	}
}'

# Markers Claude puts at the head of a line, and the startup banner's blocks.
LEADERS=("▎" "⎿" "│" "⏺" "✽" "✻" "✳" "✢" "✶" "◐" "◓" "◑" "◒" "·" ">"
	"▝" "▘" "▖" "▗" "▛" "▜" "▙" "▟" "█" "▐" "▌" "▀" "▄")

# Glyphs that lead a pane title, so the first frame gets a topic for free.
STATUS_GLYPHS=("✳" "✻" "✽" "◐" "◓" "◑" "◒" "⚠" "›" "·" "▤" "⏺")

STRIPPED=""
strip_leaders() {
	local line=$1 lead changed=true
	while $changed; do
		changed=false
		line=${line#"${line%%[![:space:]]*}"}
		for lead in "${LEADERS[@]}"; do
			if [[ $line == "$lead"* ]]; then
				line=${line#"$lead"}
				changed=true
			fi
		done
	done
	STRIPPED=${line%"${line##*[![:space:]]}"}
}

# Progress and thinking summaries, matched by shape: the verbs rotate.
is_chrome() {
	case $1 in
	# Nothing alphabetic: a rule, a progress bar, the banner.
	*[a-zA-Z]*) ;;
	*) return 0 ;;
	esac
	case $1 in
	# No space: a path or a command fragment, not a sentence.
	*" "*) ;;
	*) return 0 ;;
	esac
	case $1 in
	"Tip: "*) return 0 ;;
	*"Claude Code v"*) return 0 ;;
	*"· done "[0-9]*) return 0 ;;
	[A-Z]*" for "[0-9]*) return 0 ;;
	[A-Z]*"… ("*) return 0 ;;
	"("*")") return 0 ;;
	esac
	return 1
}

read_pane() {
	local pane=$1 text ctx line last=""
	text=$(wezterm cli get-text --pane-id "$pane" 2>/dev/null)
	while IFS= read -r line; do
		strip_leaders "$line"
		line=$STRIPPED
		((${#line} < 3)) && continue
		is_chrome "$line" && continue
		last=$line
		break
	done < <(printf '%s\n' "$text" | awk "$LASTLINE_AWK")
	ctx=$(printf '%s\n' "$text" | grep -o '[0-9]\+% of [0-9]\+[kM]' | tail -1)
	# "30% of 1M" -> "30"
	ctx=${ctx%% *}
	printf '%s%s%s\n' "$last" "$US" "${ctx%\%}" >"$work/tail.$pane"
}

# ---------------------------------------------------------------- the model

E_PANE=()
E_NAME=()
E_KIND=()
E_DETAIL=()
E_IDLE=()
E_TURNS=()
E_TITLE=()
E_LAST=()
E_PCT=()
E_ASKS=()
E_WS=()
E_TAB=()
E_TABLABEL=()
E_POS=()
E_DIR=()
E_ID=()
E_SINCE=()
E_HAVE=()
E_HKIND=()
E_GEOM=()
BRANCH=""
DIRTY=0
WAITING=0
LOADED_AT=0
ROSTER=""
MARKED_PANES="|"
UNCONFIRMED="|"

# Marks belong to the session rather than to a row, so they survive every rescan.
is_marked() { [[ $MARKED_PANES == *"|$1|"* ]]; }

# Row key -> index into the E_ arrays: ix_<pane>, or ix_s_<session> for a row with no pane.
IXKEYS=()
IXKEY=""
ix_key() {
	if [[ $1 == "-" ]]; then IXKEY="ix_s_${2//[^A-Za-z0-9]/_}"; else IXKEY="ix_$1"; fi
}
ix_set() {
	printf -v "$1" '%s' "$2"
	IXKEYS[${#IXKEYS[@]}]=$1
}
ix_reset() {
	local k
	for k in ${IXKEYS[@]+"${IXKEYS[@]}"}; do unset "$k"; done
	IXKEYS=()
}

# Lookup tables as variables named after their key (CLAUDE.md: never a |k=v| string).
MAPKEYS=()
map_reset() {
	local k
	for k in ${MAPKEYS[@]+"${MAPKEYS[@]}"}; do unset "$k"; done
	MAPKEYS=()
}
map_set() {
	printf -v "$1" '%s' "$2"
	MAPKEYS[${#MAPKEYS[@]}]=$1
}

scan_hook_maps() {
	local f p sid st at dt sd k line lim
	for f in "$PANE_MAP"/*; do
		[[ -r $f ]] || continue
		IFS= read -r sid <"$f" || continue
		[[ -n $sid ]] || continue
		p=${f##*/}
		[[ $p =~ ^[0-9]+$ ]] || continue
		map_set "hk_sid_$p" "$sid"
	done
	for f in "$PANE_STATE"/*; do
		[[ -r $f ]] || continue
		# Split by hand: tab is IFS whitespace, so `IFS=$'\t' read` folds the empty detail
		# of a working/done record and hands the session id to dt instead of sd.
		IFS= read -r line <"$f" || continue
		st=${line%%$'\t'*}
		line=${line#*$'\t'}
		at=${line%%$'\t'*}
		line=${line#*$'\t'}
		dt=${line%%$'\t'*}
		sd=""
		[[ $line == *$'\t'* ]] && sd=${line#*$'\t'}
		p=${f##*/}
		[[ $p =~ ^[0-9]+$ ]] || continue
		# Panes outlive sessions; a record with no sid predates the stamp and is trusted.
		if [[ -n $sd ]]; then
			k="hk_sid_$p"
			[[ -z ${!k:-} || ${!k} == "$sd" ]] || continue
		fi
		# parked has no writer when the background work ends, so it expires; see CLAUDE.md
		if [[ $st == parked && $at =~ ^[0-9]+$ ]] && ((NOW > 0)); then
			lim=$PARKED_MAX
			[[ $dt == monitor ]] && lim=$PARKED_MONITOR_MAX
			((NOW - at > lim)) && st=done
		fi
		# No comma can appear in a detail (error kind or tool name).
		map_set "hk_st_$p" "${st:-idle},${at:-0},${dt}"
	done
}

# State, and when the hook wrote it: for a working session, when it started.
PSTATE=""
PSINCE=0
state_of_pane() {
	local k="hk_st_$1"
	local entry rest
	PSTATE=""
	PSINCE=0
	PDETAIL=""
	entry=${!k:-}
	[[ -n $entry ]] || return
	PSTATE=${entry%%,*}
	rest=${entry#*,}
	PSINCE=${rest%%,*}
	PDETAIL=${rest#*,}
	[[ $PSINCE =~ ^[0-9]+$ ]] || PSINCE=0
}

SID=""
sid_of_pane() {
	local k="hk_sid_$1"
	SID=${!k:-}
}

# statusUpdatedAt per session, the clock the prompt cache runs on (CLAUDE.md). One jq.
scan_registry() {
	local id at
	while IFS='=' read -r id at; do
		[[ -n $id && -n $at ]] || continue
		map_set "ck_${id//-/_}" "$at"
	done < <(jq -r '
		select(.sessionId != null)
		| [ .sessionId, ((((.statusUpdatedAt // .updatedAt // 0) / 1000) | floor | tostring)) ]
		| join("=")' "$HOME"/.claude/sessions/*.json 2>/dev/null)
}

# Seconds of prompt cache left, or -1 when there is nothing to go on.
CACHE_LEFT=-1
cache_left_of() {
	local k at
	CACHE_LEFT=-1
	[[ -n $1 ]] || return
	k="ck_${1//-/_}"
	at=${!k:-}
	[[ $at =~ ^[0-9]+$ ]] || return
	((at == 0)) && return
	CACHE_LEFT=$((at + CACHE_TTL - NOW))
	((CACHE_LEFT < 0)) && CACHE_LEFT=0
}

# A pane title is the topic behind a status glyph; "Claude Code" means untitled.
TOPIC=""
pane_topic() {
	local t=$1 g
	for g in "${STATUS_GLYPHS[@]}"; do
		if [[ $t == "$g"* ]]; then
			t=${t#"$g"}
			break
		fi
	done
	t=${t#"${t%%[![:space:]]*}"}
	case $t in
	"Claude Code" | zsh | nvim | bash | fish) t="" ;;
	esac
	TOPIC=$t
}

# Tabs are numbered from one by ascending tab_id within a window, as the tab bar counts.
TABLABEL=""
tab_label() {
	local k="tabl_$1"
	TABLABEL=${!k:-}
	[[ -n $TABLABEL ]] || TABLABEL="tab ?"
}

scan_panes() {
	local kind a b c d e f g h idx=0 prev="" label n=0

	stamp_now
	map_reset
	scan_hook_maps
	ix_reset
	E_PANE=()
	E_NAME=()
	E_KIND=()
	E_DETAIL=()
	E_IDLE=()
	E_TURNS=()
	E_TITLE=()
	E_LAST=()
	E_PCT=()
	E_ASKS=()
	E_WS=()
	E_TAB=()
	E_TABLABEL=()
	E_POS=()
	E_DIR=()
	E_ID=()
	E_SINCE=()
	E_HAVE=()
	E_HKIND=()
	E_GEOM=()
	scan_registry

	while IFS="$US" read -r kind a b c d e f g h; do
		case $kind in
		T)
			# a=window b=tab_id c=tab_title
			if [[ $a != "$prev" ]]; then
				idx=0
				prev=$a
			fi
			idx=$((idx + 1))
			# A title led by a status glyph was pinned by the save layer, not typed by you.
			label="tab $idx"
			case $c in
			"" | [✳✻✽◐◓◑◒]*) ;;
			*) label="tab $idx · ${c:0:22}" ;;
			esac
			map_set "tabl_$b" "$label"
			;;
		P)
			# a=pane b=workspace c=tab_id d=top_row e=left_col f=title g=cwd h=size
			sid_of_pane "$a"
			[[ -n $SID ]] || continue
			state_of_pane "$a"
			# A pane whose Stop hook last said "ended" is a shell that used to be Claude.
			[[ $PSTATE == ended ]] && continue
			if ! $all && [[ -n $workspace && $b != "$workspace" ]]; then continue; fi
			pane_topic "$f"
			E_PANE[n]=$a
			E_WS[n]=$b
			E_TAB[n]=$c
			E_POS[n]=$((d * 100000 + e))
			E_DIR[n]=$g
			E_GEOM[n]=$h
			E_ID[n]=$SID
			id_colour "$SID"
			printf -v "sw_$a" '%s' "$IDC_ANSI"
			printf -v "swm_$a" '%s' "$IDC_MUTED"
			printf -v "swn_$a" '%s' "$IDC_NAME"
			E_SINCE[n]=$PSINCE
			E_TITLE[n]=$TOPIC
			E_NAME[n]=""
			case $PSTATE in
			asking) E_KIND[n]=asking ;;
			errored) E_KIND[n]=errored ;;
			working | parked) E_KIND[n]=busy ;;
			*) E_KIND[n]=idle ;;
			esac
			# The raw hook state, for merge_roster. Empty means the idle above is a guess.
			E_HKIND[n]=$PSTATE
			E_DETAIL[n]=""
			[[ $PSTATE == errored ]] && E_DETAIL[n]=$PDETAIL
			E_IDLE[n]=""
			E_TURNS[n]=""
			E_LAST[n]=""
			E_PCT[n]=""
			E_ASKS[n]=no
			E_HAVE[n]=no
			ix_set "ix_$a" "$n"
			n=$((n + 1))
			;;
		esac
	done < <(wezterm cli list --format json 2>/dev/null | jq -r --arg us "$US" '
		([ .[] | { w: .window_id, t: .tab_id, ti: (.tab_title // "") } ]
		 | unique_by([.w, .t]) | sort_by(.w, .t)
		 | .[] | [ "T", (.w|tostring), (.t|tostring), .ti ] | join($us)),
		(.[] | [ "P", (.pane_id|tostring), .workspace, (.tab_id|tostring),
		         ((.top_row // 0)|tostring), ((.left_col // 0)|tostring),
		         (.title // ""), (.cwd // "" | sub("^file://[^/]*"; "")),
		         "\(.size.rows // 0)x\(.size.cols // 0)" ] | join($us))
	' 2>/dev/null)

	local i
	for ((i = 0; i < ${#E_PANE[@]}; i++)); do
		tab_label "${E_TAB[i]}"
		E_TABLABEL[i]=$TABLABEL
	done
	recompute_flags
}

# Every pane's screen at once, in parallel. A done or errored pane changes only with its
# next hook record or a resize, so it is re-read when that key moves, on r, and at least
# every TAIL_MAX_AGE seconds (a local slash command writes without a hook).
readonly TAIL_MAX_AGE=60
TAILS_FULL_AT=-99999
run_tails() {
	local i p k key full=false pids=()
	[[ ${1:-} == fresh ]] && full=true
	((SECONDS - TAILS_FULL_AT >= TAIL_MAX_AGE)) && full=true
	$full && TAILS_FULL_AT=$SECONDS
	for ((i = 0; i < ${#E_PANE[@]}; i++)); do
		p=${E_PANE[i]}
		[[ $p == "-" ]] && continue
		key="${E_HKIND[i]},${E_SINCE[i]},${E_ID[i]},${E_GEOM[i]:-}"
		k="tk_$p"
		if ! $full && [[ ${!k:-} == "$key" && -e $work/tail.$p ]]; then
			case ${E_HKIND[i]} in done | errored) continue ;; esac
		fi
		printf -v "$k" '%s' "$key"
		rm -f "$work/tail.$p"
		read_pane "$p" &
		pids[${#pids[@]}]=$!
	done
	# Only these: a bare wait would also block on a background roster fetch.
	((${#pids[@]} > 0)) && wait "${pids[@]}"
	merge_tails
}

# The statusLine's record, for when a narrow pane clips "N% of 1M" off screen.
readonly CTX_DIR="$HOME/.claude/cache/context"
ctx_from_cache() {
	local i=$1 f pct _rest
	[[ -n ${E_ID[i]:-} ]] || return 0
	f="$CTX_DIR/${E_ID[i]}"
	[[ -r $f ]] || return 0
	IFS=$'\t' read -r pct _rest <"$f" || return 0
	[[ $pct =~ ^[0-9]+$ ]] && E_PCT[i]=$pct
	return 0
}

merge_tails() {
	local i last pct
	for ((i = 0; i < ${#E_PANE[@]}; i++)); do
		[[ -r "$work/tail.${E_PANE[i]}" ]] || continue
		IFS="$US" read -r last pct <"$work/tail.${E_PANE[i]}"
		# Never prompted: whatever is on screen is the startup banner.
		[[ ${E_IDLE[i]} == "-1" ]] && last=""
		E_LAST[i]=$last
		E_PCT[i]=$pct
		[[ -n $pct ]] || ctx_from_cache "$i"
	done
	recompute_flags
}

# The roster adds names, ages and turns. Idempotent per scan, because poll_roster can land
# on top of an earlier merge.
GRACE_ROWS=""
GRACE_BASE="|"
merge_roster() {
	local rows=$1 ws tab pane name kind detail idle turns title id i n hk
	[[ -n $rows ]] || return
	ROSTER=$rows
	# A pane missing from the roster gets one distinct roster of grace: a session opened
	# seconds ago is not in it yet. Merging the same roster again does not use it up.
	if [[ $rows != "$GRACE_ROWS" ]]; then
		GRACE_ROWS=$rows
		GRACE_BASE=$UNCONFIRMED
	fi
	if ! $all && [[ -n $workspace ]]; then
		rows=$(printf '%s\n' "$rows" | awk -F"$US" -v w="$workspace" '$1 == w')
	fi
	while IFS="$US" read -r ws _ tab pane name kind detail idle turns _ title id; do
		[[ -n $name ]] || continue
		# The registry says waiting when a session has stopped to ask you something.
		[[ $kind == waiting ]] && kind=asking
		ix_key "$pane" "${id:-$name}"
		i=${!IXKEY:--1}
		if ((i < 0)); then
			# Live with no pane: its pane died, or the filter hides it.
			[[ $pane == "-" ]] || continue
			i=${#E_PANE[@]}
			ix_set "$IXKEY" "$i"
			E_PANE[i]="-"
			E_WS[i]=$ws
			E_TAB[i]=$tab
			E_POS[i]=999999999
			E_DIR[i]=""
			E_ID[i]=""
			E_SINCE[i]=0
			E_HKIND[i]=""
			E_GEOM[i]=""
			E_TITLE[i]=""
			E_LAST[i]=""
			E_PCT[i]=""
			E_ASKS[i]=no
			E_TABLABEL[i]="no pane"
		fi
		E_NAME[i]=$name
		[[ -n $id ]] && E_ID[i]=$id
		[[ -n ${E_PCT[i]:-} ]] || ctx_from_cache "$i"
		# The roster is a cache of the registry; hook files are written the instant a turn
		# ends. It names the state only where no hook wrote since it was assembled, and an
		# idle registry never overrules errored or parked, since idle is how both look.
		hk=${E_HKIND[i]:-}
		if [[ -z $hk ]] || ((${E_SINCE[i]:-0} <= ROSTER_AT)); then
			case $hk in
			errored | parked) [[ $kind == idle || $kind == shell ]] || E_KIND[i]=$kind ;;
			*) E_KIND[i]=$kind ;;
			esac
		fi
		# Only the hook knows an API error kind.
		[[ ${E_KIND[i]} == errored ]] || E_DETAIL[i]=$detail
		E_IDLE[i]=$idle
		E_TURNS[i]=$turns
		[[ -n $title && $title != untitled ]] && E_TITLE[i]=$title
		[[ $idle == "-1" ]] && E_LAST[i]=""
		E_HAVE[i]=yes
	done <<<"$rows"

	# A hook map pointing at a session the registry has never heard of: it exited without
	# its SessionEnd hook.
	local keep=() k=0 nextmiss="|"
	for ((i = 0; i < ${#E_PANE[@]}; i++)); do
		if [[ ${E_HAVE[i]} == yes ]]; then
			keep[k++]=$i
		elif [[ $GRACE_BASE != *"|${E_PANE[i]}|"* ]]; then
			nextmiss="${nextmiss}${E_PANE[i]}|"
			keep[k++]=$i
		fi
	done
	UNCONFIRMED=$nextmiss
	if ((k < ${#E_PANE[@]})); then
		local P=() N=() K=() D=() I=() U=() T=() L=() C=() A=() W=() B=() BL=() O=()
		local R=() H=() ID=() SN=() HK=() G=()
		ix_reset
		for ((n = 0; n < k; n++)); do
			i=${keep[n]}
			P[n]=${E_PANE[i]}; N[n]=${E_NAME[i]}; K[n]=${E_KIND[i]}; D[n]=${E_DETAIL[i]}
			I[n]=${E_IDLE[i]}; U[n]=${E_TURNS[i]}; T[n]=${E_TITLE[i]}; L[n]=${E_LAST[i]}
			C[n]=${E_PCT[i]}; A[n]=${E_ASKS[i]}; W[n]=${E_WS[i]}; B[n]=${E_TAB[i]}
			BL[n]=${E_TABLABEL[i]}; O[n]=${E_POS[i]}; R[n]=${E_DIR[i]}; H[n]=${E_HAVE[i]}
			ID[n]=${E_ID[i]}; SN[n]=${E_SINCE[i]}; HK[n]=${E_HKIND[i]:-}; G[n]=${E_GEOM[i]:-}
			ix_key "${P[n]}" "${ID[n]:-${N[n]}}"
			ix_set "$IXKEY" "$n"
		done
		E_PANE=(${P[@]+"${P[@]}"}); E_NAME=(${N[@]+"${N[@]}"}); E_KIND=(${K[@]+"${K[@]}"})
		E_DETAIL=(${D[@]+"${D[@]}"}); E_IDLE=(${I[@]+"${I[@]}"}); E_TURNS=(${U[@]+"${U[@]}"})
		E_TITLE=(${T[@]+"${T[@]}"}); E_LAST=(${L[@]+"${L[@]}"}); E_PCT=(${C[@]+"${C[@]}"})
		E_ASKS=(${A[@]+"${A[@]}"}); E_WS=(${W[@]+"${W[@]}"}); E_TAB=(${B[@]+"${B[@]}"})
		E_TABLABEL=(${BL[@]+"${BL[@]}"}); E_POS=(${O[@]+"${O[@]}"}); E_DIR=(${R[@]+"${R[@]}"})
		E_HAVE=(${H[@]+"${H[@]}"}); E_ID=(${ID[@]+"${ID[@]}"}); E_SINCE=(${SN[@]+"${SN[@]}"})
		E_HKIND=(${HK[@]+"${HK[@]}"}); E_GEOM=(${G[@]+"${G[@]}"})
	fi
	recompute_flags
}

# Asking is the hook state or a closing line ending in a question: the reason this reads
# screens at all.
recompute_flags() {
	local i
	WAITING=0
	for ((i = 0; i < ${#E_PANE[@]}; i++)); do
		if [[ ${E_KIND[i]} == asking || ${E_LAST[i]} == *'?' ]]; then
			E_ASKS[i]=yes
			WAITING=$((WAITING + 1))
		else
			E_ASKS[i]=no
		fi
	done
	tick_now
	LOADED_AT=$SECONDS
}

is_cold() {
	local i=$1
	[[ ${E_ASKS[i]} == yes ]] && return 1
	[[ ${E_KIND[i]} == busy ]] && return 1
	[[ -z ${E_IDLE[i]} ]] && return 1
	((${E_IDLE[i]} >= 0 && ${E_IDLE[i]} < STALE_SECS)) && return 1
	return 0
}

# Stopped within FRESH_SECS: the tab bar's ✓. DONE_AT is restored because emit_row reads it.
is_fresh() {
	local i=$1 keep=$DONE_AT rc=1
	[[ ${E_ASKS[i]} == yes ]] && return 1
	[[ ${E_KIND[i]} == busy ]] && return 1
	done_at "$i"
	((DONE_AT > 0 && NOW - DONE_AT < FRESH_SECS)) && rc=0
	DONE_AT=$keep
	return $rc
}

# One git call for the workspace: its sessions nearly all share a working tree.
refresh_git() {
	local cwd=""
	BRANCH=""
	DIRTY=0
	((${#E_DIR[@]} > 0)) && cwd=${E_DIR[0]}
	[[ -n $cwd && -d $cwd ]] || return
	BRANCH=$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null)
	[[ -n $BRANCH ]] &&
		DIRTY=$(git -C "$cwd" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
}

# When the roster in hand was assembled: the cache file's mtime, which --stale-ok can leave
# at any age.
ROSTER_AT=0
stamp_roster() {
	ROSTER_AT=$( { stat "${MTIME[@]}" "$ROSTER_CACHE"; } 2>/dev/null) || ROSTER_AT=0
	[[ $ROSTER_AT =~ ^[0-9]+$ ]] || ROSTER_AT=0
}

# In the background, for a cold cache or --fresh.
ROSTER_PENDING=false
start_roster() {
	rm -f "$work/roster" "$work/roster.part" 2>/dev/null
	(
		"$FLEET" --tsv "$@" 2>/dev/null | tr '\t' "$US" >"$work/roster.part"
		mv -f "$work/roster.part" "$work/roster" 2>/dev/null
	) &
	ROSTER_PENDING=true
}

poll_roster() {
	$ROSTER_PENDING || return 1
	[[ -e "$work/roster" ]] || return 1
	ROSTER_PENDING=false
	stamp_roster
	merge_roster "$(<"$work/roster")"
	refresh_git
	return 0
}

fetch_roster() {
	$ROSTER_PENDING && return
	if [[ -r $ROSTER_CACHE ]]; then
		# Stamped before the call: --stale-ok may rewrite the file behind us.
		stamp_roster
		merge_roster "$("$FLEET" --tsv --stale-ok 2>/dev/null | tr '\t' "$US")"
		refresh_git
	else
		start_roster --stale-ok
	fi
}

# ---------------------------------------------------------------- fork-free primitives

ROWS=40
COLS=120
measure() {
	local size
	# ROWSxCOLS, for testing sizes you have no pane for.
	if [[ -n ${CC_BOARD_SIZE:-} ]]; then
		ROWS=${CC_BOARD_SIZE%%x*}
		COLS=${CC_BOARD_SIZE##*x}
	else
		size=$( { stty size </dev/tty; } 2>/dev/null) || size=""
		ROWS=${size%% *}
		COLS=${size##* }
	fi
	[[ $ROWS =~ ^[0-9]+$ ]] || ROWS=40
	[[ $COLS =~ ^[0-9]+$ ]] || COLS=120
}

# Clipped and padded to a column, into PAD. ${#s} counts characters under UTF-8.
PAD=""
CLIPPED=false
pad_to() {
	local text=$1 width=$2 n trimmed
	CLIPPED=false
	((width < 1)) && {
		PAD=""
		return
	}
	n=${#text}
	if ((n > width)); then
		CLIPPED=true
		text=${text:0:width-1}
		trimmed=${text% *}
		# Back up to a word boundary only if that loses under 15% of the column.
		[[ $trimmed != "$text" ]] && ((${#trimmed} * 20 >= width * 17)) && text=$trimmed
		text="${text}…"
		n=${#text}
	fi
	if ((n < width)); then
		printf -v PAD '%s%*s' "$text" $((width - n)) ''
	else
		PAD=$text
	fi
}

PADL=""
pad_left() {
	local text=$1 width=$2
	if ((${#text} >= width)); then
		PADL=${text:0:width}
	else
		printf -v PADL '%*s%s' $((width - ${#text})) '' "$text"
	fi
}

AGE=""
set_age() {
	local s=$1
	if [[ -z $s ]]; then AGE=""
	elif ((s < 0)); then AGE=never
	elif ((s < 90)); then AGE=now
	elif ((s < 5400)); then printf -v AGE '%dm' $((s / 60))
	elif ((s < 172800)); then printf -v AGE '%dh' $((s / 3600))
	else printf -v AGE '%dd' $((s / 86400)); fi
}

# Days since 1970-01-01 to day and month (Hinnant's civil_from_days), without a date fork.
CD=0
CM=0
civil_from_days() {
	local z=$(($1 + 719468)) era doe yoe doy mp
	era=$(((z >= 0 ? z : z - 146096) / 146097))
	doe=$((z - era * 146097))
	yoe=$(((doe - doe / 1460 + doe / 36524 - doe / 146096) / 365))
	doy=$((doe - (365 * yoe + yoe / 4 - yoe / 100)))
	mp=$(((5 * doy + 2) / 153))
	CD=$((doy - (153 * mp + 2) / 5 + 1))
	CM=$((mp < 10 ? mp + 3 : mp - 9))
}

# When a session stopped, as Claude prints it ("done 16:40"): a day name within the week,
# a date past it.
DONE=""
set_done() {
	local at=$1 full=${2:-} secs day today hh mm
	DONE=""
	[[ $at =~ ^[0-9]+$ ]] && ((at > 0)) || return
	secs=$((at + TZOFF))
	day=$((secs / 86400))
	today=$(((NOW + TZOFF) / 86400))
	printf -v hh '%02d' $((secs % 86400 / 3600))
	printf -v mm '%02d' $((secs % 3600 / 60))
	if ((day >= today)); then
		DONE="${hh}:${mm}"
	elif ((today - day < 7)); then
		DONE="${DAYNAME[(day + 4) % 7]} ${hh}:${mm}"
	else
		civil_from_days "$day"
		DONE="${CD} ${MONNAME[CM - 1]}"
		[[ -n $full ]] && DONE="${DONE} ${hh}:${mm}"
	fi
}

# The hook epoch, else statusUpdatedAt. Nothing while working: it has not finished.
DONE_AT=0
done_at() {
	local i=$1 k
	DONE_AT=0
	[[ ${E_KIND[i]} == busy ]] && return
	if ((${E_SINCE[i]:-0} > 0)); then
		DONE_AT=${E_SINCE[i]}
		return
	fi
	[[ -n ${E_ID[i]} ]] || return
	k="ck_${E_ID[i]//-/_}"
	[[ ${!k:-} =~ ^[0-9]+$ ]] && DONE_AT=${!k}
}

# Context spent, as a bar: amber past half, red past eighty.
CTXBAR=""
set_ctxbar() {
	local pct=$1 width=$2 filled colour fill="" rest="" i
	((width < 2)) && {
		CTXBAR=""
		return
	}
	if [[ ! $pct =~ ^[0-9]+$ ]]; then
		printf -v rest '%*s' "$width" ''
		CTXBAR="${RULE}${rest// /·}${RESET}"
		return
	fi
	filled=$((pct * width / 100))
	((filled > width)) && filled=$width
	((filled == 0 && pct > 0)) && filled=1
	colour=$GREEN
	((pct >= 50)) && colour=$ORANGE
	((pct >= 80)) && colour=$RED
	for ((i = 0; i < filled; i++)); do fill="${fill}█"; done
	for ((i = filled; i < width; i++)); do rest="${rest}░"; done
	CTXBAR="${colour}${fill}${RULE}${rest}${RESET}"
}

# Word wrap in the shell: fmt is a fork.
WRAPPED=()
wrap_text() {
	local text=$1 width=$2 limit=$3 line="" word
	WRAPPED=()
	((width < 4)) && return
	text=${text#"${text%%[![:space:]]*}"}
	while [[ -n $text ]]; do
		word=${text%% *}
		if [[ $word == "$text" ]]; then text=""; else text=${text#* }; fi
		[[ -n $word ]] || continue
		if [[ -z $line ]]; then
			line=$word
		elif ((${#line} + 1 + ${#word} <= width)); then
			line="$line $word"
		else
			WRAPPED[${#WRAPPED[@]}]=$line
			((${#WRAPPED[@]} >= limit)) && return
			line=$word
		fi
		# A word longer than the column is cut, or it overflows the pane.
		while ((${#line} > width)); do
			WRAPPED[${#WRAPPED[@]}]=${line:0:width}
			((${#WRAPPED[@]} >= limit)) && return
			line=${line:width}
		done
	done
	[[ -n $line ]] && WRAPPED[${#WRAPPED[@]}]=$line
}

# ---------------------------------------------------------------- grouping and filtering

# tab is your actual layout, state the triage view, prefix the axis /rename a:b makes.
GROUPINGS=(tab state prefix)
grouping=tab
$all && grouping=workspace
hide_cold=false

# A function, not inline: bash 3.2 misparses a case inside the process substitution.
SORTKEY=""
group_sort_key() {
	local g=$1 key
	case $grouping in
	tab)
		# "tab 4" and "tab 4 · whatever you named it" both sort on the number.
		key=${g#tab }
		key=${key%% *}
		[[ $key =~ ^[0-9]+$ ]] || key=9999
		printf -v SORTKEY '%04d' "$key"
		;;
	state)
		case $g in
		"waiting on you") key=0 ;;
		working) key=1 ;;
		live) key=2 ;;
		*) key=3 ;;
		esac
		printf -v SORTKEY '%04d' "$key"
		;;
	prefix)
		if [[ $g == unprefixed ]]; then SORTKEY="zzzz"; else SORTKEY=$g; fi
		;;
	*) SORTKEY=$g ;;
	esac
}

GROUP=""
group_of() {
	local i=$1 name
	case $grouping in
	workspace) GROUP=${E_WS[i]} ;;
	tab) GROUP=${E_TABLABEL[i]} ;;
	state)
		if [[ ${E_KIND[i]} == errored ]]; then GROUP="errored"
		elif [[ ${E_ASKS[i]} == yes ]]; then GROUP="waiting on you"
		elif [[ ${E_KIND[i]} == busy ]]; then GROUP="working"
		elif is_cold "$i"; then GROUP="cold"
		else GROUP="live"; fi
		;;
	prefix)
		name=${E_NAME[i]}
		case $name in
		*:*) GROUP=${name%%:*} ;;
		*) GROUP="unprefixed" ;;
		esac
		;;
	esac
}

# How loudly a session wants you, then how recently you spoke to it.
URGENCY=""
urgency_of() {
	local i=$1 rank idle
	if [[ ${E_KIND[i]} == errored ]]; then rank=5
	elif [[ ${E_ASKS[i]} == yes ]]; then rank=4
	elif [[ ${E_KIND[i]} == busy ]]; then rank=3
	elif is_cold "$i"; then rank=0
	elif [[ ${E_KIND[i]} == shell ]]; then rank=1
	else rank=2; fi
	idle=${E_IDLE[i]:-999999999}
	((idle < 0)) && idle=999999999
	printf -v URGENCY '%d%010d' $((9 - rank)) "$idle"
}

filter=""
selected=0
SCROLL=0
IDX=()
MARK_COUNT=0
HIDDEN=0

# Indices surviving the filter, stably sorted into groups. nocasematch: ${var,,} is bash 4.
GROUP_NAME=()
GROUP_START=()
build_visible() {
	local i hay pass=() g seen order=() n
	MARK_COUNT=0
	HIDDEN=0
	for ((i = 0; i < ${#E_PANE[@]}; i++)); do
		is_marked "${E_PANE[i]}" && MARK_COUNT=$((MARK_COUNT + 1))
	done
	shopt -s nocasematch
	for ((i = 0; i < ${#E_PANE[@]}; i++)); do
		if $hide_cold && is_cold "$i" && ! is_marked "${E_PANE[i]}"; then
			HIDDEN=$((HIDDEN + 1))
			continue
		fi
		if [[ -n $filter ]]; then
			hay="${E_NAME[i]} ${E_TITLE[i]} ${E_LAST[i]} ${E_KIND[i]} ${E_TABLABEL[i]}"
			[[ $hay == *"$filter"* ]] || continue
		fi
		pass[${#pass[@]}]=$i
	done
	shopt -u nocasematch

	seen=""
	for i in ${pass[@]+"${pass[@]}"}; do
		group_of "$i"
		if [[ $seen != *"${US}${GROUP}${US}"* ]]; then
			seen="${seen}${US}${GROUP}${US}"
			order[${#order[@]}]=$GROUP
		fi
	done

	if ((${#order[@]} > 1)); then
		local sorted=()
		while IFS= read -r g; do
			sorted[${#sorted[@]}]=${g#*"$US"}
		done < <(
			for g in "${order[@]}"; do
				group_sort_key "$g"
				printf '%s%s%s\n' "$SORTKEY" "$US" "$g"
			done | LC_ALL=C sort
		)
		order=("${sorted[@]}")
	fi

	IDX=()
	GROUP_NAME=()
	GROUP_START=()
	local members j k tmp keys=() tkey
	for g in ${order[@]+"${order[@]}"}; do
		GROUP_NAME[${#GROUP_NAME[@]}]=$g
		GROUP_START[${#GROUP_START[@]}]=${#IDX[@]}
		members=()
		keys=()
		for i in ${pass[@]+"${pass[@]}"}; do
			group_of "$i"
			[[ $GROUP == "$g" ]] || continue
			if [[ $grouping == tab ]]; then
				printf -v tkey '%012d' "${E_POS[i]}"
			else
				urgency_of "$i"
				tkey=$URGENCY
			fi
			members[${#members[@]}]=$i
			keys[${#keys[@]}]=$tkey
		done
		# Screen order by tab, urgency otherwise. Insertion sort: no fork per redraw.
		if ((${#members[@]} > 1)); then
			for ((j = 1; j < ${#members[@]}; j++)); do
				tmp=${members[j]}
				tkey=${keys[j]}
				k=$((j - 1))
				while ((k >= 0)) && [[ ${keys[k]} > $tkey ]]; do
					members[k + 1]=${members[k]}
					keys[k + 1]=${keys[k]}
					k=$((k - 1))
				done
				members[k + 1]=$tmp
				keys[k + 1]=$tkey
			done
		fi
		for i in ${members[@]+"${members[@]}"}; do
			IDX[${#IDX[@]}]=$i
		done
	done
	n=${#IDX[@]}
	GROUP_START[${#GROUP_START[@]}]=$n
}

# ---------------------------------------------------------------- state glyph and colour

# Identity colour, resolved at scan. It goes on the name only; status keeps the glyphs.
IDCOL=""
IDMUTED=""
set_idcol() {
	local i=$1 key
	IDCOL=$FAINT
	IDMUTED=$FAINT
	[[ ${E_PANE[i]} == [0-9]* ]] || return
	key="sw_${E_PANE[i]}"
	[[ -n ${!key:-} ]] && IDCOL=${!key}
	key="swm_${E_PANE[i]}"
	[[ -n ${!key:-} ]] && IDMUTED=${!key}
}

# How many panes in a group share a hue with another, which a pin fixes.
CLASH=0
group_clash() {
	local start=$1 end=$2 a b ka kb ha hb
	CLASH=0
	for ((a = start; a < end; a++)); do
		ka="swn_${E_PANE[${IDX[a]}]}"
		ha=${!ka:-}
		[[ -n $ha ]] || continue
		for ((b = start; b < end; b++)); do
			((b == a)) && continue
			kb="swn_${E_PANE[${IDX[b]}]}"
			hb=${!kb:-}
			[[ $ha == "$hb" ]] && {
				CLASH=$((CLASH + 1))
				break
			}
		done
	done
}

# One heading, clipped: a wrapped heading pushes every row under it one line out.
GHEAD=""
group_heading() {
	local g=$1 start=$2 end=$3 name tail max
	group_clash "$start" "$end"
	tail=" · $((end - start))"
	((CLASH > 0)) && tail="${tail} · ${CLASH} alike"
	name=${GROUP_NAME[g]}
	max=$((COLS - 2 - ${#tail}))
	((max < 4)) && max=4
	((${#name} > max)) && name="${name:0:max - 1}…"
	GHEAD="${FAINT}  ${name}${RULE}${tail}${RESET}"
}

# The tab bar's alphabet: a dot coloured by state, with a shape only for ! errored,
# ? asking and ✓ just finished. › is a shell, which the bar never shows.
GLYPH=""
COLOUR=""
STATE=""
style_of() {
	local i=$1
	if [[ ${E_KIND[i]} == errored ]]; then
		STATE=errored
		GLYPH="!"
		COLOUR=$RED
	elif [[ ${E_ASKS[i]} == yes ]]; then
		STATE=asking
		GLYPH="?"
		COLOUR=$MAUVE
	elif [[ ${E_KIND[i]} == busy ]]; then
		STATE=working
		GLYPH="●"
		COLOUR=$GREEN
	elif [[ ${E_KIND[i]} == shell ]]; then
		STATE=shell
		GLYPH="›"
		COLOUR=$DIM
	elif is_fresh "$i"; then
		STATE=fresh
		GLYPH="✓"
		COLOUR=$YELLOW
	elif is_cold "$i"; then
		STATE=cold
		GLYPH="●"
		COLOUR=$FAINT
	else
		STATE=waiting
		GLYPH="●"
		COLOUR=$AMBER
	fi
}

# ---------------------------------------------------------------- header

# One glyph per session in row order, a space between groups: the grid's glance, in a line.
STRIP=""
build_strip() {
	local n=${#IDX[@]} budget=$((COLS - 4)) i pos g=0 next cells=0 out="" bg
	STRIP=""
	((n < 4)) && return
	cells=$((n + ${#GROUP_NAME[@]} - 1))
	if ((cells > budget)); then
		# Too many for a cell each, so counts, in the same glyphs and colours as the rows.
		local e=0 w=0 b=0 l=0 c=0
		for ((i = 0; i < n; i++)); do
			style_of "${IDX[i]}"
			case $STATE in
			errored) e=$((e + 1)) ;;
			asking) w=$((w + 1)) ;;
			working) b=$((b + 1)) ;;
			cold) c=$((c + 1)) ;;
			*) l=$((l + 1)) ;;
			esac
		done
		out=""
		((e > 0)) && out="${out}${RED}!${e} "
		((w > 0)) && out="${out}${MAUVE}?${w} "
		((b > 0)) && out="${out}${GREEN}●${b} "
		((l > 0)) && out="${out}${AMBER}●${l} "
		((c > 0)) && out="${out}${FAINT}●${c} "
		STRIP="${out}${RESET}"
		return
	fi
	next=${GROUP_START[1]:-$n}
	for ((pos = 0; pos < n; pos++)); do
		while ((pos >= next)); do
			out="${out} "
			g=$((g + 1))
			next=${GROUP_START[g + 1]:-$n}
		done
		i=${IDX[pos]}
		style_of "$i"
		bg=""
		((pos == selected)) && bg=$SELECTED
		out="${out}${bg}${COLOUR}${GLYPH}${RESET}"
	done
	STRIP=$out
}

HEADER=""
HEADER_LINES=2
build_header() {
	local head="${workspace:-all workspaces}" right seg budget gap spacer
	budget=$((COLS - ${#head} - 6))
	right="${#E_PANE[@]} chat"
	((${#E_PANE[@]} == 1)) || right="${right}s"
	((WAITING > 0)) && {
		seg=" · ${WAITING} waiting"
		((${#right} + ${#seg} <= budget)) && right="${right}${seg}"
	}
	((MARK_COUNT > 0)) && {
		seg=" · ${MARK_COUNT} marked"
		((${#right} + ${#seg} <= budget)) && right="${right}${seg}"
	}
	((HIDDEN > 0)) && {
		seg=" · ${HIDDEN} cold hidden"
		((${#right} + ${#seg} <= budget)) && right="${right}${seg}"
	}
	seg=" · by ${grouping}"
	((${#right} + ${#seg} <= budget)) && right="${right}${seg}"
	if [[ -n $BRANCH ]]; then
		seg=" · ${BRANCH}"
		((DIRTY > 0)) && seg="${seg} ✎${DIRTY}"
		((${#right} + ${#seg} <= budget)) && right="${right}${seg}"
	fi
	gap=$((COLS - ${#head} - ${#right} - 4))
	((gap < 1)) && gap=1
	printf -v spacer '%*s' "$gap" ''
	HEADER="${HOME_POS}${BLUE}▤  ${BOLD}${head}${RESET}${spacer}${DIM}${right}${RESET}${EOL}"$'\n'
	HEADER_LINES=2
	if [[ -n $filter ]]; then
		HEADER+="${YELLOW}  /${filter}${RESET}${DIM}  ${#IDX[@]} of ${#E_PANE[@]}${RESET}${EOL}"$'\n'
		return
	fi
	if ((COLS < 96)) && { [[ $view == rows ]] || ((COLS < 88)); }; then
		build_strip
		if [[ -n $STRIP ]]; then
			HEADER+="  ${STRIP}${EOL}"$'\n'
			return
		fi
	fi
	HEADER+="${EOL}"$'\n'
}

# ---------------------------------------------------------------- rows

# The width ladder. Below 120 columns the closing line lives only in the expansion.
NAME_W=0
AGE_W=5
BAR_W=8
PCT_W=0
CACHE_W=0
LAST_W=0
LABEL_W=20
# "Tue 16:40" plus a gap, which the topic can spare down to 76 columns.
DONE_W=0
# cursor, mark, state glyph, space
readonly PREFIX_W=4
row_widths() {
	local dw
	CACHE_W=1
	((COLS < 40)) && CACHE_W=0
	DONE_W=0
	((COLS >= 76)) && DONE_W=9
	dw=0
	((DONE_W > 0)) && dw=$((DONE_W + 1))
	if ((COLS >= 120)); then
		NAME_W=16 AGE_W=5 BAR_W=10 PCT_W=4
		LABEL_W=40
		LAST_W=$((COLS - PREFIX_W - NAME_W - 1 - 1 - CACHE_W - AGE_W - dw - 1 - BAR_W - 1 - PCT_W - LABEL_W - 2))
		((LAST_W < 24)) && {
			LABEL_W=$((LABEL_W + LAST_W - 24))
			LAST_W=24
		}
	elif ((COLS >= 96)); then
		NAME_W=16 AGE_W=5 BAR_W=10 PCT_W=4 LAST_W=0
		LABEL_W=$((COLS - PREFIX_W - NAME_W - 1 - 1 - CACHE_W - AGE_W - dw - 1 - BAR_W - 1 - PCT_W - 1))
	elif ((COLS >= 64)); then
		NAME_W=0 AGE_W=5 BAR_W=8 PCT_W=4 LAST_W=0
		LABEL_W=$((COLS - PREFIX_W - 1 - CACHE_W - AGE_W - dw - 1 - BAR_W - 1 - PCT_W - 1))
	elif ((COLS >= 44)); then
		NAME_W=0 AGE_W=5 BAR_W=6 PCT_W=0 LAST_W=0
		LABEL_W=$((COLS - PREFIX_W - 1 - CACHE_W - AGE_W - 1 - BAR_W - 1))
	elif ((COLS >= 32)); then
		NAME_W=0 AGE_W=4 BAR_W=4 PCT_W=0 LAST_W=0
		LABEL_W=$((COLS - PREFIX_W - 1 - CACHE_W - AGE_W - 1 - BAR_W - 1))
	else
		NAME_W=0 AGE_W=3 BAR_W=0 PCT_W=0 LAST_W=0
		LABEL_W=$((COLS - PREFIX_W - 1 - CACHE_W - AGE_W - 1))
	fi
	((LABEL_W < 6)) && LABEL_W=6
}

# What a row says with no topic yet; a blank reads as a bug.
row_label() {
	local i=$1
	if [[ -n ${E_TITLE[i]} ]]; then
		ROWLABEL=${E_TITLE[i]}
	elif [[ -n ${E_NAME[i]} ]]; then
		ROWLABEL=${E_NAME[i]}
	elif [[ ${E_PANE[i]} == "-" ]]; then
		ROWLABEL="no pane"
	else
		ROWLABEL="pane ${E_PANE[i]}"
	fi
}

BODY=()
push() { BODY[${#BODY[@]}]=$1; }

# Grid: per BODY line, the position of the first session in its unit, so the window snaps
# to whole cells and the more-above line counts sessions.
LINE_POS=()
gpush() {
	LINE_POS[${#BODY[@]}]=$1
	BODY[${#BODY[@]}]=$2
}

emit_row() {
	local pos=$1 i=$2 line cursor mark bg meta labelcol
	style_of "$i"
	cursor=" "
	mark=" "
	bg=""
	is_marked "${E_PANE[i]}" && {
		mark="▪"
		bg=$MARKED
	}
	((pos == selected)) && {
		cursor="❯"
		bg=$SELECTED
	}
	set_age "${E_IDLE[i]}"
	meta=$AGE
	row_label "$i"
	labelcol=$TEXT
	[[ $STATE == cold ]] && labelcol=$FAINT
	[[ $STATE == cold && -n $bg ]] && labelcol=$DIM
	[[ ${E_ASKS[i]} == yes ]] && labelcol=$MAUVE

	set_idcol "$i"
	line="${bg}"
	if [[ $cursor == " " ]]; then line+="${BLUE}${cursor}"; else line+="${IDCOL}${cursor}"; fi
	line+="${DIM}${mark}${COLOUR}${GLYPH} ${labelcol}"
	pad_to "$ROWLABEL" "$LABEL_W"
	line+="$PAD"
	if ((NAME_W > 0)); then
		pad_to "${E_NAME[i]}" "$NAME_W"
		line+=" ${IDCOL}${PAD}"
	fi
	line+=" "
	# Lit when the prompt cache is still warm: the rare case, so the one worth marking.
	if ((CACHE_W > 0)); then
		cache_left_of "${E_ID[i]}"
		if ((CACHE_LEFT > 0)); then line+="${BLUE}•${bg}"; else line+=" "; fi
	fi
	line+="${DIM}"
	pad_left "$meta" "$AGE_W"
	line+="$PADL"
	# Blank while working, so a lit cell means finished.
	if ((DONE_W > 0)); then
		done_at "$i"
		set_done "$DONE_AT"
		pad_left "$DONE" "$DONE_W"
		line+=" ${PADL}"
	fi
	if ((BAR_W > 0)); then
		set_ctxbar "${E_PCT[i]}" "$BAR_W"
		line+=" ${CTXBAR}${bg}"
	fi
	if ((PCT_W > 0)); then
		pad_to "${E_PCT[i]:+${E_PCT[i]}%}" "$PCT_W"
		line+="${DIM} ${PAD}"
	fi
	if ((LAST_W > 0)); then
		if [[ ${E_ASKS[i]} == yes ]]; then line+="${MAUVE} ▸ "; else line+="${DIM} ▸ "; fi
		pad_to "${E_LAST[i]}" $((LAST_W - 3))
		line+="$PAD"
	fi
	push "${line}${RESET}"
}

# The block under the cursor: what the row could not hold, content first, address last.
emit_expansion() {
	local i=$1 w=$((COLS - 6)) meta="" seg line n col huekey
	((w < 12)) && w=$((COLS - 4))
	((w < 10)) && return

	# The topic in full, only if the row clipped it.
	row_label "$i"
	pad_to "$ROWLABEL" "$LABEL_W"
	if $CLIPPED; then
		wrap_text "$ROWLABEL" "$w" 3
		for line in ${WRAPPED[@]+"${WRAPPED[@]}"}; do
			pad_to "$line" "$w"
			push "${SELECTED}    ${TEXT}${PAD}  ${RESET}"
		done
	fi

	if [[ -n ${E_LAST[i]} ]]; then
		col=$DIM
		[[ ${E_ASKS[i]} == yes ]] && col=$MAUVE
		wrap_text "${E_LAST[i]}" $((w - 2)) 4
		n=0
		for line in ${WRAPPED[@]+"${WRAPPED[@]}"}; do
			if ((n == 0)); then
				pad_to "▸ $line" "$w"
			else
				pad_to "  $line" "$w"
			fi
			push "${SELECTED}    ${col}${PAD}  ${RESET}"
			n=$((n + 1))
		done
	fi

	# Name first, then state, clock, hue, cache, context, pane, tab, turns, each if it fits.
	meta=${E_NAME[i]}
	local haspane=false
	[[ -z $meta ]] && {
		meta="pane ${E_PANE[i]}"
		haspane=true
	}
	if [[ ${E_KIND[i]} == errored ]]; then
		seg=" · errored${E_DETAIL[i]:+ ${E_DETAIL[i]//_/ }}"
		((${#meta} + ${#seg} <= w)) && meta="${meta}${seg}"
	elif [[ ${E_KIND[i]} == asking ]]; then
		seg=" · asking${E_DETAIL[i]:+ ${E_DETAIL[i]}}"
		((${#meta} + ${#seg} <= w)) && meta="${meta}${seg}"
	elif [[ ${E_KIND[i]} == busy ]]; then
		seg=" · working"
		if ((${E_SINCE[i]:-0} > 0 && NOW > E_SINCE[i])); then
			set_age $((NOW - E_SINCE[i]))
			seg=" · working ${AGE}"
		fi
		((${#meta} + ${#seg} <= w)) && meta="${meta}${seg}"
	fi
	done_at "$i"
	if ((DONE_AT > 0)); then
		set_done "$DONE_AT" full
		seg=" · done ${DONE}"
		((${#meta} + ${#seg} <= w)) && meta="${meta}${seg}"
	fi
	huekey="swn_${E_PANE[i]}"
	if [[ -n ${!huekey:-} ]]; then
		seg=" · ${!huekey}"
		((${#meta} + ${#seg} <= w)) && meta="${meta}${seg}"
	fi
	cache_left_of "${E_ID[i]}"
	if ((CACHE_LEFT >= 60)); then
		seg=" · cache $((CACHE_LEFT / 60))m left"
		((${#meta} + ${#seg} <= w)) && meta="${meta}${seg}"
	elif ((CACHE_LEFT >= 0)); then
		seg=" · cache gone"
		((${#meta} + ${#seg} <= w)) && meta="${meta}${seg}"
	fi
	if ((PCT_W == 0)) && [[ -n ${E_PCT[i]} ]]; then
		seg=" · ${E_PCT[i]}% context"
		((${#meta} + ${#seg} <= w)) && meta="${meta}${seg}"
	fi
	if [[ ${E_PANE[i]} != "-" ]] && ! $haspane; then
		seg=" · pane ${E_PANE[i]}"
		((${#meta} + ${#seg} <= w)) && meta="${meta}${seg}"
	fi
	if [[ $grouping != tab ]]; then
		seg=" · ${E_TABLABEL[i]}"
		((${#meta} + ${#seg} <= w)) && meta="${meta}${seg}"
	fi
	if [[ -n ${E_TURNS[i]} ]] && ((E_TURNS[i] > 0)); then
		seg=" · ${E_TURNS[i]} turn"
		((E_TURNS[i] == 1)) || seg="${seg}s"
		((${#meta} + ${#seg} <= w)) && meta="${meta}${seg}"
	fi
	pad_to "$meta" "$w"
	set_idcol "$i"
	push "${SELECTED}    ${IDMUTED}${PAD}  ${RESET}"
}

FRAME=""
ROW_START=()
PER_ROW=1
SEL_FIRST=-1
SEL_LAST=-1

# Blank lines between groups go first when the fleet is taller than the pane. ROWLINE is the
# BODY line of each session's row, for the more-above and more-below counts.
ROWLINE=()
fill_body() {
	local blanks=$1 g start end pos i
	BODY=()
	ROWLINE=()
	SEL_FIRST=-1
	SEL_LAST=-1
	for ((g = 0; g < ${#GROUP_NAME[@]}; g++)); do
		start=${GROUP_START[g]}
		end=${GROUP_START[g + 1]}
		((end > start)) || continue
		((g > 0)) && $blanks && push ""
		group_heading "$g" "$start" "$end"
		push "$GHEAD"
		for ((pos = start; pos < end; pos++)); do
			i=${IDX[pos]}
			ROWLINE[pos]=${#BODY[@]}
			((pos == selected)) && SEL_FIRST=${#BODY[@]}
			emit_row "$pos" "$i"
			if ((pos == selected)); then
				emit_expansion "$i"
				SEL_LAST=$((${#BODY[@]} - 1))
			fi
		done
	done
}

# The body lines a window starting at $1 shows, once its more-above and more-below lines
# have taken theirs.
W_ABOVE=0
W_BELOW=0
W_ROOM=0
rows_window() {
	local first=$1 total=$2 cap=$3
	W_ABOVE=0
	((first > 0)) && W_ABOVE=1
	W_ROOM=$((cap - W_ABOVE))
	W_BELOW=0
	if ((first + W_ROOM < total)); then
		W_BELOW=1
		W_ROOM=$((W_ROOM - 1))
	fi
}

build_rows() {
	local footer=$1 pos total cap first last
	row_widths
	build_header
	FRAME=$HEADER
	ROW_START=()
	PER_ROW=1

	if ((${#IDX[@]} == 0)); then
		FRAME+="${EOL}"$'\n'"${DIM}  nothing here${RESET}${EOL}"$'\n'
		frame_footer "$footer"
		return
	fi

	cap=$((ROWS - HEADER_LINES - FOOTER_LINES))
	((cap < 3)) && cap=3
	fill_body true
	((${#BODY[@]} > cap)) && fill_body false

	total=${#BODY[@]}
	first=0
	last=$total
	W_ABOVE=0
	W_BELOW=0
	if ((total > cap)); then
		# The selection wins over the scroll position, and its top over its bottom.
		first=$SCROLL
		for pass in 1 2 3; do
			((first > total - cap + 1)) && first=$((total - cap + 1))
			((first < 0)) && first=0
			rows_window "$first" "$total" "$cap"
			((SEL_LAST >= first + W_ROOM)) && first=$((SEL_LAST - W_ROOM + 1))
			((SEL_FIRST >= 0 && SEL_FIRST < first)) && first=$SEL_FIRST
		done
		((first > total - cap + 1)) && first=$((total - cap + 1))
		((first < 0)) && first=0
		rows_window "$first" "$total" "$cap"
		last=$((first + W_ROOM))
	fi
	SCROLL=$first

	local above=0 below=0
	for ((pos = 0; pos < ${#IDX[@]}; pos++)); do
		((ROWLINE[pos] < first)) && above=$((above + 1))
		((ROWLINE[pos] >= last)) && below=$((below + 1))
	done
	((W_ABOVE > 0)) && FRAME+="${FAINT}  ↑ ${above} more above${RESET}${EOL}"$'\n'
	for ((pos = first; pos < last; pos++)); do
		FRAME+="${BODY[pos]}${EOL}"$'\n'
	done
	((W_BELOW > 0)) && FRAME+="${FAINT}  ↓ ${below} more below${RESET}${EOL}"$'\n'
	frame_footer "$footer"
}

# ---------------------------------------------------------------- grid

build_grid() {
	local footer=$1
	# Three cells of gutter with a rule down the middle, or a row of cells reads as one.
	local gutter=3 cell_w per_row
	# Aimed at a cell wide enough for a whole closing sentence, not at density.
	per_row=$((COLS / 88))
	((per_row < 1)) && per_row=1
	((per_row > 5)) && per_row=5
	cell_w=$(((COLS - (per_row - 1) * gutter) / per_row))
	((cell_w < 20)) && cell_w=20
	PER_ROW=$per_row

	build_header
	FRAME=$HEADER
	ROW_START=()
	BODY=()
	LINE_POS=()
	SEL_FIRST=-1
	SEL_LAST=-1

	if ((${#IDX[@]} == 0)); then
		FRAME+="${EOL}"$'\n'"${DIM}  nothing here${RESET}${EOL}"$'\n'
		frame_footer "$footer"
		return
	fi

	# Two lines a cell: state, name, clocks, bar and topic, then the closing line.
	local g pos start end i col l1 l2 cursor bg mark meta bar_w name_w topic_w msg_w
	local done_w rowfirst cap total first last above below
	bar_w=10
	name_w=16
	((cell_w < 44)) && {
		bar_w=6
		name_w=12
	}
	# The clock costs the topic eleven cells, which a cell under sixty cannot spare.
	done_w=0
	((cell_w >= 60)) && done_w=9
	topic_w=$((cell_w - 5 - name_w - 6 - bar_w - 5))
	((done_w > 0)) && topic_w=$((topic_w - done_w - 2))
	((topic_w < 8)) && topic_w=8
	# "  ▸ " is four cells; get this wrong and the columns drift apart.
	msg_w=$((cell_w - 4))

	for ((g = 0; g < ${#GROUP_NAME[@]}; g++)); do
		start=${GROUP_START[g]}
		end=${GROUP_START[g + 1]}
		((end > start)) || continue
		group_heading "$g" "$start" "$end"
		gpush "$start" "$GHEAD"

		pos=$start
		while ((pos < end)); do
			l1=""
			l2=""
			rowfirst=$pos
			ROW_START[${#ROW_START[@]}]=$pos
			for ((col = 0; col < per_row && pos < end; col++, pos++)); do
				i=${IDX[pos]}
				style_of "$i"
				cursor=" "
				bg=""
				mark=" "
				is_marked "${E_PANE[i]}" && {
					mark="▪"
					bg=$MARKED
				}
				((pos == selected)) && {
					cursor="❯"
					bg=$SELECTED
				}
				set_age "${E_IDLE[i]}"
				meta=$AGE
				set_ctxbar "${E_PCT[i]}" "$bar_w"

				if ((col > 0)); then
					l1+="${RULE} │ ${RESET}"
					l2+="${RULE} │ ${RESET}"
				fi

				set_idcol "$i"
				l1+="$bg"
				if [[ $cursor == " " ]]; then l1+="${BLUE}${cursor}"; else l1+="${IDCOL}${cursor}"; fi
				l1+="${DIM}${mark}${COLOUR}${GLYPH} ${IDCOL}"
				pad_to "${E_NAME[i]:-pane ${E_PANE[i]}}" "$name_w"
				l1+="${PAD}${DIM}"
				pad_left "$meta" 5
				l1+="${PADL} "
				if ((done_w > 0)); then
					done_at "$i"
					set_done "$DONE_AT"
					pad_left "$DONE" "$done_w"
					l1+="${PADL}  "
				fi
				l1+="${CTXBAR}${bg}${DIM} "
				pad_to "${E_PCT[i]:+${E_PCT[i]}%}" 4
				l1+="${PAD} ${COLOUR}"
				pad_to "${E_TITLE[i]}" "$topic_w"
				l1+="${PAD}${RESET}"

				if [[ -z ${E_LAST[i]} ]]; then
					l2+="$bg"
					pad_to "" "$cell_w"
				elif [[ ${E_ASKS[i]} == yes ]]; then
					l2+="${bg}  ${MAUVE}▸ "
					pad_to "${E_LAST[i]}" "$msg_w"
				else
					l2+="${bg}  ${DIM}▸ "
					pad_to "${E_LAST[i]}" "$msg_w"
				fi
				l2+="${PAD}${RESET}"

			done
			((selected >= rowfirst && selected < pos)) && SEL_FIRST=${#BODY[@]}
			gpush "$rowfirst" "$l1"
			gpush "$rowfirst" "$l2"
			((selected >= rowfirst && selected < pos)) && SEL_LAST=$((${#BODY[@]} - 1))
		done
	done
	ROW_START[${#ROW_START[@]}]=${#IDX[@]}

	# Clipped to the pane: an overflowing frame scrolls the alternate screen and the
	# in-place repaint then lands on the wrong rows.
	cap=$((ROWS - HEADER_LINES - FOOTER_LINES))
	((cap < 3)) && cap=3
	total=${#BODY[@]}
	first=$SCROLL
	above=0
	below=0
	if ((total <= cap)); then
		first=0
	else
		((SEL_FIRST >= 0 && SEL_FIRST < first)) && first=$SEL_FIRST
		((SEL_LAST >= 0 && SEL_LAST >= first + cap)) && first=$((SEL_LAST - cap + 1))
		((first + cap > total)) && first=$((total - cap))
		((first < 0)) && first=0
		while ((first > 0)) && ((LINE_POS[first] == LINE_POS[first - 1])); do
			first=$((first - 1))
		done
	fi
	((first > 0)) && above=1
	SCROLL=$first
	last=$((first + cap - above))
	((last > total)) && last=$total
	if ((last < total)); then
		below=1
		last=$((last - 1))
		while ((last > first)) && ((LINE_POS[last] == LINE_POS[last - 1])); do
			last=$((last - 1))
		done
	fi
	((last < first)) && last=$first

	((above > 0)) &&
		FRAME+="${FAINT}  ↑ ${LINE_POS[first]} more above${RESET}${EOL}"$'\n'
	for ((pos = first; pos < last; pos++)); do
		FRAME+="${BODY[pos]}${EOL}"$'\n'
	done
	((below > 0)) &&
		FRAME+="${FAINT}  ↓ $((${#IDX[@]} - LINE_POS[last])) more below${RESET}${EOL}"$'\n'
	frame_footer "$footer"
}

# ---------------------------------------------------------------- help

HELPKEYS=(
	"j k  ↑ ↓|move up and down"
	"h l  ← →|move across, in the grid"
	"enter|jump to that pane"
	"g  G|first, last"
	"m|mark it"
	"M|move every mark onto the end of this tab"
	"t|regroup: tab, state, name prefix"
	"c|hide the cold ones"
	"v|grid or rows"
	"x|close that pane"
	"/|filter on topic, name or last line"
	"r|refresh now"
	"q  esc|leave"
)

HELPNOTES=(
	"! errored · ? waiting on you · ✓ just finished"
	"● green working, amber stopped, grey cold"
	"the bar is context used, amber past half, red past 80%"
	"• its prompt cache is still warm, so picking it up costs nothing"
	"x closes a pane; the chat survives, claude --resume brings it back"
)

showhelp=false
build_help() {
	local kw=10 line k d entry cap left
	build_header
	FRAME=$HEADER
	((COLS < 46)) && kw=8
	# Keys before notes, and clipped to the pane like every frame.
	cap=$((ROWS - HEADER_LINES - FOOTER_LINES))
	left=$cap
	for entry in "${HELPKEYS[@]}"; do
		((left > 0)) || break
		k=${entry%%|*}
		d=${entry#*|}
		pad_to "$k" "$kw"
		line="${TEXT}  ${PAD}"
		pad_to "$d" $((COLS - kw - 4))
		line+="${DIM}${PAD}${RESET}"
		FRAME+="${line}${EOL}"$'\n'
		left=$((left - 1))
	done
	((left > ${#HELPNOTES[@]})) && {
		FRAME+="${EOL}"$'\n'
		left=$((left - 1))
	}
	for entry in "${HELPNOTES[@]}"; do
		((left > 0)) || break
		pad_to "$entry" $((COLS - 4))
		FRAME+="${FAINT}  ${PAD}${RESET}${EOL}"$'\n'
		left=$((left - 1))
	done
	frame_footer "any key to go back"
}

# ---------------------------------------------------------------- frame

FOOTER_LINES=2
build_frame() {
	FOOTER_LINES=2
	if $showhelp; then
		build_help
		return
	fi
	# Below 88 columns a grid cell cannot hold a sentence, so rows whatever was asked.
	if [[ $view == grid ]] && ((COLS >= 88)); then
		build_grid "$1"
	else
		build_rows "$1"
	fi
}

# The footer: a shorter key list for a narrower pane, never a wrapped one.
frame_footer() {
	local keys=$KEYS
	((COLS < 100)) && keys=$KEYS_MID
	((COLS < 62)) && keys=$KEYS_NARROW
	FRAME+="${EOL}"$'\n'
	if [[ $1 != "$KEYS" ]]; then keys=$1; fi
	pad_to "$keys" $((COLS - 2))
	FRAME+="${FAINT}  ${PAD}${RESET}${EOL}${EOS}"
}

readonly KEYS="h j k l move · enter jump · m mark · M move marked onto this tab · t regroup · c hide cold · v view · x close · / filter · ? keys · q quit"
readonly KEYS_MID="j k move · enter jump · m mark · M move here · t regroup · / filter · ? keys · q quit"
readonly KEYS_NARROW="j k move · ⏎ jump · / find · ? keys · q quit"

# ---------------------------------------------------------------- non-interactive modes

load_all() {
	scan_panes
	run_tails
	stamp_roster
	merge_roster "$("$FLEET" --tsv --stale-ok 2>/dev/null | tr '\t' "$US")"
	refresh_git
}

# The roster plus what only a pane read gives: asks, context and closing line.
if [[ $mode == tsv ]]; then
	measure
	load_all
	for ((i = 0; i < ${#E_PANE[@]}; i++)); do
		# No name yet (still in its grace period), and the pickers key on the name.
		[[ -n ${E_NAME[i]} ]] || continue
		id_colour "${E_ID[i]}"
		printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
			"${E_WS[i]}" "${E_PANE[i]}" "${E_NAME[i]}" "${E_KIND[i]}" "${E_ASKS[i]}" \
			"${E_IDLE[i]}" "${E_PCT[i]}" "${E_TITLE[i]}" "${E_LAST[i]}" "#${IDC_HEX}"
	done
	exit 0
fi

if [[ $mode == once ]]; then
	measure
	load_all
	build_visible
	build_frame "$KEYS"
	printf '%s\n' "$FRAME"
	exit 0
fi

if [[ $mode == watch ]]; then
	printf '\033[?25l'
	CURSOR_HIDDEN=true
	painted=""
	while :; do
		measure
		load_all
		build_visible
		build_frame "$KEYS"
		if [[ $FRAME != "$painted" ]]; then
			printf '%s' "$FRAME"
			painted=$FRAME
		fi
		sleep "$REFRESH_SECS"
	done
fi

# ---------------------------------------------------------------- interactive

if [[ -z $workspace ]] && ! $all && [[ -n ${WEZTERM_PANE:-} ]]; then
	workspace=$(wezterm cli list --format json 2>/dev/null |
		jq -r --arg p "$WEZTERM_PANE" \
			'.[] | select((.pane_id|tostring) == $p) | .workspace' 2>/dev/null)
fi

# Where LEADER+b was pressed: M's fallback when the board has no pane of its own.
ORIGIN=${CC_BOARD_ORIGIN:-}

# A lone ESC is only ESC once its tail read comes up empty. bash forces VMIN 1 VTIME 0 on
# its own reads and read -t takes whole seconds, so the tail is read by dd under VTIME 1.
TTY_SAVED=""
ESCTAIL=""
esc_tail() {
	ESCTAIL=""
	if [[ -z $TTY_SAVED ]]; then
		IFS= read -rsn2 -t 1 ESCTAIL
		return
	fi
	stty -icanon -echo min 0 time 1 </dev/tty 2>/dev/null
	ESCTAIL=$(dd bs=16 count=1 </dev/tty 2>/dev/null)
	stty "$TTY_SAVED" </dev/tty 2>/dev/null
}

# Sets KEY, not stdout: a command substitution per key is a fork.
KEY=""
read_key() {
	local timeout=$1 k
	KEY=TIMEOUT
	if [[ -n $timeout ]]; then
		IFS= read -rsn1 -t "$timeout" k || return 0
	else
		IFS= read -rsn1 k || return 0
	fi
	case $k in
	$'\e')
		esc_tail
		case $ESCTAIL in
		'') KEY=ESC ;;
		'[A' | OA) KEY=UP ;;
		'[B' | OB) KEY=DOWN ;;
		'[C' | OC) KEY=RIGHT ;;
		'[D' | OD) KEY=LEFT ;;
		# A modified arrow, a function key, a mouse report: not a reason to quit.
		*) KEY=OTHER ;;
		esac
		;;
	'') KEY=ENTER ;;
	$'\x7f') KEY=BACK ;;
	*) KEY="CHAR$k" ;;
	esac
}

# Grid rows are broken by groups, so keep the column offset into the next display row.
move_vertical() {
	local delta=$1 r target off
	if ((PER_ROW <= 1)); then
		selected=$((selected + delta))
		return
	fi
	for ((r = 0; r + 1 < ${#ROW_START[@]}; r++)); do
		((selected >= ROW_START[r] && selected < ROW_START[r + 1])) && break
	done
	off=$((selected - ROW_START[r]))
	target=$((r + delta))
	((target < 0)) && target=0
	((target + 1 >= ${#ROW_START[@]})) && target=$((${#ROW_START[@]} - 2))
	((target < 0)) && return
	selected=$((ROW_START[target] + off))
	((selected >= ROW_START[target + 1])) && selected=$((ROW_START[target + 1] - 1))
}

# Selection follows the session through a re-sort, since x closes whatever it rests on.
KEEP_PANE=""
remember_selection() {
	KEEP_PANE=""
	((${#IDX[@]} > 0)) && KEEP_PANE=${E_PANE[${IDX[selected]}]}
}

restore_selection() {
	local i
	[[ -n $KEEP_PANE ]] || return
	for ((i = 0; i < ${#IDX[@]}; i++)); do
		if [[ ${E_PANE[${IDX[i]}]} == "$KEEP_PANE" ]]; then
			selected=$i
			return
		fi
	done
}

refresh() {
	remember_selection
	scan_panes
	run_tails "${1:-}"
	if [[ ${1:-} == fresh ]]; then
		start_roster --fresh
	else
		fetch_roster
	fi
	# Gone to the background: put the last roster back on, or every name blinks out.
	$ROSTER_PENDING && [[ -n $ROSTER ]] && merge_roster "$ROSTER"
	build_visible
	restore_selection
}

jump() {
	wezterm cli activate-pane --pane-id "$1" 2>/dev/null
}

# The tab the board is in now, asked fresh: LEADER+b moves it between tabs.
HOME_TARGET=""
find_home_target() {
	HOME_TARGET=""
	[[ -n ${WEZTERM_PANE:-} ]] || return
	# Rightmost, so moved panes land on the end of the tab.
	HOME_TARGET=$(wezterm cli list --format json 2>/dev/null |
		jq -r --arg me "$WEZTERM_PANE" '
			(.[] | select((.pane_id|tostring) == $me) | .tab_id) as $tab
			| [ .[] | select(.tab_id == $tab) | select((.pane_id|tostring) != $me) ]
			| sort_by(-.left_col, .top_row) | .[0].pane_id // empty | tostring' 2>/dev/null)
}

# Everything marked becomes a split on the end of the board's tab.
move_marked() {
	local i moved=0 target
	find_home_target
	target=${HOME_TARGET:-$ORIGIN}
	if [[ -z $target ]]; then
		MESSAGE="nowhere to put them: the board is the only pane in its tab"
		return
	fi
	for ((i = 0; i < ${#E_PANE[@]}; i++)); do
		is_marked "${E_PANE[i]}" || continue
		[[ ${E_PANE[i]} == "$target" || ${E_PANE[i]} == "-" ]] && continue
		if wezterm cli split-pane --pane-id "$target" --move-pane-id "${E_PANE[i]}" \
			--right >/dev/null 2>&1; then
			moved=$((moved + 1))
			# Walk the target along, or they arrive in reverse.
			target=${E_PANE[i]}
			MARKED_PANES=${MARKED_PANES/"|${E_PANE[i]}|"/"|"}
		fi
	done
	if ((moved == 0)); then
		MESSAGE="nothing marked to move: m marks the session under the cursor"
	else
		MESSAGE="moved $moved into this tab"
	fi
}

# The title LEADER+b and format-tab-title recognise the board by.
printf '\033]0;%s\007' "${CC_BOARD_TITLE:-▤ board}"

TTY_SAVED=$( { stty -g </dev/tty; } 2>/dev/null) || TTY_SAVED=""

printf '\033[?1049h\033[?25l'
ALTSCREEN=true
CURSOR_HIDDEN=true
measure

# Three frames: wezterm and the hook maps, then the pane reads, then the roster. Never
# make the first wait on the roster.
scan_panes
build_visible
build_frame "$KEYS"
printf '%s' "$FRAME"
painted=$FRAME

run_tails
build_visible
build_frame "$KEYS"
[[ $FRAME != "$painted" ]] && {
	printf '%s' "$FRAME"
	painted=$FRAME
}

fetch_roster
build_visible

filtering=false
paused=false
MESSAGE=""
LAST_KEY_AT=-99

while :; do
	measure
	tick_now
	build_visible
	((selected >= ${#IDX[@]})) && selected=$((${#IDX[@]} - 1))
	((selected < 0)) && selected=0

	if [[ -n $MESSAGE ]]; then
		build_frame "$MESSAGE"
	elif $filtering; then
		build_frame "filtering: enter keeps it, esc clears it"
	elif $ROSTER_PENDING; then
		build_frame "reading the roster…"
	else
		build_frame "$KEYS"
	fi
	if [[ $FRAME != "$painted" ]]; then
		printf '%s' "$FRAME"
		painted=$FRAME
	fi

	# After a jump this tab is off screen: block until a key says you are back.
	if $paused; then
		read_key ""
		paused=false
		MESSAGE=""
		refresh fresh
		continue
	fi

	read_key 1
	key=$KEY
	now=$SECONDS

	if [[ $key == TIMEOUT ]]; then
		poll_roster && continue
		# Not while you are driving it: a refresh between two presses of j is felt.
		if ! $filtering &&
			((now - LAST_KEY_AT >= 2)) &&
			((now - LOADED_AT >= REFRESH_SECS)); then
			refresh
		fi
		continue
	fi

	LAST_KEY_AT=$now
	MESSAGE=""

	if $showhelp; then
		showhelp=false
		continue
	fi

	if $filtering; then
		case $key in
		ENTER) filtering=false ;;
		ESC)
			filtering=false
			filter=""
			;;
		BACK) filter=${filter%?} ;;
		UP) move_vertical -1 ;;
		DOWN) move_vertical 1 ;;
		CHAR*) filter="${filter}${key#CHAR}" ;;
		esac
		continue
	fi

	case $key in
	LEFT | CHARh) ((PER_ROW > 1)) && selected=$((selected - 1)) ;;
	RIGHT | CHARl) ((PER_ROW > 1)) && selected=$((selected + 1)) ;;
	UP | CHARk) move_vertical -1 ;;
	DOWN | CHARj) move_vertical 1 ;;
	CHARg) selected=0 ;;
	CHARG) selected=$((${#IDX[@]} - 1)) ;;
	CHAR/) filtering=true ;;
	'CHAR?') showhelp=true ;;
	CHARr) refresh fresh ;;
	CHARv)
		if ((COLS < 88)); then
			MESSAGE="a grid frame needs about ninety columns and this pane has ${COLS}"
			continue
		fi
		remember_selection
		if [[ $view == grid ]]; then view=rows; else view=grid; fi
		build_visible
		restore_selection
		;;
	CHARc)
		remember_selection
		if $hide_cold; then hide_cold=false; else hide_cold=true; fi
		build_visible
		restore_selection
		;;
	CHARt)
		if $all; then
			MESSAGE="grouped by workspace, which is the only grouping across all of them"
		else
			remember_selection
			local_next=0
			for ((gi = 0; gi < ${#GROUPINGS[@]}; gi++)); do
				[[ ${GROUPINGS[gi]} == "$grouping" ]] && local_next=$(((gi + 1) % ${#GROUPINGS[@]}))
			done
			grouping=${GROUPINGS[local_next]}
			build_visible
			restore_selection
		fi
		;;
	CHARm)
		((${#IDX[@]} == 0)) && continue
		i=${IDX[selected]}
		if is_marked "${E_PANE[i]}"; then
			MARKED_PANES=${MARKED_PANES/"|${E_PANE[i]}|"/"|"}
		else
			MARKED_PANES="${MARKED_PANES}${E_PANE[i]}|"
		fi
		selected=$((selected + 1))
		;;
	CHARM) move_marked ;;
	ENTER)
		((${#IDX[@]} == 0)) && continue
		i=${IDX[selected]}
		if [[ ${E_PANE[i]} == "-" ]]; then
			MESSAGE="${E_NAME[i]:-that session} is live but has no pane on screen"
			continue
		fi
		jump "${E_PANE[i]}"
		paused=true
		;;
	CHARx)
		((${#IDX[@]} == 0)) && continue
		i=${IDX[selected]}
		if [[ ${E_PANE[i]} == "-" ]]; then
			MESSAGE="${E_NAME[i]:-that session} has no pane to close"
			continue
		fi
		build_frame "close ${E_NAME[i]:-pane ${E_PANE[i]}}? the chat survives, claude --resume brings it back.  y/n"
		printf '%s' "$FRAME"
		painted=$FRAME
		read_key ""
		if [[ $KEY == CHARy ]]; then
			wezterm cli kill-pane --pane-id "${E_PANE[i]}" 2>/dev/null
			MESSAGE="closed ${E_NAME[i]:-pane ${E_PANE[i]}}"
			refresh fresh
		fi
		;;
	CHARq) break ;;
	ESC) break ;;
	esac
done
