#!/bin/bash
# Every Claude session in a workspace on one screen, coloured by what it wants from you.
#
# Two shapes of the same fleet, chosen by how much room there is. Wide, it is raid frames -
# a block per conversation, scanned for the colour that is wrong rather than read - which is
# why a raid UI is laid out this way and why, at this size, it is the difference between
# seeing the fleet and searching it. A frame needs about ninety columns to hold a sentence,
# and below that the board switches to rows: one line a session at any width, where the line
# is identity and state and the *selected* line opens underneath itself to give the full
# width to the topic, the closing line and the address. That is what makes a fifty column
# split work - no column has to carry a sentence, because the sentence has its own lines.
#
# The label on a row is the topic, not the name. Names here are d5-lca-63 and aperta-4c -
# an address for SendMessage, not something you recognise a conversation by - so the topic
# leads and the name moves into the expansion, where there is room for it.
#
# What it knows that nothing else here does is whether a session stopped because it finished
# or because it asked you something. The Stop hook fires either way, so an unanswered
# question wears the same glyph as a delivered result in the tab bar and in cc-fleet alike,
# and can sit there for a day. A pane's own screen is the only place that distinction
# survives, so the board reads it back and flags a closing line that ends in a question.
#
# It also organises, not just reports. Grouping defaults to the tab each session physically
# sits in, so the view shows you your own layout and where it has gone wrong; m marks and M
# moves the marked panes onto the end of whichever tab the board is sitting in.
#
#   h j k l    move          enter  jump to it        m  mark
#   v          grid / rows   x      close it          M  move marked onto this tab
#   t          regroup       c      hide cold         / filter    r refresh    q leave
#
# The first frame costs about twenty milliseconds. It is drawn from `wezterm cli list` and
# the two hook-written maps alone - pane, tab, screen position, topic and state - all of
# which are on disk already. The pane reads land next at about a tenth of a second and bring
# the context bars and the closing lines. The roster, which costs a second to assemble the
# first time because cc-peers spends a jq per registry file, is merged last and only brings
# names and ages; on a cold cache it is fetched in the background so the board is navigable
# throughout. The board used to open on a black screen for a second and a half.
#
# Two things govern how this is written. The frame is built as one string and written only
# when it differs from the last, repainting in place rather than clearing - a repaint per
# poll with a clear-screen in front of it is what a flickering TUI is. And nothing in the
# render path forks: measuring a column used to shell out to tr and wc, which at five
# columns and sixty rows was a thousand processes a frame, and ${#s} already counts
# characters rather than bytes in a UTF-8 locale.
#
# Written for the bash macOS ships, which is 3.2: no mapfile, no ${var,,}, no associative
# arrays, printf -v rather than command substitution, and read -t takes whole seconds only.
# Fields travel on a unit separator because tab is IFS whitespace, so an empty field would
# fold and shift every later field left - which is what a session with no blocked-on tool
# has.

set -u

readonly FLEET="$HOME/.claude/bin/cc-fleet"
# Sourced, not run: the palette and the hash have to agree with the tab bar and the
# statusLine, and a fork per row is what the render path may not do.
# shellcheck source=bin/cc-colour
source "$HOME/.claude/bin/cc-colour" --lib
readonly ROSTER_CACHE="$HOME/.claude/cache/fleet-rows"
readonly PANE_MAP="$HOME/.claude/wezterm-sessions"
readonly PANE_STATE="$HOME/.claude/wezterm-state"
readonly US=$'\x1f'
readonly STALE_SECS=$((8 * 3600))
# Matches FRESH_SECONDS in wezterm.lua: the tab bar's ✓ and the board's have to age out
# together, or the same session reads as just-finished in one and merely stopped in the other.
readonly FRESH_SECS=90
readonly REFRESH_SECS=6
# How long a prompt cache lives. An hour for these sessions; override it if that changes.
readonly CACHE_TTL=${CC_CACHE_TTL:-3600}
NOW=0
# The local offset, read alongside NOW rather than per row: every clock on the board is
# integer arithmetic on the two, because a date(1) fork per row is what the render path may
# not do. A timestamp from the far side of a DST change reads an hour out, which moves a day
# name never and a clock face only on the two days a year after one.
TZOFF=0
DAYNAME=(Sun Mon Tue Wed Thu Fri Sat)
MONNAME=(Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec)

stamp_now() {
	local s
	s=$( { date '+%s %z'; } 2>/dev/null)
	NOW=${s%% *}
	[[ $NOW =~ ^[0-9]+$ ]] || NOW=0
	s=${s##* }
	if [[ $s =~ ^[+-][0-9][0-9][0-9][0-9]$ ]]; then
		TZOFF=$((10#${s:1:2} * 3600 + 10#${s:3:2} * 60))
		[[ ${s:0:1} == - ]] && TZOFF=$((-TZOFF))
	fi
}

readonly BLUE=$'\033[38;2;135;215;250m'
readonly MAUVE=$'\033[38;2;203;166;247m'
readonly GREEN=$'\033[38;2;166;227;161m'
readonly YELLOW=$'\033[38;2;249;226;175m'
readonly ORANGE=$'\033[38;2;250;179;135m'
# The tab bar's waiting colour, which is not Mocha peach: a stopped session and a
# just-finished one are a hue apart there, and copying the glyphs without the hues would
# leave ✓ and ● both yellow.
readonly AMBER=$'\033[38;2;255;215;175m'
readonly RED=$'\033[38;2;243;139;168m'
readonly TEXT=$'\033[38;2;205;214;244m'
# Three greys, not two, and all of them lighter than they were: the footer and the cold
# sessions were being drawn in surface1, which is a colour for lines and panels rather than
# for anything anyone is expected to read. Text greys start at overlay1 now, and the one
# shade below that is reserved for things that are not text - rules, dividers, the empty
# half of a bar.
readonly DIM=$'\033[38;2;147;153;178m'
readonly FAINT=$'\033[38;2;127;132;156m'
readonly RULE=$'\033[38;2;88;91;112m'
readonly SELECTED=$'\033[48;2;49;50;68m'
readonly MARKED=$'\033[48;2;69;71;90m'
readonly BOLD=$'\033[1m'
readonly RESET=$'\033[0m'

# Erase to end of line, and to end of screen. Repainting with these rather than with a
# clear-screen is what stops the frame blinking: old text is overwritten in place instead of
# being removed and then replaced.
readonly EOL=$'\033[K'
readonly EOS=$'\033[J'
readonly HOME_POS=$'\033[H'

usage() {
	cat <<'USAGE'
cc-board - every Claude session in a workspace, on one screen

  cc-board                 the workspace this pane is in
  cc-board <workspace>     a named workspace instead
  cc-board --all           the whole machine, grouped by workspace
  cc-board --rows          start in rows rather than in the grid
  cc-board --once          print one frame and exit
  cc-board --watch         redraw on a loop, no keyboard
  cc-board --tsv           ws, pane, name, state, asks, idle, pct, title, last-line, colour -
                           the enriched roster, for the wezterm pickers and for scripts

  h j k l  move            enter  jump to it          m  mark / unmark
  v        grid or rows    x      close it            M  move marked onto this tab
  t        regroup         c      hide cold           /  filter    r refresh    q leave

Grid view is a frame per session: state, name, time since your last prompt, the topic, and
context drawn as a bar. It wants about ninety columns a frame, which a full width tab has
and a split of one does not.

Below that the board switches to rows: one line a session at any width, where the line is
state, topic, age and the bar, and the selected line opens underneath itself for the name to
address it by, where it is, and the whole of what it last said. v toggles the two wherever
both fit. A mauve frame or line is waiting on you: either blocked on a permission prompt, or
its closing line was a question nobody answered.

Grouping starts from the tab a session physically sits in, so the view is your own layout.
t cycles it: tab, then state, then the prefix before a colon in the session name, which is
an axis you create yourself with /rename billing:invoices.

In wezterm LEADER+b opens this zoomed down the left of the tab and puts it away again;
LEADER+z unzooms to the tab with the board still beside it, LEADER+; is the quick fuzzy jump.
USAGE
}

workspace=""
mode=interactive
# Wide, this is a raid UI and the grid is the point of it. Rows are what a fifty column
# split gets instead, and below eighty-eight columns they are what you get whichever you
# asked for.
view=grid
all=false

while (($#)); do
	case $1 in
	--once) mode=once ;;
	--tsv) mode=tsv ;;
	--watch) mode=watch ;;
	--grid) view=grid ;;
	--list | --rows) view=rows ;;
	--all) all=true ;;
	-h | --help)
		usage
		exit 0
		;;
	-*)
		usage >&2
		exit 2
		;;
	*) workspace=$1 ;;
	esac
	shift
done

work=$(mktemp -d) || exit 1
# Only undone if it was ever done: --tsv never touches the screen, and printing the
# alt-screen restore on its way out put an escape sequence on the end of the roster every
# reader of it has had to skip.
ALTSCREEN=false
CURSOR_HIDDEN=false
cleanup() {
	# esc_tail leaves the terminal raw for a tenth of a second at a time, so a kill landing
	# inside one would otherwise hand back a tty with no echo and no line editing.
	[[ -n ${TTY_SAVED:-} ]] && stty "$TTY_SAVED" </dev/tty 2>/dev/null
	$CURSOR_HIDDEN && printf '\033[?25h'
	$ALTSCREEN && printf '\033[?1049l'
	rm -rf "$work"
}
trap cleanup EXIT INT TERM

# ---------------------------------------------------------------- reading the panes

# Candidate closing lines, nearest the input box first. Several, not one, because the
# bottom-most line is usually Claude's own thinking summary rather than anything it said, and
# the sentence worth reading is the one above it. Which of them is chrome is decided in the
# shell, where a multibyte glyph is compared as a whole sequence.
readonly LASTLINE_AWK='
{ buf[NR] = $0 }
END {
	rules = 0
	found = 0
	for (i = NR; i > 0 && found < 6; i--) {
		line = buf[i]
		gsub(/^[ \t]+|[ \t]+$/, "", line)
		# A literal multibyte sequence, not a bracket expression: this awk (20200816) has no
		# \x escapes in regexes, and a class of multibyte glyphs matches their bytes
		# individually, stripping one byte and corrupting the line. Three cells of rule is
		# enough to recognise one.
		if (line ~ /^───/ || line ~ /^━━━/ || line ~ /^---/) { rules++; continue }
		if (rules < 2) continue
		if (line == "") continue
		if (line ~ /new task\?/) continue
		if (line ~ /\(click\)/) continue
		if (line ~ /Update installed/) continue
		if (line ~ /Tip: /) continue
		print line
		found++
	}
}'

# Layout markers Claude puts at the head of a continuation or activity line, and the blocks
# its startup banner is drawn from. The line is speech; the marker is furniture.
LEADERS=("▎" "⎿" "│" "⏺" "✽" "✻" "✳" "◐" "◓" "◑" "◒" "·" ">"
	"▝" "▘" "▖" "▗" "▛" "▜" "▙" "▟" "█" "▐" "▌" "▀" "▄")

# The same glyphs where they lead a wezterm pane title, which is how the first frame reads a
# session's state and topic before anything more expensive has run.
STATUS_GLYPHS=("✳" "✻" "✽" "◐" "◓" "◑" "◒" "⚠" "›" "·" "▤" "⏺")

# Result in a global rather than on stdout: called per candidate per pane, and a command
# substitution here is a fork each time.
STRIPPED=""
strip_leaders() {
	local line=$1 lead changed=true
	while $changed; do
		changed=false
		line=${line#"${line%%[![:space:]]*}"}
		for lead in "${LEADERS[@]}"; do
			if [[ $line == "$lead"* ]]; then
				line=${line#"$lead"}
				changed=true
			fi
		done
	done
	STRIPPED=${line%"${line##*[![:space:]]}"}
}

# Claude's progress and thinking summaries, which sit below whatever it last said and would
# otherwise be reported as the thing it said. Matched by shape, not by verb: the vocabulary
# rotates ("Noodling", "Baked", "Churned", "Shenaniganing", …) and is not worth chasing.
is_chrome() {
	case $1 in
	# Nothing alphabetic in it: a rule, a progress bar, part of the banner.
	*[a-zA-Z]*) ;;
	*) return 0 ;;
	esac
	case $1 in
	# No space anywhere: a path, a filename, a command fragment. Not a closing sentence.
	*" "*) ;;
	*) return 0 ;;
	esac
	case $1 in
	"Tip: "*) return 0 ;;
	*"Claude Code v"*) return 0 ;;
	*"· done "[0-9]*) return 0 ;;
	[A-Z]*" for "[0-9]*) return 0 ;;
	[A-Z]*"… ("*) return 0 ;;
	"("*")") return 0 ;;
	esac
	return 1
}

read_pane() {
	local pane=$1 text ctx line last=""
	text=$(wezterm cli get-text --pane-id "$pane" 2>/dev/null)
	while IFS= read -r line; do
		strip_leaders "$line"
		line=$STRIPPED
		((${#line} < 3)) && continue
		is_chrome "$line" && continue
		last=$line
		break
	done < <(printf '%s\n' "$text" | awk "$LASTLINE_AWK")
	ctx=$(printf '%s\n' "$text" | grep -o '[0-9]\+% of [0-9]\+[kM]' | tail -1)
	# "30% of 1M" -> "30". Two steps because ${ctx%%% *} is a correct but unreadable way to
	# say the same thing.
	ctx=${ctx%% *}
	printf '%s%s%s\n' "$last" "$US" "${ctx%\%}" >"$work/tail.$pane"
}

# ---------------------------------------------------------------- the model

E_PANE=()
E_NAME=()
E_KIND=()
E_DETAIL=()
E_IDLE=()
E_TURNS=()
E_TITLE=()
E_LAST=()
E_PCT=()
E_ASKS=()
E_WS=()
E_TAB=()
E_TABLABEL=()
E_POS=()
E_DIR=()
E_ID=()
E_SINCE=()
E_HAVE=()
BRANCH=""
DIRTY=0
WAITING=0
COLD=0
LOADED_AT=0
ROSTER=""
ROSTER_MERGED=false
MARKED_PANES="|"
UNCONFIRMED="|"

# Marks belong to the session rather than to a row, so they survive every rescan.
is_marked() { [[ $MARKED_PANES == *"|$1|"* ]]; }

# pane id -> index into the E_ arrays. A string rather than an array lookup because bash 3.2
# has no associative arrays and this is read once per row per merge.
IDXMAP="|"
IDXOF=-1
idx_of() {
	local rest
	rest=${IDXMAP#*"|$1="}
	if [[ $rest == "$IDXMAP" ]]; then IDXOF=-1; else IDXOF=${rest%%"|"*}; fi
}

# The SessionStart hook writes one file per pane holding its session id, and the Stop and
# Notification hooks write that pane's state beside it. Between them they say which panes on
# screen are Claude and what each one is doing - for nothing, since both are already on
# disk. Read with the read builtin over a glob: forty-five files, no forks.
# Lookup tables as variables named after their key rather than as one long "|k=v|" string.
# ${string#*"|$k="} is the obvious way to do it and it costs about a millisecond a call
# here: bash matches patterns character by character in a UTF-8 locale, so the cost is the
# whole map every time, and a map holding session ids is two kilobytes. Sixty-nine of those
# per scan was a tenth of a second. Indirect expansion is a hash lookup.
MAPKEYS=()
map_reset() {
	local k
	for k in ${MAPKEYS[@]+"${MAPKEYS[@]}"}; do unset "$k"; done
	MAPKEYS=()
}
map_set() {
	printf -v "$1" '%s' "$2"
	MAPKEYS[${#MAPKEYS[@]}]=$1
}

SESSION_IDS="|"
scan_hook_maps() {
	local f p sid st at
	SESSION_IDS="|"
	for f in "$PANE_MAP"/*; do
		[[ -r $f ]] || continue
		IFS= read -r sid <"$f" || continue
		[[ -n $sid ]] || continue
		p=${f##*/}
		[[ $p =~ ^[0-9]+$ ]] || continue
		SESSION_IDS="${SESSION_IDS}${sid}|"
		map_set "hk_sid_$p" "$sid"
	done
	for f in "$PANE_STATE"/*; do
		[[ -r $f ]] || continue
		IFS=$'\t' read -r st at _ <"$f" || continue
		p=${f##*/}
		[[ $p =~ ^[0-9]+$ ]] || continue
		map_set "hk_st_$p" "${st:-idle},${at:-0}"
	done
}

# State, and when the hook wrote it - which for a working session is when it started, and so
# how long it has been at it. A session that has been working for forty minutes is a
# different thing from one that started ten seconds ago, and nothing else here says which.
PSTATE=""
PSINCE=0
state_of_pane() {
	local k="hk_st_$1" entry
	PSTATE=""
	PSINCE=0
	entry=${!k:-}
	[[ -n $entry ]] || return
	PSTATE=${entry%%,*}
	PSINCE=${entry#*,}
	[[ $PSINCE =~ ^[0-9]+$ ]] || PSINCE=0
}

SID=""
sid_of_pane() {
	local k="hk_sid_$1"
	SID=${!k:-}
}

# Whether a session's prompt cache is still alive, which is the difference between picking
# it up instantly and paying to re-read the whole conversation. The clock it runs on is the
# last call to the API, which is not the age column: that counts from *your* last prompt and
# ignores an hour of agent work after it.
#
# The registry's statusUpdatedAt is that clock, near enough - it is stamped when a session
# stops working, which is when its last request finished, and it tracked the last assistant
# message to the minute in every session tested. Not the transcript's mtime, which looks
# like the same thing and is not: those get appended to long after the last exchange, and
# every session on this machine looked warm.
#
# One jq over every registry file on the machine, five milliseconds, against a tail and a
# grep and a jq per session.
scan_registry() {
	local id at
	while IFS='=' read -r id at; do
		[[ -n $id && -n $at ]] || continue
		map_set "ck_${id//-/_}" "$at"
	done < <(jq -r '
		select(.sessionId != null)
		| [ .sessionId, ((((.statusUpdatedAt // .updatedAt // 0) / 1000) | floor | tostring)) ]
		| join("=")' "$HOME"/.claude/sessions/*.json 2>/dev/null)
}

# Seconds of prompt cache left, or -1 when there is nothing to go on.
CACHE_LEFT=-1
cache_left_of() {
	local k at
	CACHE_LEFT=-1
	[[ -n $1 ]] || return
	k="ck_${1//-/_}"
	at=${!k:-}
	[[ $at =~ ^[0-9]+$ ]] || return
	((at == 0)) && return
	CACHE_LEFT=$((at + CACHE_TTL - NOW))
	((CACHE_LEFT < 0)) && CACHE_LEFT=0
}

# A wezterm pane title is the Claude topic with its status glyph in front, which makes it the
# cheapest topic on the machine. "Claude Code" is the placeholder before a session has been
# titled, so it is worth no more than an empty one.
TOPIC=""
pane_topic() {
	local t=$1 g
	for g in "${STATUS_GLYPHS[@]}"; do
		if [[ $t == "$g"* ]]; then
			t=${t#"$g"}
			break
		fi
	done
	t=${t#"${t%%[![:space:]]*}"}
	case $t in
	"Claude Code" | zsh | nvim | bash | fish) t="" ;;
	esac
	TOPIC=$t
}

# wezterm's CLI reports tab_id, an internal identifier, but the tab bar, LEADER+1..9 and
# format-tab-title all count positions from one - so "tab 9" meant nothing to anyone looking
# at their fourth tab. Ascending tab_id within a window is that order, since wezterm hands
# ids out as tabs are created; only a tab bar reordered by hand would disagree, and nothing
# in this config binds MoveTab. A tab you have named with LEADER+, is labelled by its name
# instead, which beats any number.
TABLABEL=""
tab_label() {
	local k="tabl_$1"
	TABLABEL=${!k:-}
	[[ -n $TABLABEL ]] || TABLABEL="tab ?"
}

# One wezterm call and one jq for the tab names, the pane list and every pane's position.
# It used to be three of each - tabmap, posmap and a lookup for the working tree - which was
# fifty milliseconds spent three times over on the same JSON.
scan_panes() {
	local kind a b c d e f g idx=0 prev="" label n=0

	map_reset
	scan_hook_maps
	IDXMAP="|"
	E_PANE=()
	E_NAME=()
	E_KIND=()
	E_DETAIL=()
	E_IDLE=()
	E_TURNS=()
	E_TITLE=()
	E_LAST=()
	E_PCT=()
	E_ASKS=()
	E_WS=()
	E_TAB=()
	E_TABLABEL=()
	E_POS=()
	E_DIR=()
	E_ID=()
	E_SINCE=()
	E_HAVE=()
	E_HKIND=()
	stamp_now
	scan_registry

	while IFS="$US" read -r kind a b c d e f g; do
		case $kind in
		T)
			# a=window b=tab_id c=tab_title
			if [[ $a != "$prev" ]]; then
				idx=0
				prev=$a
			fi
			idx=$((idx + 1))
			# A tab title starting with a Claude status glyph was pinned by the save layer
			# from whatever the pane was doing, so it is a whole sentence and it duplicates
			# what the rows below already say. Only a name you typed yourself earns a place
			# in a heading, and even then only the first few words of it.
			label="tab $idx"
			case $c in
			"" | [✳✻✽◐◓◑◒]*) ;;
			*) label="tab $idx · ${c:0:22}" ;;
			esac
			map_set "tabl_$b" "$label"
			;;
		P)
			# a=pane b=workspace c=tab_id d=top_row e=left_col f=title g=cwd
			sid_of_pane "$a"
			[[ -n $SID ]] || continue
			state_of_pane "$a"
			# A pane whose Stop hook last said "ended" is a shell that used to be Claude.
			[[ $PSTATE == ended ]] && continue
			if ! $all && [[ -n $workspace && $b != "$workspace" ]]; then continue; fi
			pane_topic "$f"
			E_PANE[n]=$a
			E_WS[n]=$b
			E_TAB[n]=$c
			E_POS[n]=$((d * 100000 + e))
			E_DIR[n]=$g
			E_ID[n]=$SID
			id_colour "$SID"
			printf -v "sw_$a" '%s' "$IDC_ANSI"
			printf -v "swm_$a" '%s' "$IDC_MUTED"
			printf -v "swn_$a" '%s' "$IDC_NAME"
			E_SINCE[n]=$PSINCE
			E_TITLE[n]=$TOPIC
			E_NAME[n]=""
			case $PSTATE in
			asking) E_KIND[n]=asking ;;
			working) E_KIND[n]=busy ;;
			*) E_KIND[n]=idle ;;
			esac
			# Only what a hook actually wrote counts as a live reading. No state file leaves
			# the idle above as a guess, and the roster is welcome to correct it.
			E_HKIND[n]=""
			[[ -n $PSTATE ]] && E_HKIND[n]=${E_KIND[n]}
			E_DETAIL[n]=""
			E_IDLE[n]=""
			E_TURNS[n]=""
			E_LAST[n]=""
			E_PCT[n]=""
			E_ASKS[n]=no
			E_HAVE[n]=no
			IDXMAP="${IDXMAP}${a}=${n}|"
			n=$((n + 1))
			;;
		esac
	done < <(wezterm cli list --format json 2>/dev/null | jq -r --arg us "$US" '
		([ .[] | { w: .window_id, t: .tab_id, ti: (.tab_title // "") } ]
		 | unique_by([.w, .t]) | sort_by(.w, .t)
		 | .[] | [ "T", (.w|tostring), (.t|tostring), .ti ] | join($us)),
		(.[] | [ "P", (.pane_id|tostring), .workspace, (.tab_id|tostring),
		         ((.top_row // 0)|tostring), ((.left_col // 0)|tostring),
		         (.title // ""), (.cwd // "" | sub("^file://[^/]*"; "")) ] | join($us))
	' 2>/dev/null)

	local i
	for ((i = 0; i < ${#E_PANE[@]}; i++)); do
		tab_label "${E_TAB[i]}"
		E_TABLABEL[i]=$TABLABEL
	done
	recompute_flags
}

# Every pane's screen at once. Seventy milliseconds for twenty of them, because they run in
# parallel; the wait is what makes it one cost rather than twenty.
run_tails() {
	local i
	rm -f "$work"/tail.* 2>/dev/null
	for ((i = 0; i < ${#E_PANE[@]}; i++)); do
		[[ ${E_PANE[i]} == "-" ]] && continue
		read_pane "${E_PANE[i]}" &
	done
	wait
	merge_tails
}

merge_tails() {
	local i last pct
	for ((i = 0; i < ${#E_PANE[@]}; i++)); do
		[[ -r "$work/tail.${E_PANE[i]}" ]] || continue
		IFS="$US" read -r last pct <"$work/tail.${E_PANE[i]}"
		# Never prompted, so nothing it could have said: whatever is on that screen is the
		# startup banner. Cheaper and more honest than pattern-matching the banner.
		[[ ${E_IDLE[i]} == "-1" ]] && last=""
		E_LAST[i]=$last
		E_PCT[i]=$pct
	done
	recompute_flags
}

# The roster is the only thing here that costs real time, and all it adds is the name to
# address a session by and how long since you last spoke to it. Everything that decides
# whether you need to look at a pane is already on screen by the time it lands.
merge_roster() {
	local rows=$1 ws tab pane name kind detail idle turns title id i n
	[[ -n $rows ]] || return
	ROSTER=$rows
	if ! $all && [[ -n $workspace ]]; then
		rows=$(printf '%s\n' "$rows" | awk -F"$US" -v w="$workspace" '$1 == w')
	fi
	while IFS="$US" read -r ws _ tab pane name kind detail idle turns _ title id; do
		[[ -n $name ]] || continue
		idx_of "$pane"
		i=$IDXOF
		if ((i < 0)); then
			# Live, but wezterm has no pane for it - a session whose pane died under it, or
			# one this workspace filter would otherwise hide. Still worth listing: ENTER
			# will say it has nowhere to jump to.
			[[ $pane == "-" ]] || continue
			n=${#E_PANE[@]}
			i=$n
			E_PANE[i]="-"
			E_WS[i]=$ws
			E_TAB[i]=$tab
			E_POS[i]=999999999
			E_DIR[i]=""
			E_ID[i]=""
			E_SINCE[i]=0
			E_HKIND[i]=""
			E_TITLE[i]=""
			E_LAST[i]=""
			E_PCT[i]=""
			E_TABLABEL[i]="no pane"
		fi
		E_NAME[i]=$name
		[[ -n $id ]] && E_ID[i]=$id
		# The roster's state is the registry's, cached; the hook files are written the instant
		# a turn ends. Taking the roster's word for it unconditionally is what left a session
		# showing as working for as long as the cache took to catch up - which with --stale-ok
		# is not bounded by anything. So it names the state only where no hook wrote after the
		# roster was assembled, and the stale-hook case still corrects itself, because a hook
		# that stopped firing has an epoch that keeps falling further behind.
		if [[ -z ${E_HKIND[i]:-} ]] || ((${E_SINCE[i]:-0} <= ROSTER_AT)); then
			E_KIND[i]=$kind
		fi
		E_DETAIL[i]=$detail
		E_IDLE[i]=$idle
		E_TURNS[i]=$turns
		[[ -n $title && $title != untitled ]] && E_TITLE[i]=$title
		[[ $idle == "-1" ]] && E_LAST[i]=""
		E_HAVE[i]=yes
	done <<<"$rows"

	# A pane whose hook map still points at Claude but which the registry has never heard of
	# is a session that exited without its Stop hook firing. It gets one roster's grace
	# first: a session opened in the last few seconds is not in the roster either, and
	# dropping it on sight made new panes blink in and out until the next rebuild.
	local keep=() k=0 nextmiss="|"
	for ((i = 0; i < ${#E_PANE[@]}; i++)); do
		if [[ ${E_HAVE[i]} == yes ]]; then
			keep[k++]=$i
		elif [[ $UNCONFIRMED != *"|${E_PANE[i]}|"* ]]; then
			nextmiss="${nextmiss}${E_PANE[i]}|"
			keep[k++]=$i
		fi
	done
	UNCONFIRMED=$nextmiss
	if ((k < ${#E_PANE[@]})); then
		local P=() N=() K=() D=() I=() U=() T=() L=() C=() A=() W=() B=() BL=() O=() R=() H=() ID=() SN=() HK=()
		IDXMAP="|"
		for ((n = 0; n < k; n++)); do
			i=${keep[n]}
			P[n]=${E_PANE[i]}; N[n]=${E_NAME[i]}; K[n]=${E_KIND[i]}; D[n]=${E_DETAIL[i]}
			I[n]=${E_IDLE[i]}; U[n]=${E_TURNS[i]}; T[n]=${E_TITLE[i]}; L[n]=${E_LAST[i]}
			C[n]=${E_PCT[i]}; A[n]=${E_ASKS[i]}; W[n]=${E_WS[i]}; B[n]=${E_TAB[i]}
			BL[n]=${E_TABLABEL[i]}; O[n]=${E_POS[i]}; R[n]=${E_DIR[i]}; H[n]=${E_HAVE[i]}
			ID[n]=${E_ID[i]}; SN[n]=${E_SINCE[i]}; HK[n]=${E_HKIND[i]:-}
			IDXMAP="${IDXMAP}${P[n]}=${n}|"
		done
		E_PANE=(${P[@]+"${P[@]}"}); E_NAME=(${N[@]+"${N[@]}"}); E_KIND=(${K[@]+"${K[@]}"})
		E_DETAIL=(${D[@]+"${D[@]}"}); E_IDLE=(${I[@]+"${I[@]}"}); E_TURNS=(${U[@]+"${U[@]}"})
		E_TITLE=(${T[@]+"${T[@]}"}); E_LAST=(${L[@]+"${L[@]}"}); E_PCT=(${C[@]+"${C[@]}"})
		E_ASKS=(${A[@]+"${A[@]}"}); E_WS=(${W[@]+"${W[@]}"}); E_TAB=(${B[@]+"${B[@]}"})
		E_TABLABEL=(${BL[@]+"${BL[@]}"}); E_POS=(${O[@]+"${O[@]}"}); E_DIR=(${R[@]+"${R[@]}"})
		E_HAVE=(${H[@]+"${H[@]}"}); E_ID=(${ID[@]+"${ID[@]}"}); E_SINCE=(${SN[@]+"${SN[@]}"})
		E_HKIND=(${HK[@]+"${HK[@]}"})
	fi
	ROSTER_MERGED=true
	recompute_flags
}

# asking is either state the hooks reported or a closing line that ends in a question, and
# the second of those is the whole reason this program reads screens.
recompute_flags() {
	local i
	WAITING=0
	COLD=0
	for ((i = 0; i < ${#E_PANE[@]}; i++)); do
		if [[ ${E_KIND[i]} == asking || ${E_LAST[i]} == *'?' ]]; then
			E_ASKS[i]=yes
			WAITING=$((WAITING + 1))
		else
			E_ASKS[i]=no
		fi
		is_cold "$i" && COLD=$((COLD + 1))
	done
	stamp_now
	LOADED_AT=$NOW
}

is_cold() {
	local i=$1
	[[ ${E_ASKS[i]} == yes ]] && return 1
	[[ ${E_KIND[i]} == busy ]] && return 1
	[[ -z ${E_IDLE[i]} ]] && return 1
	((${E_IDLE[i]} >= 0 && ${E_IDLE[i]} < STALE_SECS)) && return 1
	return 0
}

# Stopped within the last FRESH_SECS, which is the tab bar's ✓. done_at is the same clock the
# board already prints in the done column, so the two can never disagree; it is borrowed and
# put back because emit_row reads DONE_AT for its own column further down the same row.
is_fresh() {
	local i=$1 keep=$DONE_AT rc=1
	[[ ${E_ASKS[i]} == yes ]] && return 1
	[[ ${E_KIND[i]} == busy ]] && return 1
	done_at "$i"
	((DONE_AT > 0 && NOW - DONE_AT < FRESH_SECS)) && rc=0
	DONE_AT=$keep
	return $rc
}

# One git call for the workspace, not one per session: they nearly all share a working tree,
# which is itself worth seeing in the ✎ count.
refresh_git() {
	local cwd=""
	BRANCH=""
	DIRTY=0
	((${#E_DIR[@]} > 0)) && cwd=${E_DIR[0]}
	[[ -n $cwd && -d $cwd ]] || return
	BRANCH=$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null)
	[[ -n $BRANCH ]] &&
		DIRTY=$(git -C "$cwd" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
}

# Fetching the roster without waiting for it. Only ever needed on a cold cache, where
# assembling it costs a second: with a cache on disk cc-fleet --stale-ok returns what it has
# immediately and rebuilds behind us, so the synchronous path is the normal one.
# When the roster in hand was assembled, which is the cache file's own mtime: cc-fleet serves
# it at up to eight seconds old, and with --stale-ok at any age at all while it rebuilds
# behind you. Without this the board had no way to tell a reading from a memory.
ROSTER_AT=0
stamp_roster() {
	ROSTER_AT=$( { stat -f %m "$ROSTER_CACHE"; } 2>/dev/null) || ROSTER_AT=0
	[[ $ROSTER_AT =~ ^[0-9]+$ ]] || ROSTER_AT=0
}

ROSTER_PENDING=false
start_roster() {
	rm -f "$work/roster" "$work/roster.part" 2>/dev/null
	(
		"$FLEET" --tsv "$@" 2>/dev/null | tr '\t' "$US" >"$work/roster.part"
		mv -f "$work/roster.part" "$work/roster" 2>/dev/null
	) &
	ROSTER_PENDING=true
}

poll_roster() {
	$ROSTER_PENDING || return 1
	[[ -e "$work/roster" ]] || return 1
	ROSTER_PENDING=false
	stamp_roster
	merge_roster "$(<"$work/roster")"
	refresh_git
	return 0
}

fetch_roster() {
	$ROSTER_PENDING && return
	if [[ -r $ROSTER_CACHE ]]; then
		# Stamped before the call, not after: --stale-ok hands back what is on disk and may
		# rewrite it behind us, and dating these rows by that rewrite would make a memory
		# look like a reading.
		stamp_roster
		merge_roster "$("$FLEET" --tsv --stale-ok 2>/dev/null | tr '\t' "$US")"
		refresh_git
	else
		start_roster --stale-ok
	fi
}

# ---------------------------------------------------------------- fork-free primitives

ROWS=40
COLS=120
measure() {
	local size
	# An override for looking at the thing at widths you have not got a pane for.
	if [[ -n ${CC_BOARD_SIZE:-} ]]; then
		ROWS=${CC_BOARD_SIZE%%x*}
		COLS=${CC_BOARD_SIZE##*x}
	else
		size=$( { stty size </dev/tty; } 2>/dev/null) || size=""
		ROWS=${size%% *}
		COLS=${size##* }
	fi
	[[ $ROWS =~ ^[0-9]+$ ]] || ROWS=40
	[[ $COLS =~ ^[0-9]+$ ]] || COLS=120
}

# Clipped to a column and padded out to it, in place. ${#s} counts characters rather than
# bytes in a UTF-8 locale, so no external help is needed to measure a string with a ✎ or an
# ellipsis in it. Result in PAD, because a command substitution per column per cell was the
# entire cost of a frame.
PAD=""
CLIPPED=false
pad_to() {
	local text=$1 width=$2 n trimmed
	CLIPPED=false
	((width < 1)) && {
		PAD=""
		return
	}
	n=${#text}
	if ((n > width)); then
		CLIPPED=true
		text=${text:0:width-1}
		trimmed=${text% *}
		# Backing up to a word boundary is worth it only when the word being dropped is a
		# short one: at a thirty column label, giving up nine columns to end on a whole word
		# loses more of the topic than the ragged cut ever did.
		[[ $trimmed != "$text" ]] && ((${#trimmed} * 20 >= width * 17)) && text=$trimmed
		text="${text}…"
		n=${#text}
	fi
	if ((n < width)); then
		printf -v PAD '%s%*s' "$text" $((width - n)) ''
	else
		PAD=$text
	fi
}

PADL=""
pad_left() {
	local text=$1 width=$2
	if ((${#text} >= width)); then
		PADL=${text:0:width}
	else
		printf -v PADL '%*s%s' $((width - ${#text})) '' "$text"
	fi
}

AGE=""
set_age() {
	local s=$1
	if [[ -z $s ]]; then AGE=""
	elif ((s < 0)); then AGE=never
	elif ((s < 90)); then AGE=now
	elif ((s < 5400)); then printf -v AGE '%dm' $((s / 60))
	elif ((s < 172800)); then printf -v AGE '%dh' $((s / 3600))
	else printf -v AGE '%dd' $((s / 86400)); fi
}

# Days since 1970-01-01 to a calendar day and month (Hinnant's civil_from_days). Integer
# only, because a clock older than a week wants a date on it and date(1) is a fork.
CD=0
CM=0
civil_from_days() {
	local z=$(($1 + 719468)) era doe yoe doy mp
	era=$(((z >= 0 ? z : z - 146096) / 146097))
	doe=$((z - era * 146097))
	yoe=$(((doe - doe / 1460 + doe / 36524 - doe / 146096) / 365))
	doy=$((doe - (365 * yoe + yoe / 4 - yoe / 100)))
	mp=$(((5 * doy + 2) / 153))
	CD=$((doy - (153 * mp + 2) / 5 + 1))
	CM=$((mp < 10 ? mp + 3 : mp - 9))
}

# When a session last stopped, on the clock rather than in the relative age beside it: the
# same "done 16:40" Claude prints at the foot of its own pane, which is the form you can hold
# against a memory of the afternoon in a way "20h" never is. A previous day takes its name in
# front; past a week a day name stops being unambiguous, so it becomes a date.
DONE=""
set_done() {
	local at=$1 full=${2:-} secs day today hh mm
	DONE=""
	[[ $at =~ ^[0-9]+$ ]] && ((at > 0)) || return
	secs=$((at + TZOFF))
	day=$((secs / 86400))
	today=$(((NOW + TZOFF) / 86400))
	printf -v hh '%02d' $((secs % 86400 / 3600))
	printf -v mm '%02d' $((secs % 3600 / 60))
	if ((day >= today)); then
		DONE="${hh}:${mm}"
	elif ((today - day < 7)); then
		DONE="${DAYNAME[(day + 4) % 7]} ${hh}:${mm}"
	else
		civil_from_days "$day"
		DONE="${CD} ${MONNAME[CM - 1]}"
		[[ -n $full ]] && DONE="${DONE} ${hh}:${mm}"
	fi
}

# Which epoch that clock reads. The hook file first: it is stamped the moment a turn ends and
# matches what the pane itself prints, to the minute. The registry's statusUpdatedAt only as a
# fallback, for a session no hook ever wrote for. Nothing at all while a session is working -
# it has not finished, and a start time under a "done" heading would be a lie.
DONE_AT=0
done_at() {
	local i=$1 k
	DONE_AT=0
	[[ ${E_KIND[i]} == busy ]] && return
	if ((${E_SINCE[i]:-0} > 0)); then
		DONE_AT=${E_SINCE[i]}
		return
	fi
	[[ -n ${E_ID[i]} ]] || return
	k="ck_${E_ID[i]//-/_}"
	[[ ${!k:-} =~ ^[0-9]+$ ]] && DONE_AT=${!k}
}

# Context as the resource bar it is: how much of the window is spent, amber past half, red
# past eighty. The one number that predicts a session falling over, and worth a bar rather
# than a number because twenty bars are one glance and twenty percentages are twenty
# readings.
CTXBAR=""
set_ctxbar() {
	local pct=$1 width=$2 filled colour fill="" rest="" i
	((width < 2)) && {
		CTXBAR=""
		return
	}
	if [[ ! $pct =~ ^[0-9]+$ ]]; then
		printf -v rest '%*s' "$width" ''
		CTXBAR="${RULE}${rest// /·}${RESET}"
		return
	fi
	filled=$((pct * width / 100))
	((filled > width)) && filled=$width
	((filled == 0 && pct > 0)) && filled=1
	colour=$GREEN
	((pct >= 50)) && colour=$ORANGE
	((pct >= 80)) && colour=$RED
	for ((i = 0; i < filled; i++)); do fill="${fill}█"; done
	for ((i = filled; i < width; i++)); do rest="${rest}░"; done
	CTXBAR="${colour}${fill}${RULE}${rest}${RESET}"
}

# Word wrap, in the shell, because the expansion under a selected row is the one place a
# whole sentence has to survive a fifty column pane and fmt is a fork.
WRAPPED=()
wrap_text() {
	local text=$1 width=$2 limit=$3 line="" word
	WRAPPED=()
	((width < 4)) && return
	text=${text#"${text%%[![:space:]]*}"}
	while [[ -n $text ]]; do
		word=${text%% *}
		if [[ $word == "$text" ]]; then text=""; else text=${text#* }; fi
		[[ -n $word ]] || continue
		if [[ -z $line ]]; then
			line=$word
		elif ((${#line} + 1 + ${#word} <= width)); then
			line="$line $word"
		else
			WRAPPED[${#WRAPPED[@]}]=$line
			((${#WRAPPED[@]} >= limit)) && return
			line=$word
		fi
		# A single word longer than the column has to be cut, or it pushes the block out
		# past the pane and every line after it is wrong.
		while ((${#line} > width)); do
			WRAPPED[${#WRAPPED[@]}]=${line:0:width}
			((${#WRAPPED[@]} >= limit)) && return
			line=${line:width}
		done
	done
	[[ -n $line ]] && WRAPPED[${#WRAPPED[@]}]=$line
}

# ---------------------------------------------------------------- grouping and filtering

# tab is first because it is your actual layout: seeing four unrelated conversations sharing
# a tab is what tells you the layout has drifted. state is the triage view. prefix is the
# axis you make yourself, with /rename billing:invoices.
GROUPINGS=(tab state prefix)
grouping=tab
$all && grouping=workspace
hide_cold=false

# Sort key for a group heading. In a function rather than inline because bash 3.2's parser
# mistakes a case pattern's closing paren for the end of an enclosing process substitution
# and then rejects the ;; that follows it.
SORTKEY=""
group_sort_key() {
	local g=$1 key
	case $grouping in
	tab)
		# "tab 4" and "tab 4 · whatever you named it" both sort on the number.
		key=${g#tab }
		key=${key%% *}
		[[ $key =~ ^[0-9]+$ ]] || key=9999
		printf -v SORTKEY '%04d' "$key"
		;;
	state)
		case $g in
		"waiting on you") key=0 ;;
		working) key=1 ;;
		live) key=2 ;;
		*) key=3 ;;
		esac
		printf -v SORTKEY '%04d' "$key"
		;;
	prefix)
		# Sessions you have not given a prefix to are the leftovers, so they go last.
		if [[ $g == unprefixed ]]; then SORTKEY="zzzz"; else SORTKEY=$g; fi
		;;
	*) SORTKEY=$g ;;
	esac
}

GROUP=""
group_of() {
	local i=$1 name
	case $grouping in
	workspace) GROUP=${E_WS[i]} ;;
	tab) GROUP=${E_TABLABEL[i]} ;;
	state)
		if [[ ${E_ASKS[i]} == yes ]]; then GROUP="waiting on you"
		elif [[ ${E_KIND[i]} == busy ]]; then GROUP="working"
		elif is_cold "$i"; then GROUP="cold"
		else GROUP="live"; fi
		;;
	prefix)
		name=${E_NAME[i]}
		case $name in
		*:*) GROUP=${name%%:*} ;;
		*) GROUP="unprefixed" ;;
		esac
		;;
	esac
}

# How loudly a session is asking to be looked at, then how recently you spoke to it. Used to
# come free with the roster's own ordering, which meant the first frame - drawn before the
# roster exists - had no order at all.
URGENCY=""
urgency_of() {
	local i=$1 rank idle
	if [[ ${E_ASKS[i]} == yes ]]; then rank=4
	elif [[ ${E_KIND[i]} == busy ]]; then rank=3
	elif is_cold "$i"; then rank=0
	elif [[ ${E_KIND[i]} == shell ]]; then rank=1
	else rank=2; fi
	idle=${E_IDLE[i]:-999999999}
	((idle < 0)) && idle=999999999
	printf -v URGENCY '%d%010d' $((9 - rank)) "$idle"
}

filter=""
selected=0
SCROLL=0
IDX=()
MARK_COUNT=0
HIDDEN=0

# Indices surviving the filter, then stably sorted into groups so a view can lay them out in
# one pass. nocasematch rather than lowercasing the haystack: ${var,,} is bash 4.
GROUP_NAME=()
GROUP_START=()
build_visible() {
	local i hay pass=() g seen order=() n
	MARK_COUNT=0
	HIDDEN=0
	for ((i = 0; i < ${#E_PANE[@]}; i++)); do
		is_marked "${E_PANE[i]}" && MARK_COUNT=$((MARK_COUNT + 1))
	done
	shopt -s nocasematch
	for ((i = 0; i < ${#E_PANE[@]}; i++)); do
		if $hide_cold && is_cold "$i" && ! is_marked "${E_PANE[i]}"; then
			HIDDEN=$((HIDDEN + 1))
			continue
		fi
		if [[ -n $filter ]]; then
			hay="${E_NAME[i]} ${E_TITLE[i]} ${E_LAST[i]} ${E_KIND[i]} ${E_TABLABEL[i]}"
			[[ $hay == *"$filter"* ]] || continue
		fi
		pass[${#pass[@]}]=$i
	done
	shopt -u nocasematch

	# Each grouping gets the order that grouping implies: tabs and workspaces in their own
	# order, states by urgency, prefixes alphabetically with the unprefixed left at the end.
	seen=""
	for i in ${pass[@]+"${pass[@]}"}; do
		group_of "$i"
		if [[ $seen != *"${US}${GROUP}${US}"* ]]; then
			seen="${seen}${US}${GROUP}${US}"
			order[${#order[@]}]=$GROUP
		fi
	done

	if ((${#order[@]} > 1)); then
		local sorted=()
		while IFS= read -r g; do
			sorted[${#sorted[@]}]=${g#*"$US"}
		done < <(
			for g in "${order[@]}"; do
				group_sort_key "$g"
				printf '%s%s%s\n' "$SORTKEY" "$US" "$g"
			done | LC_ALL=C sort
		)
		order=("${sorted[@]}")
	fi

	IDX=()
	GROUP_NAME=()
	GROUP_START=()
	local members j k tmp keys=() tkey
	for g in ${order[@]+"${order[@]}"}; do
		GROUP_NAME[${#GROUP_NAME[@]}]=$g
		GROUP_START[${#GROUP_START[@]}]=${#IDX[@]}
		members=()
		keys=()
		for i in ${pass[@]+"${pass[@]}"}; do
			group_of "$i"
			[[ $GROUP == "$g" ]] || continue
			if [[ $grouping == tab ]]; then
				printf -v tkey '%012d' "${E_POS[i]}"
			else
				urgency_of "$i"
				tkey=$URGENCY
			fi
			members[${#members[@]}]=$i
			keys[${#keys[@]}]=$tkey
		done
		# Grouped by tab, the rows sit in the order the panes do on screen, so the list
		# lines up with the tab behind it. Every other grouping ranks by urgency.
		#
		# Insertion sort rather than a pipe to sort: a group is a handful of panes, and this
		# runs on every redraw.
		if ((${#members[@]} > 1)); then
			for ((j = 1; j < ${#members[@]}; j++)); do
				tmp=${members[j]}
				tkey=${keys[j]}
				k=$((j - 1))
				while ((k >= 0)) && [[ ${keys[k]} > $tkey ]]; do
					members[k + 1]=${members[k]}
					keys[k + 1]=${keys[k]}
					k=$((k - 1))
				done
				members[k + 1]=$tmp
				keys[k + 1]=$tkey
			done
		fi
		for i in ${members[@]+"${members[@]}"}; do
			IDX[${#IDX[@]}]=$i
		done
	done
	n=${#IDX[@]}
	GROUP_START[${#GROUP_START[@]}]=$n
}

# ---------------------------------------------------------------- state glyph and colour

# The identity colour, resolved once at load and stored per pane. It goes on the name,
# which is the row's identity field and was grey; the state glyph and the topic keep the
# status colours, so the two questions never share a mark.
IDCOL=""
IDMUTED=""
set_idcol() {
	local i=$1 key
	IDCOL=$FAINT
	IDMUTED=$FAINT
	[[ ${E_PANE[i]} == [0-9]* ]] || return
	key="sw_${E_PANE[i]}"
	[[ -n ${!key:-} ]] && IDCOL=${!key}
	key="swm_${E_PANE[i]}"
	[[ -n ${!key:-} ]] && IDMUTED=${!key}
}

# How many panes in a group share their hue with another pane in the same group. Ten hues
# over forty sessions makes this common, and inside one tab it is the one case where the
# colour stops identifying anything - so name it, since it is also the case a pin fixes.
CLASH=0
group_clash() {
	local start=$1 end=$2 a b ka kb ha hb
	CLASH=0
	for ((a = start; a < end; a++)); do
		ka="swn_${E_PANE[${IDX[a]}]}"
		ha=${!ka:-}
		[[ -n $ha ]] || continue
		for ((b = start; b < end; b++)); do
			((b == a)) && continue
			kb="swn_${E_PANE[${IDX[b]}]}"
			hb=${!kb:-}
			[[ $ha == "$hb" ]] && {
				CLASH=$((CLASH + 1))
				break
			}
		done
	done
}

# One heading, clipped. A tab you have named yourself with LEADER+, can be longer than a
# narrow board, and a heading that wraps costs the frame a line and leaves every row under it
# one out of place - which is the same failure as a frame that does not fit its pane.
GHEAD=""
group_heading() {
	local g=$1 start=$2 end=$3 name tail max
	group_clash "$start" "$end"
	tail=" · $((end - start))"
	((CLASH > 0)) && tail="${tail} · ${CLASH} alike"
	name=${GROUP_NAME[g]}
	max=$((COLS - 2 - ${#tail}))
	((max < 4)) && max=4
	((${#name} > max)) && name="${name:0:max - 1}…"
	GHEAD="${FAINT}  ${name}${RULE}${tail}${RESET}"
}

# The tab bar's alphabet, exactly: status is a dot, and only the two states that want
# something of you get a shape - ? blocked on a prompt, ✓ finished in the last minute and a
# half. Five different glyphs was tried in the bar and read as punctuation; a row of panes
# only scans as a row when the shape is constant and the colour varies, and the board's strip
# is that same row. › stays because the bar has no shell panes to have an opinion about.
GLYPH=""
COLOUR=""
STATE=""
style_of() {
	local i=$1
	if [[ ${E_ASKS[i]} == yes ]]; then
		STATE=asking
		GLYPH="?"
		COLOUR=$MAUVE
	elif [[ ${E_KIND[i]} == busy ]]; then
		STATE=working
		GLYPH="●"
		COLOUR=$GREEN
	elif [[ ${E_KIND[i]} == shell ]]; then
		STATE=shell
		GLYPH="›"
		COLOUR=$DIM
	elif is_fresh "$i"; then
		STATE=fresh
		GLYPH="✓"
		COLOUR=$YELLOW
	elif is_cold "$i"; then
		STATE=cold
		GLYPH="●"
		COLOUR=$FAINT
	else
		STATE=waiting
		GLYPH="●"
		COLOUR=$AMBER
	fi
}

# ---------------------------------------------------------------- header

# One cell per session, in the order the rows are in, with a space where a group changes: at
# any width that fits it, the whole fleet's state is one line and the cursor's place in it is
# visible without scrolling. This is the glance the grid gives you, folded into a strip, and
# it is what makes a narrow board still a board rather than a list.
STRIP=""
build_strip() {
	local n=${#IDX[@]} budget=$((COLS - 4)) i pos g=0 next cells=0 out="" bg
	STRIP=""
	((n < 4)) && return
	cells=$((n + ${#GROUP_NAME[@]} - 1))
	if ((cells > budget)); then
		# Too many to draw one each, so draw the counts instead. Still the same question
		# answered: how much of this fleet wants something.
		local w=0 b=0 l=0 c=0
		for ((i = 0; i < ${#IDX[@]}; i++)); do
			pos=${IDX[i]}
			if [[ ${E_ASKS[pos]} == yes ]]; then w=$((w + 1))
			elif [[ ${E_KIND[pos]} == busy ]]; then b=$((b + 1))
			elif is_cold "$pos"; then c=$((c + 1))
			else l=$((l + 1)); fi
		done
		out=""
		((w > 0)) && out="${out}${MAUVE}⚠${w} "
		((b > 0)) && out="${out}${GREEN}◐${b} "
		((l > 0)) && out="${out}${YELLOW}✳${l} "
		((c > 0)) && out="${out}${FAINT}·${c} "
		STRIP="${out}${RESET}"
		return
	fi
	next=${GROUP_START[1]:-$n}
	for ((pos = 0; pos < n; pos++)); do
		while ((pos >= next)); do
			out="${out} "
			g=$((g + 1))
			next=${GROUP_START[g + 1]:-$n}
		done
		i=${IDX[pos]}
		style_of "$i"
		bg=""
		((pos == selected)) && bg=$SELECTED
		out="${out}${bg}${COLOUR}${GLYPH}${RESET}"
	done
	STRIP=$out
}

HEADER=""
HEADER_LINES=2
build_header() {
	local head="${workspace:-all workspaces}" right seg budget gap spacer
	budget=$((COLS - ${#head} - 6))
	right="${#E_PANE[@]} chat"
	((${#E_PANE[@]} == 1)) || right="${right}s"
	((WAITING > 0)) && {
		seg=" · ${WAITING} waiting"
		((${#right} + ${#seg} <= budget)) && right="${right}${seg}"
	}
	((MARK_COUNT > 0)) && {
		seg=" · ${MARK_COUNT} marked"
		((${#right} + ${#seg} <= budget)) && right="${right}${seg}"
	}
	((HIDDEN > 0)) && {
		seg=" · ${HIDDEN} cold hidden"
		((${#right} + ${#seg} <= budget)) && right="${right}${seg}"
	}
	seg=" · by ${grouping}"
	((${#right} + ${#seg} <= budget)) && right="${right}${seg}"
	if [[ -n $BRANCH ]]; then
		seg=" · ${BRANCH}"
		((DIRTY > 0)) && seg="${seg} ✎${DIRTY}"
		((${#right} + ${#seg} <= budget)) && right="${right}${seg}"
	fi
	gap=$((COLS - ${#head} - ${#right} - 4))
	((gap < 1)) && gap=1
	printf -v spacer '%*s' "$gap" ''
	HEADER="${HOME_POS}${BLUE}▤  ${BOLD}${head}${RESET}${spacer}${DIM}${right}${RESET}${EOL}"$'\n'
	HEADER_LINES=2
	if [[ -n $filter ]]; then
		HEADER+="${YELLOW}  /${filter}${RESET}${DIM}  ${#IDX[@]} of ${#E_PANE[@]}${RESET}${EOL}"$'\n'
		return
	fi
	if ((COLS < 96)) && { [[ $view == rows ]] || ((COLS < 88)); }; then
		build_strip
		if [[ -n $STRIP ]]; then
			HEADER+="  ${STRIP}${EOL}"$'\n'
			return
		fi
	fi
	HEADER+="${EOL}"$'\n'
}

# ---------------------------------------------------------------- rows

# The width ladder. Every tier is a layout that works rather than the previous one with a
# column taken off it, because the two things that need a whole sentence - the topic and the
# closing line - are not in the row at all below a hundred and twenty columns. They are in
# the block that opens under the cursor, which owns the full width whatever that width is.
NAME_W=0
AGE_W=5
BAR_W=8
PCT_W=0
CACHE_W=0
LAST_W=0
LABEL_W=20
# "Tue 16:40", the widest form the clock takes in a row. Ten cells with its gap, which the
# topic can spare down to about seventy-six columns and not below - LEADER+b opens the board
# as an unzoomed half-split, so those middle widths are the common case and not an edge one.
# Narrower than that, the block under the cursor is the only place it fits.
DONE_W=0
# cursor, mark, state glyph, space
readonly PREFIX_W=4
row_widths() {
	local dw
	CACHE_W=1
	((COLS < 40)) && CACHE_W=0
	DONE_W=0
	((COLS >= 76)) && DONE_W=9
	dw=0
	((DONE_W > 0)) && dw=$((DONE_W + 1))
	if ((COLS >= 120)); then
		NAME_W=16 AGE_W=5 BAR_W=10 PCT_W=4
		LABEL_W=40
		LAST_W=$((COLS - PREFIX_W - NAME_W - 1 - 1 - CACHE_W - AGE_W - dw - 1 - BAR_W - 1 - PCT_W - LABEL_W - 2))
		((LAST_W < 24)) && {
			LABEL_W=$((LABEL_W + LAST_W - 24))
			LAST_W=24
		}
	elif ((COLS >= 96)); then
		NAME_W=16 AGE_W=5 BAR_W=10 PCT_W=4 LAST_W=0
		LABEL_W=$((COLS - PREFIX_W - NAME_W - 1 - 1 - CACHE_W - AGE_W - dw - 1 - BAR_W - 1 - PCT_W - 1))
	elif ((COLS >= 64)); then
		NAME_W=0 AGE_W=5 BAR_W=8 PCT_W=4 LAST_W=0
		LABEL_W=$((COLS - PREFIX_W - 1 - CACHE_W - AGE_W - dw - 1 - BAR_W - 1 - PCT_W - 1))
	elif ((COLS >= 44)); then
		NAME_W=0 AGE_W=5 BAR_W=6 PCT_W=0 LAST_W=0
		LABEL_W=$((COLS - PREFIX_W - 1 - CACHE_W - AGE_W - 1 - BAR_W - 1))
	elif ((COLS >= 32)); then
		NAME_W=0 AGE_W=4 BAR_W=4 PCT_W=0 LAST_W=0
		LABEL_W=$((COLS - PREFIX_W - 1 - CACHE_W - AGE_W - 1 - BAR_W - 1))
	else
		NAME_W=0 AGE_W=3 BAR_W=0 PCT_W=0 LAST_W=0
		LABEL_W=$((COLS - PREFIX_W - 1 - CACHE_W - AGE_W - 1))
	fi
	((LABEL_W < 6)) && LABEL_W=6
}

# What a row says when there is no topic yet: a session opened seconds ago, or one whose
# pane wezterm has lost. Better than a blank line, which reads as a bug.
row_label() {
	local i=$1
	if [[ -n ${E_TITLE[i]} ]]; then
		ROWLABEL=${E_TITLE[i]}
	elif [[ -n ${E_NAME[i]} ]]; then
		ROWLABEL=${E_NAME[i]}
	elif [[ ${E_PANE[i]} == "-" ]]; then
		ROWLABEL="no pane"
	else
		ROWLABEL="pane ${E_PANE[i]}"
	fi
}

BODY=()
push() { BODY[${#BODY[@]}]=$1; }

# A grid line on its own says nothing about how far down the fleet it is - a cell is two lines
# and a heading belongs to the cells under it. LINE_POS records, per line, the position of the
# first session in the unit it is part of, which is what makes a scroll window snap to whole
# cells and what lets "N more above" count sessions rather than lines.
LINE_POS=()
gpush() {
	LINE_POS[${#BODY[@]}]=$1
	BODY[${#BODY[@]}]=$2
}

emit_row() {
	local pos=$1 i=$2 line cursor mark bg meta labelcol
	style_of "$i"
	cursor=" "
	mark=" "
	bg=""
	is_marked "${E_PANE[i]}" && {
		mark="▪"
		bg=$MARKED
	}
	((pos == selected)) && {
		cursor="❯"
		bg=$SELECTED
	}
	set_age "${E_IDLE[i]}"
	meta=$AGE
	row_label "$i"
	labelcol=$TEXT
	[[ $STATE == cold ]] && labelcol=$FAINT
	[[ $STATE == cold && -n $bg ]] && labelcol=$DIM
	[[ ${E_ASKS[i]} == yes ]] && labelcol=$MAUVE

	set_idcol "$i"
	line="${bg}"
	if [[ $cursor == " " ]]; then line+="${BLUE}${cursor}"; else line+="${IDCOL}${cursor}"; fi
	line+="${DIM}${mark}${COLOUR}${GLYPH} ${labelcol}"
	pad_to "$ROWLABEL" "$LABEL_W"
	line+="$PAD"
	if ((NAME_W > 0)); then
		pad_to "${E_NAME[i]}" "$NAME_W"
		line+=" ${IDCOL}${PAD}"
	fi
	line+=" "
	# One cell for whether the prompt cache is still alive. Marked when it is, rather than
	# when it is not: past an hour most of a fleet this size is cold, and a column of
	# warnings that is nearly always lit says nothing. This one lights on the few you can
	# still pick up for free.
	if ((CACHE_W > 0)); then
		cache_left_of "${E_ID[i]}"
		if ((CACHE_LEFT > 0)); then line+="${BLUE}•${bg}"; else line+=" "; fi
	fi
	line+="${DIM}"
	pad_left "$meta" "$AGE_W"
	line+="$PADL"
	# Right of the age and reading the same weight, because the two answer one question
	# between them: how long since you last spoke to it, and the hour it stopped. Blank while
	# a session is working, so a lit cell here means finished and nothing else does.
	if ((DONE_W > 0)); then
		done_at "$i"
		set_done "$DONE_AT"
		pad_left "$DONE" "$DONE_W"
		line+=" ${PADL}"
	fi
	if ((BAR_W > 0)); then
		set_ctxbar "${E_PCT[i]}" "$BAR_W"
		line+=" ${CTXBAR}${bg}"
	fi
	if ((PCT_W > 0)); then
		pad_to "${E_PCT[i]:+${E_PCT[i]}%}" "$PCT_W"
		line+="${DIM} ${PAD}"
	fi
	if ((LAST_W > 0)); then
		if [[ ${E_ASKS[i]} == yes ]]; then line+="${MAUVE} ▸ "; else line+="${DIM} ▸ "; fi
		pad_to "${E_LAST[i]}" $((LAST_W - 3))
		line+="$PAD"
	fi
	push "${line}${RESET}"
}

# The block that opens under the cursor. Everything the row could not hold, at the full
# width of the pane, on the selected background so it reads as part of the row rather than
# as the rows below it having gone strange. Content first and the address last: the topic
# and the closing line are what you came to read, the name is what you use afterwards.
emit_expansion() {
	local i=$1 w=$((COLS - 6)) meta="" seg line n col huekey
	((w < 12)) && w=$((COLS - 4))
	((w < 10)) && return

	# The topic in full, but only when the row had to clip it - otherwise this is the same
	# sentence twice, one line apart.
	row_label "$i"
	pad_to "$ROWLABEL" "$LABEL_W"
	if $CLIPPED; then
		wrap_text "$ROWLABEL" "$w" 3
		for line in ${WRAPPED[@]+"${WRAPPED[@]}"}; do
			pad_to "$line" "$w"
			push "${SELECTED}    ${TEXT}${PAD}  ${RESET}"
		done
	fi

	# What it last said, whole. On a narrow board this is the only place it appears at all,
	# and mauve when it ended in a question is the one thing this program knows that the tab
	# bar does not.
	if [[ -n ${E_LAST[i]} ]]; then
		col=$DIM
		[[ ${E_ASKS[i]} == yes ]] && col=$MAUVE
		wrap_text "${E_LAST[i]}" $((w - 2)) 4
		n=0
		for line in ${WRAPPED[@]+"${WRAPPED[@]}"}; do
			if ((n == 0)); then
				pad_to "▸ $line" "$w"
			else
				pad_to "  $line" "$w"
			fi
			push "${SELECTED}    ${col}${PAD}  ${RESET}"
			n=$((n + 1))
		done
	fi

	# Where it is and what to call it. Last, because you only need it once you have decided
	# to do something about the thing above it. Ordered by what you would want first if you
	# had: the name to address it by, what it is doing, and whether picking it up is free.
	meta=${E_NAME[i]}
	local haspane=false
	[[ -z $meta ]] && {
		meta="pane ${E_PANE[i]}"
		haspane=true
	}
	if [[ ${E_KIND[i]} == asking ]]; then
		seg=" · asking${E_DETAIL[i]:+ ${E_DETAIL[i]}}"
		((${#meta} + ${#seg} <= w)) && meta="${meta}${seg}"
	elif [[ ${E_KIND[i]} == busy ]]; then
		seg=" · working"
		if ((${E_SINCE[i]:-0} > 0 && NOW > E_SINCE[i])); then
			set_age $((NOW - E_SINCE[i]))
			seg=" · working ${AGE}"
		fi
		((${#meta} + ${#seg} <= w)) && meta="${meta}${seg}"
	fi
	# Ahead of everything else here because on a narrow board this is the only place the
	# clock appears at all, and full: a session a fortnight old gets its date, not a day name
	# that could mean either of two Tuesdays.
	done_at "$i"
	if ((DONE_AT > 0)); then
		set_done "$DONE_AT" full
		seg=" · done ${DONE}"
		((${#meta} + ${#seg} <= w)) && meta="${meta}${seg}"
	fi
	huekey="swn_${E_PANE[i]}"
	if [[ -n ${!huekey:-} ]]; then
		seg=" · ${!huekey}"
		((${#meta} + ${#seg} <= w)) && meta="${meta}${seg}"
	fi
	cache_left_of "${E_ID[i]}"
	if ((CACHE_LEFT >= 60)); then
		seg=" · cache $((CACHE_LEFT / 60))m left"
		((${#meta} + ${#seg} <= w)) && meta="${meta}${seg}"
	elif ((CACHE_LEFT >= 0)); then
		seg=" · cache gone"
		((${#meta} + ${#seg} <= w)) && meta="${meta}${seg}"
	fi
	if ((PCT_W == 0)) && [[ -n ${E_PCT[i]} ]]; then
		seg=" · ${E_PCT[i]}% context"
		((${#meta} + ${#seg} <= w)) && meta="${meta}${seg}"
	fi
	if [[ ${E_PANE[i]} != "-" ]] && ! $haspane; then
		seg=" · pane ${E_PANE[i]}"
		((${#meta} + ${#seg} <= w)) && meta="${meta}${seg}"
	fi
	if [[ $grouping != tab ]]; then
		seg=" · ${E_TABLABEL[i]}"
		((${#meta} + ${#seg} <= w)) && meta="${meta}${seg}"
	fi
	if [[ -n ${E_TURNS[i]} ]] && ((E_TURNS[i] > 0)); then
		seg=" · ${E_TURNS[i]} turn"
		((E_TURNS[i] == 1)) || seg="${seg}s"
		((${#meta} + ${#seg} <= w)) && meta="${meta}${seg}"
	fi
	pad_to "$meta" "$w"
	set_idcol "$i"
	push "${SELECTED}    ${IDMUTED}${PAD}  ${RESET}"
}

FRAME=""
ROW_START=()
PER_ROW=1
SEL_FIRST=-1
SEL_LAST=-1

# A blank line between groups is worth a lot to read and nothing to understand, so it is the
# first thing given up when the fleet is taller than the pane.
fill_body() {
	local blanks=$1 g start end pos i
	BODY=()
	SEL_FIRST=-1
	SEL_LAST=-1
	for ((g = 0; g < ${#GROUP_NAME[@]}; g++)); do
		start=${GROUP_START[g]}
		end=${GROUP_START[g + 1]}
		((end > start)) || continue
		((g > 0)) && $blanks && push ""
		group_heading "$g" "$start" "$end"
		push "$GHEAD"
		for ((pos = start; pos < end; pos++)); do
			i=${IDX[pos]}
			((pos == selected)) && SEL_FIRST=${#BODY[@]}
			emit_row "$pos" "$i"
			if ((pos == selected)); then
				emit_expansion "$i"
				SEL_LAST=$((${#BODY[@]} - 1))
			fi
		done
	done
}

build_rows() {
	local footer=$1 pos total cap first last
	row_widths
	build_header
	FRAME=$HEADER
	ROW_START=()
	PER_ROW=1

	if ((${#IDX[@]} == 0)); then
		FRAME+="${EOL}"$'\n'"${DIM}  nothing here${RESET}${EOL}"$'\n'
		frame_footer "$footer"
		return
	fi

	cap=$((ROWS - HEADER_LINES - FOOTER_LINES))
	((cap < 3)) && cap=3
	fill_body true
	((${#BODY[@]} > cap)) && fill_body false

	total=${#BODY[@]}
	first=$SCROLL
	if ((total <= cap)); then
		first=0
	else
		((SEL_FIRST >= 0 && SEL_FIRST < first)) && first=$SEL_FIRST
		((SEL_LAST >= 0 && SEL_LAST >= first + cap)) && first=$((SEL_LAST - cap + 1))
		((first + cap > total)) && first=$((total - cap))
		((first < 0)) && first=0
	fi
	SCROLL=$first
	last=$((first + cap))
	((last > total)) && last=$total

	for ((pos = first; pos < last; pos++)); do
		if ((pos == first && first > 0)); then
			FRAME+="${FAINT}  ↑ ${first} more above${RESET}${EOL}"$'\n'
		elif ((pos == last - 1 && last < total)); then
			FRAME+="${FAINT}  ↓ $((total - last + 1)) more below${RESET}${EOL}"$'\n'
		else
			FRAME+="${BODY[pos]}${EOL}"$'\n'
		fi
	done
	frame_footer "$footer"
}

# ---------------------------------------------------------------- grid

build_grid() {
	local footer=$1
	# Three cells of gutter, with a rule down the middle of it. Without a divider the cells
	# run into each other and a row of four reads as one paragraph; with one, the eye finds
	# the column edges without being told where they are.
	local gutter=3 cell_w per_row
	# Aimed at a cell wide enough for a whole sentence rather than at maximum density: four
	# frames across a full-width tab gives about a hundred columns each, which is where a
	# closing line stops being a fragment. A fleet of forty still lands in ten rows.
	per_row=$((COLS / 88))
	((per_row < 1)) && per_row=1
	((per_row > 5)) && per_row=5
	cell_w=$(((COLS - (per_row - 1) * gutter) / per_row))
	((cell_w < 20)) && cell_w=20
	PER_ROW=$per_row

	build_header
	FRAME=$HEADER
	ROW_START=()
	BODY=()
	LINE_POS=()
	SEL_FIRST=-1
	SEL_LAST=-1

	if ((${#IDX[@]} == 0)); then
		FRAME+="${EOL}"$'\n'"${DIM}  nothing here${RESET}${EOL}"$'\n'
		frame_footer "$footer"
		return
	fi

	# Two lines a frame, with the topic on the first one beside the bar. The topic is short
	# and the state fields are shorter, so putting them on separate lines left a cell that
	# was half empty on one row and clipped on the next; together they fill line one and
	# hand the whole width of line two to what Claude actually said.
	local g pos start end i col l1 l2 cursor bg mark meta bar_w name_w topic_w msg_w
	local done_w rowfirst cap total first last above below
	bar_w=10
	name_w=16
	((cell_w < 44)) && {
		bar_w=6
		name_w=12
	}
	# The clock costs eleven cells out of the topic, which a narrow cell has not got: below
	# sixty the topic is already the thing being squeezed and it is worth more here.
	done_w=0
	((cell_w >= 60)) && done_w=9
	topic_w=$((cell_w - 5 - name_w - 6 - bar_w - 5))
	((done_w > 0)) && topic_w=$((topic_w - done_w - 2))
	((topic_w < 8)) && topic_w=8
	# The message line is "  ▸ " plus the text, and that prefix is four cells: budgeting the
	# text at cell_w - 6 made every message line two columns narrower than its name line, so
	# the columns drifted apart by two per cell and the grid stopped being a grid.
	msg_w=$((cell_w - 4))

	for ((g = 0; g < ${#GROUP_NAME[@]}; g++)); do
		start=${GROUP_START[g]}
		end=${GROUP_START[g + 1]}
		((end > start)) || continue
		group_heading "$g" "$start" "$end"
		gpush "$start" "$GHEAD"

		pos=$start
		while ((pos < end)); do
			l1=""
			l2=""
			rowfirst=$pos
			ROW_START[${#ROW_START[@]}]=$pos
			for ((col = 0; col < per_row && pos < end; col++, pos++)); do
				i=${IDX[pos]}
				style_of "$i"
				cursor=" "
				bg=""
				mark=" "
				is_marked "${E_PANE[i]}" && {
					mark="▪"
					bg=$MARKED
				}
				((pos == selected)) && {
					cursor="❯"
					bg=$SELECTED
				}
				set_age "${E_IDLE[i]}"
				meta=$AGE
				set_ctxbar "${E_PCT[i]}" "$bar_w"

				if ((col > 0)); then
					l1+="${RULE} │ ${RESET}"
					l2+="${RULE} │ ${RESET}"
				fi

				set_idcol "$i"
				l1+="$bg"
				if [[ $cursor == " " ]]; then l1+="${BLUE}${cursor}"; else l1+="${IDCOL}${cursor}"; fi
				l1+="${DIM}${mark}${COLOUR}${GLYPH} ${IDCOL}"
				pad_to "${E_NAME[i]:-pane ${E_PANE[i]}}" "$name_w"
				l1+="${PAD}${DIM}"
				pad_left "$meta" 5
				l1+="${PADL} "
				if ((done_w > 0)); then
					done_at "$i"
					set_done "$DONE_AT"
					pad_left "$DONE" "$done_w"
					l1+="${PADL}  "
				fi
				l1+="${CTXBAR}${bg}${DIM} "
				pad_to "${E_PCT[i]:+${E_PCT[i]}%}" 4
				l1+="${PAD} ${COLOUR}"
				pad_to "${E_TITLE[i]}" "$topic_w"
				l1+="${PAD}${RESET}"

				# Mauve when the closing line is a question: that frame is not finished, it
				# is waiting, and this line is the only place that says so.
				if [[ -z ${E_LAST[i]} ]]; then
					l2+="$bg"
					pad_to "" "$cell_w"
				elif [[ ${E_ASKS[i]} == yes ]]; then
					l2+="${bg}  ${MAUVE}▸ "
					pad_to "${E_LAST[i]}" "$msg_w"
				else
					l2+="${bg}  ${DIM}▸ "
					pad_to "${E_LAST[i]}" "$msg_w"
				fi
				l2+="${PAD}${RESET}"

			done
			((selected >= rowfirst && selected < pos)) && SEL_FIRST=${#BODY[@]}
			gpush "$rowfirst" "$l1"
			gpush "$rowfirst" "$l2"
			((selected >= rowfirst && selected < pos)) && SEL_LAST=$((${#BODY[@]} - 1))
		done
	done
	ROW_START[${#ROW_START[@]}]=${#IDX[@]}

	# The grid used to write every cell it had and let the pane deal with it. A fleet of
	# thirty is seventy lines, so in any pane shorter than that the top scrolled off the
	# alternate screen - and once it had, ESC[H no longer addressed the first line of the
	# frame, so the in-place repaint painted over the wrong rows and left last minute's text
	# standing. Both of the things that looked like "it did not load" were this.
	cap=$((ROWS - HEADER_LINES - FOOTER_LINES))
	((cap < 3)) && cap=3
	total=${#BODY[@]}
	first=$SCROLL
	above=0
	below=0
	if ((total <= cap)); then
		first=0
	else
		((SEL_FIRST >= 0 && SEL_FIRST < first)) && first=$SEL_FIRST
		((SEL_LAST >= 0 && SEL_LAST >= first + cap)) && first=$((SEL_LAST - cap + 1))
		((first + cap > total)) && first=$((total - cap))
		((first < 0)) && first=0
		while ((first > 0)) && ((LINE_POS[first] == LINE_POS[first - 1])); do
			first=$((first - 1))
		done
	fi
	((first > 0)) && above=1
	SCROLL=$first
	last=$((first + cap - above))
	((last > total)) && last=$total
	if ((last < total)); then
		below=1
		last=$((last - 1))
		while ((last > first)) && ((LINE_POS[last] == LINE_POS[last - 1])); do
			last=$((last - 1))
		done
	fi
	((last < first)) && last=$first

	((above > 0)) &&
		FRAME+="${FAINT}  ↑ ${LINE_POS[first]} more above${RESET}${EOL}"$'\n'
	for ((pos = first; pos < last; pos++)); do
		FRAME+="${BODY[pos]}${EOL}"$'\n'
	done
	((below > 0)) &&
		FRAME+="${FAINT}  ↓ $((${#IDX[@]} - LINE_POS[last])) more below${RESET}${EOL}"$'\n'
	frame_footer "$footer"
}

# ---------------------------------------------------------------- help

# A narrow footer can carry four keys, and this program has thirteen. The rest live here
# rather than in a wrapped grey line nobody reads.
HELPKEYS=(
	"j k  ↑ ↓|move up and down"
	"h l  ← →|move across, in the grid"
	"enter|jump to that pane"
	"g  G|first, last"
	"m|mark it"
	"M|move every mark onto the end of this tab"
	"t|regroup: tab, state, name prefix"
	"c|hide the cold ones"
	"v|grid or rows"
	"x|close that pane"
	"/|filter on topic, name or last line"
	"r|refresh now"
	"q  esc|leave"
)

HELPNOTES=(
	"⚠ waiting on you · ◐ working · ✳ live · · cold"
	"the bar is context used, amber past half, red past 80%"
	"• its prompt cache is still warm, so picking it up costs nothing"
	"x closes a pane; the chat survives, claude --resume brings it back"
)

showhelp=false
build_help() {
	local kw=10 line k d entry cap left
	build_header
	FRAME=$HEADER
	((COLS < 46)) && kw=8
	# The keys before the notes, and both inside the pane. A help screen that overruns puts
	# its own top off the alternate screen and takes the repaint with it, which is a poor way
	# to answer "what does this do".
	cap=$((ROWS - HEADER_LINES - FOOTER_LINES))
	left=$cap
	for entry in "${HELPKEYS[@]}"; do
		((left > 0)) || break
		k=${entry%%|*}
		d=${entry#*|}
		pad_to "$k" "$kw"
		line="${TEXT}  ${PAD}"
		pad_to "$d" $((COLS - kw - 4))
		line+="${DIM}${PAD}${RESET}"
		FRAME+="${line}${EOL}"$'\n'
		left=$((left - 1))
	done
	((left > ${#HELPNOTES[@]})) && {
		FRAME+="${EOL}"$'\n'
		left=$((left - 1))
	}
	for entry in "${HELPNOTES[@]}"; do
		((left > 0)) || break
		pad_to "$entry" $((COLS - 4))
		FRAME+="${FAINT}  ${PAD}${RESET}${EOL}"$'\n'
		left=$((left - 1))
	done
	frame_footer "any key to go back"
}

# ---------------------------------------------------------------- frame

FOOTER_LINES=2
build_frame() {
	FOOTER_LINES=2
	if $showhelp; then
		build_help
		return
	fi
	# The grid needs about ninety columns for one frame to hold a sentence; below that its
	# cells clip to nothing useful and rows, which give the whole width to one session at a
	# time, read far better. Opened as a split of one pane in a four-way tab that is the
	# normal case, so it switches itself rather than waiting to be told.
	if [[ $view == grid ]] && ((COLS >= 88)); then
		build_grid "$1"
	else
		build_rows "$1"
	fi
}

# The last rows of any frame. Clipped to the width rather than left to wrap, and shortened
# rather than clipped: a forty column pane gets the four keys worth having, not the first
# third of the full list.
frame_footer() {
	local keys=$KEYS
	((COLS < 100)) && keys=$KEYS_MID
	((COLS < 62)) && keys=$KEYS_NARROW
	FRAME+="${EOL}"$'\n'
	if [[ $1 != "$KEYS" ]]; then keys=$1; fi
	pad_to "$keys" $((COLS - 2))
	FRAME+="${FAINT}  ${PAD}${RESET}${EOL}${EOS}"
}

readonly KEYS="h j k l move · enter jump · m mark · M move marked onto this tab · t regroup · c hide cold · v view · x close · / filter · ? keys · q quit"
readonly KEYS_MID="j k move · enter jump · m mark · M move here · t regroup · / filter · ? keys · q quit"
readonly KEYS_NARROW="j k move · ⏎ jump · / find · ? keys · q quit"

# ---------------------------------------------------------------- non-interactive modes

load_all() {
	scan_panes
	run_tails
	stamp_roster
	merge_roster "$("$FLEET" --tsv --stale-ok 2>/dev/null | tr '\t' "$US")"
	refresh_git
}

# The roster plus what only a pane read can tell you: whether it is waiting on you, how full
# its context is, and its closing line. The wezterm pickers want all three, and cc-fleet
# cannot supply them because it never looks at a screen.
if [[ $mode == tsv ]]; then
	measure
	load_all
	for ((i = 0; i < ${#E_PANE[@]}; i++)); do
		# A row still inside its grace period has no roster entry yet, so no name and no
		# age. The pickers key on the name, so it is not a row for them.
		[[ -n ${E_NAME[i]} ]] || continue
		# Field 10 is the identity hex, so the wezterm pickers colour their name column
		# the same way the board does rather than working the palette out again in Lua.
		id_colour "${E_ID[i]}"
		printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
			"${E_WS[i]}" "${E_PANE[i]}" "${E_NAME[i]}" "${E_KIND[i]}" "${E_ASKS[i]}" \
			"${E_IDLE[i]}" "${E_PCT[i]}" "${E_TITLE[i]}" "${E_LAST[i]}" "#${IDC_HEX}"
	done
	exit 0
fi

if [[ $mode == once ]]; then
	measure
	load_all
	build_visible
	build_frame "$KEYS"
	printf '%s\n' "$FRAME"
	exit 0
fi

if [[ $mode == watch ]]; then
	printf '\033[?25l'
	CURSOR_HIDDEN=true
	painted=""
	while :; do
		measure
		load_all
		build_visible
		build_frame "$KEYS"
		if [[ $FRAME != "$painted" ]]; then
			printf '%s' "$FRAME"
			painted=$FRAME
		fi
		sleep "$REFRESH_SECS"
	done
fi

# ---------------------------------------------------------------- interactive

if [[ -z $workspace ]] && ! $all && [[ -n ${WEZTERM_PANE:-} ]]; then
	workspace=$(wezterm cli list --format json 2>/dev/null |
		jq -r --arg p "$WEZTERM_PANE" \
			'.[] | select((.pane_id|tostring) == $p) | .workspace' 2>/dev/null)
fi

# Where LEADER+b was pressed. Only a fallback now that M asks which tab the board is
# actually in: it still matters for a board running somewhere with no pane of its own.
ORIGIN=${CC_BOARD_ORIGIN:-}

# ESC arrives both as a key in its own right and as the head of an arrow sequence, so a lone
# ESC is only ESC once the follow-up read has come up empty.
#
# That wait used to be a second, because bash 3.2's read -t takes whole seconds and rejects
# a fraction, and it is not fixable by asking the terminal driver to wait in tenths either:
# bash forces VMIN 1 VTIME 0 for any read of its own with -n or -s, whatever stty last said.
# So the tail is read by dd under VTIME instead. A tenth of a second is far longer than the
# gap between bytes the terminal wrote in one go, and far shorter than anyone notices; an
# arrow comes back at once because its tail is already buffered. Three forks, but only on a
# keypress that starts with an escape.
TTY_SAVED=""
ESCTAIL=""
esc_tail() {
	ESCTAIL=""
	if [[ -z $TTY_SAVED ]]; then
		IFS= read -rsn2 -t 1 ESCTAIL
		return
	fi
	stty -icanon -echo min 0 time 1 </dev/tty 2>/dev/null
	ESCTAIL=$(dd bs=16 count=1 </dev/tty 2>/dev/null)
	stty "$TTY_SAVED" </dev/tty 2>/dev/null
}

read_key() {
	local timeout=$1 k
	if [[ -n $timeout ]]; then
		IFS= read -rsn1 -t "$timeout" k || {
			printf 'TIMEOUT'
			return
		}
	else
		IFS= read -rsn1 k || {
			printf 'TIMEOUT'
			return
		}
	fi
	case $k in
	$'\e')
		esc_tail
		case $ESCTAIL in
		'') printf 'ESC' ;;
		'[A' | OA) printf 'UP' ;;
		'[B' | OB) printf 'DOWN' ;;
		'[C' | OC) printf 'RIGHT' ;;
		'[D' | OD) printf 'LEFT' ;;
		# A modified arrow, a function key, a mouse report. Not a key this has anything to
		# do with, and certainly not a reason to quit.
		*) printf 'OTHER' ;;
		esac
		;;
	'') printf 'ENTER' ;;
	$'\x7f') printf 'BACK' ;;
	*) printf 'CHAR%s' "$k" ;;
	esac
}

# Vertical movement in a grid whose rows are broken by groups: find the display row holding
# the cursor, keep the column offset, and land in the same column of the next one. In rows
# view there is one per row, so it is a step.
move_vertical() {
	local delta=$1 r target off
	if ((PER_ROW <= 1)); then
		selected=$((selected + delta))
		return
	fi
	for ((r = 0; r + 1 < ${#ROW_START[@]}; r++)); do
		((selected >= ROW_START[r] && selected < ROW_START[r + 1])) && break
	done
	off=$((selected - ROW_START[r]))
	target=$((r + delta))
	((target < 0)) && target=0
	((target + 1 >= ${#ROW_START[@]})) && target=$((${#ROW_START[@]} - 2))
	((target < 0)) && return
	selected=$((ROW_START[target] + off))
	((selected >= ROW_START[target + 1])) && selected=$((ROW_START[target + 1] - 1))
}

# Selection follows the session, not the position. The list re-sorts as sessions change
# state, so a cursor that stayed put would come to rest on a different conversation between
# one refresh and the next - and x closes whatever it is resting on.
KEEP_PANE=""
remember_selection() {
	KEEP_PANE=""
	((${#IDX[@]} > 0)) && KEEP_PANE=${E_PANE[${IDX[selected]}]}
}

restore_selection() {
	local i
	[[ -n $KEEP_PANE ]] || return
	for ((i = 0; i < ${#IDX[@]}; i++)); do
		if [[ ${E_PANE[${IDX[i]}]} == "$KEEP_PANE" ]]; then
			selected=$i
			return
		fi
	done
}

# A rescan throws the arrays away and rebuilds them from wezterm, so the roster has to go
# back on afterwards or every name would blink out for as long as the next fetch takes.
refresh() {
	remember_selection
	scan_panes
	[[ -n $ROSTER ]] && merge_roster "$ROSTER"
	run_tails
	if [[ ${1:-} == fresh ]]; then
		start_roster --fresh
	else
		fetch_roster
	fi
	build_visible
	restore_selection
}

jump() {
	wezterm cli activate-pane --pane-id "$1" 2>/dev/null
}

# Where "here" is. The board moves between tabs - LEADER+b brings the running pane to
# whichever tab you press it in - so the tab to move things into is the one the board is
# sitting in now, not the one it was launched from. Asked fresh rather than read off the
# last scan, because the move may have happened a moment ago.
HOME_TARGET=""
find_home_target() {
	HOME_TARGET=""
	[[ -n ${WEZTERM_PANE:-} ]] || return
	# Rightmost, and the marked panes are split to its right, so they land on the end of the
	# tab rather than being inserted into the middle of work already arranged.
	HOME_TARGET=$(wezterm cli list --format json 2>/dev/null |
		jq -r --arg me "$WEZTERM_PANE" '
			(.[] | select((.pane_id|tostring) == $me) | .tab_id) as $tab
			| [ .[] | select(.tab_id == $tab) | select((.pane_id|tostring) != $me) ]
			| sort_by(-.left_col, .top_row) | .[0].pane_id // empty | tostring' 2>/dev/null)
}

# The organising move: everything marked becomes a split on the end of the tab the board is
# in, so scattered conversations end up together. Reversible - move them back the same way -
# and it never touches the conversations themselves.
move_marked() {
	local i moved=0 target
	find_home_target
	target=${HOME_TARGET:-$ORIGIN}
	if [[ -z $target ]]; then
		MESSAGE="nowhere to put them: the board is the only pane in its tab"
		return
	fi
	for ((i = 0; i < ${#E_PANE[@]}; i++)); do
		is_marked "${E_PANE[i]}" || continue
		[[ ${E_PANE[i]} == "$target" || ${E_PANE[i]} == "-" ]] && continue
		if wezterm cli split-pane --pane-id "$target" --move-pane-id "${E_PANE[i]}" \
			--right >/dev/null 2>&1; then
			moved=$((moved + 1))
			# A move keeps the pane id, so walking the target along puts the next one to the
			# right of the last. Without it they arrive in reverse.
			target=${E_PANE[i]}
			MARKED_PANES=${MARKED_PANES/"|${E_PANE[i]}|"/"|"}
		fi
	done
	if ((moved == 0)); then
		MESSAGE="nothing marked to move: m marks the session under the cursor"
	else
		MESSAGE="moved $moved into this tab"
	fi
}

# Naming the pane so LEADER+b can find this one and put it away, and so format-tab-title
# treats it as furniture rather than as another topic competing for the tab's title.
printf '\033]0;%s\007' "${CC_BOARD_TITLE:-▤ board}"

TTY_SAVED=$( { stty -g </dev/tty; } 2>/dev/null) || TTY_SAVED=""

printf '\033[?1049h\033[?25l'
ALTSCREEN=true
CURSOR_HIDDEN=true
measure

# The first frame is drawn from wezterm and the hook maps alone, which is about twenty
# milliseconds: topics, tabs, screen order and state, enough to navigate and jump. The pane
# reads follow at a tenth of a second with the bars and the closing lines. The roster is
# last because it is the only slow thing here and all it adds is names and ages - and if it
# has no cache to serve it goes to the background rather than holding the screen.
scan_panes
build_visible
build_frame "$KEYS"
printf '%s' "$FRAME"
painted=$FRAME

run_tails
build_visible
build_frame "$KEYS"
[[ $FRAME != "$painted" ]] && {
	printf '%s' "$FRAME"
	painted=$FRAME
}

fetch_roster
build_visible

filtering=false
paused=false
MESSAGE=""
LAST_KEY_AT=0

while :; do
	measure
	build_visible
	((selected >= ${#IDX[@]})) && selected=$((${#IDX[@]} - 1))
	((selected < 0)) && selected=0

	if [[ -n $MESSAGE ]]; then
		build_frame "$MESSAGE"
	elif $filtering; then
		build_frame "filtering: enter keeps it, esc clears it"
	elif $ROSTER_PENDING; then
		build_frame "reading the roster…"
	else
		build_frame "$KEYS"
	fi
	if [[ $FRAME != "$painted" ]]; then
		printf '%s' "$FRAME"
		painted=$FRAME
	fi

	# Blocked with no timeout once a jump has moved the window elsewhere: this tab is off
	# screen, so polling it would read twenty panes for nobody. The next keypress means you
	# are back.
	if $paused; then
		read_key "" >/dev/null
		paused=false
		MESSAGE=""
		refresh fresh
		continue
	fi

	key=$(read_key 1)
	now=$(date +%s)

	if [[ $key == TIMEOUT ]]; then
		poll_roster && continue
		# Only while you are not driving it. Reading twenty panes takes a tenth of a second,
		# and spending that between two presses of j is what makes a list feel like it is
		# fighting you.
		if ! $filtering &&
			((now - LAST_KEY_AT >= 2)) &&
			((now - LOADED_AT >= REFRESH_SECS)); then
			refresh
		fi
		continue
	fi

	LAST_KEY_AT=$now
	MESSAGE=""

	if $showhelp; then
		showhelp=false
		continue
	fi

	if $filtering; then
		case $key in
		ENTER) filtering=false ;;
		ESC)
			filtering=false
			filter=""
			;;
		BACK) filter=${filter%?} ;;
		UP) move_vertical -1 ;;
		DOWN) move_vertical 1 ;;
		CHAR*) filter="${filter}${key#CHAR}" ;;
		esac
		continue
	fi

	case $key in
	LEFT | CHARh) ((PER_ROW > 1)) && selected=$((selected - 1)) ;;
	RIGHT | CHARl) ((PER_ROW > 1)) && selected=$((selected + 1)) ;;
	UP | CHARk) move_vertical -1 ;;
	DOWN | CHARj) move_vertical 1 ;;
	CHARg) selected=0 ;;
	CHARG) selected=$((${#IDX[@]} - 1)) ;;
	CHAR/) filtering=true ;;
	'CHAR?') showhelp=true ;;
	CHARr) refresh fresh ;;
	CHARv)
		if ((COLS < 88)); then
			MESSAGE="a grid frame needs about ninety columns and this pane has ${COLS}"
			continue
		fi
		remember_selection
		if [[ $view == grid ]]; then view=rows; else view=grid; fi
		build_visible
		restore_selection
		;;
	CHARc)
		remember_selection
		if $hide_cold; then hide_cold=false; else hide_cold=true; fi
		build_visible
		restore_selection
		;;
	CHARt)
		# workspace grouping only means anything when more than one is on screen.
		if $all; then
			MESSAGE="grouped by workspace, which is the only grouping across all of them"
		else
			remember_selection
			local_next=0
			for ((gi = 0; gi < ${#GROUPINGS[@]}; gi++)); do
				[[ ${GROUPINGS[gi]} == "$grouping" ]] && local_next=$(((gi + 1) % ${#GROUPINGS[@]}))
			done
			grouping=${GROUPINGS[local_next]}
			build_visible
			restore_selection
		fi
		;;
	CHARm)
		((${#IDX[@]} == 0)) && continue
		i=${IDX[selected]}
		if is_marked "${E_PANE[i]}"; then
			MARKED_PANES=${MARKED_PANES/"|${E_PANE[i]}|"/"|"}
		else
			MARKED_PANES="${MARKED_PANES}${E_PANE[i]}|"
		fi
		selected=$((selected + 1))
		;;
	CHARM) move_marked ;;
	ENTER)
		((${#IDX[@]} == 0)) && continue
		i=${IDX[selected]}
		if [[ ${E_PANE[i]} == "-" ]]; then
			MESSAGE="${E_NAME[i]:-that session} is live but has no pane on screen"
			continue
		fi
		jump "${E_PANE[i]}"
		paused=true
		;;
	CHARx)
		((${#IDX[@]} == 0)) && continue
		i=${IDX[selected]}
		build_frame "close ${E_NAME[i]:-pane ${E_PANE[i]}}? the chat survives, claude --resume brings it back.  y/n"
		printf '%s' "$FRAME"
		painted=$FRAME
		confirm=$(read_key "")
		if [[ $confirm == CHARy ]]; then
			wezterm cli kill-pane --pane-id "${E_PANE[i]}" 2>/dev/null
			MESSAGE="closed ${E_NAME[i]:-pane ${E_PANE[i]}}"
			refresh fresh
		fi
		;;
	CHARq) break ;;
	ESC) break ;;
	esac
done
