#!/bin/bash
# Every live Claude session grouped by wezterm workspace, ranked by how much it wants
# you, and aged by the last time *you* typed into it rather than by anything an agent
# did on its own. Roster and titles come from cc-peers.
#
# Rows are joined on a unit separator: tab is IFS whitespace, so read would fold every
# empty field and shift the rest of the row left.

set -u
# The GUI runs these with PATH=/usr/bin:/bin:/usr/sbin:/sbin: no wezterm, no cc-*
PATH="$HOME/.claude/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
# file mtime: BSD stat on macOS; GNU elsewhere, where `stat -f` means the filesystem
if [[ $OSTYPE == darwin* ]]; then MTIME=(-f %m); else MTIME=(-c %Y); fi

readonly PEERS="$HOME/.claude/bin/cc-peers"
readonly HISTORY="$HOME/.claude/history.jsonl"
readonly STALE_DEFAULT=8
readonly US=$'\x1f'

# Assembling the rows is too slow for a keypress, and nothing but state moves inside
# a few seconds.
readonly CACHE="$HOME/.claude/cache/fleet-rows"
readonly CACHE_TTL=8
readonly NOTES="$HOME/.claude/fleet/notes.tsv"
readonly CTX_DIR="$HOME/.claude/cache/context"
readonly PANE_STATE="$HOME/.claude/wezterm-state"
# What you have read, kept by wezterm.lua: see "unread" there.
readonly PANE_READ="$HOME/.claude/cache/pane-read"
# Past this handing a session over is a live option; past FULL it is overdue.
readonly CTX_WARN=60
readonly CTX_FULL=80
# The prompt cache's life, from statusUpdatedAt, when the statusLine has not recorded the
# real expiry (it drops to 5m in overage). Must match cc-board and wezterm.lua.
readonly PROMPT_CACHE_TTL=3600
# Background sessions (claude --bg) have no registry file and no pane: only this.
readonly JOBS="$HOME/.claude/jobs"
# `<short id>` -> the updatedAt epoch you have read with --job. Past JOB_DAYS a finished
# job stops asking.
readonly JOB_SEEN="$HOME/.claude/cache/jobs-seen"
readonly JOB_DAYS=3
readonly JOB_CACHE="$HOME/.claude/cache/job-rows"
# A cold session below this costs too little to resume to be worth a line in --brief.
readonly COLD_WORTH=100000

# shellcheck source=bin/cc-colour
source "$HOME/.claude/bin/cc-colour" --lib

# Colour only for a terminal: piped, 55% of the output was escape codes.
if [[ -t 1 ]]; then
	readonly BLUE=$'\033[38;2;135;215;255m'
	readonly MAUVE=$'\033[38;2;203;166;247m'
	readonly RED=$'\033[38;2;243;139;168m'
	readonly GREEN=$'\033[38;2;166;227;161m'
	readonly YELLOW=$'\033[38;2;249;226;175m'
	readonly DIM=$'\033[38;2;108;112;134m'
	readonly BOLD=$'\033[1m'
	readonly RESET=$'\033[0m'
else
	readonly BLUE="" MAUVE="" RED="" GREEN="" YELLOW="" DIM="" BOLD="" RESET=""
	id_colour() { IDC_ANSI=""; IDC_MUTED=""; IDC_NAME=""; }
fi

usage() {
	cat <<'USAGE'
cc-fleet - every live Claude session, grouped by wezterm workspace

  cc-fleet                 dashboard: workspace, state, how long since you last spoke
  cc-fleet --stale [H]     only sessions you have not prompted in H hours (default 8)
  cc-fleet --reap [H]      what closing those would cost; add --yes to close them
  cc-fleet --tsv           workspace, window, tab, pane, name, state, detail, idle_secs,
                           turns, dir, title, id - one row per session, no header row
  cc-fleet --fresh         skip the few-second row cache
  cc-fleet --stale-ok      serve the cache at any age and refresh behind you; for a
                           caller that must not block, like the wezterm board
  cc-fleet --json          the same rows as JSON, for Claude and other readers
  cc-fleet --brief         only what wants you, plus a count. Prefer it when reading
                           the fleet from a session
  cc-fleet --tab           only the sessions sharing this pane's tab. A modifier, not a
                           mode: --tab --brief, --tab --tsv, --tab on its own
  cc-fleet --jobs [--json] background sessions (claude --bg): state, what they need
  cc-fleet --job <id>      one job's result and what it needs, and mark it read

Age is time since *your* last prompt, not since the session last did anything: an agent
chattering to itself for an hour does not make the work live. Closing a pane loses no
conversation. While its prompt cache is warm `claude --resume <id>` brings it back; once
it is cold, never wake it: `cc-handover <id> --new` starts a successor that reads it
from disk.

In wezterm: LEADER+; fuzzy-jumps to any session in any workspace, LEADER+@ types another
session's address into the prompt.
USAGE
}

mode=dashboard
stale_hours=$STALE_DEFAULT
confirm=false
fresh=false
stale_ok=false
tab_only=false
want_jobs=false
job_id=""

while (($#)); do
	case $1 in
	--tsv) mode=tsv ;;
	--brief) mode=brief ;;
	--json) mode=json ;;
	--stale) mode=stale ;;
	--reap) mode=reap ;;
	--yes | -y) confirm=true ;;
	--fresh) fresh=true ;;
	--stale-ok) stale_ok=true ;;
	--tab) tab_only=true ;;
	--jobs) want_jobs=true ;;
	--job)
		shift
		job_id=${1:-}
		[[ -n $job_id ]] || {
			echo "cc-fleet: --job needs an id (cc-fleet --jobs)" >&2
			exit 2
		}
		;;
	-h | --help)
		usage
		exit 0
		;;
	[0-9]*) stale_hours=$1 ;;
	*)
		usage >&2
		exit 2
		;;
	esac
	shift
done

# Closing panes on a state up to CACHE_TTL old could close one you just prompted.
[[ $mode == reap ]] && $confirm && fresh=true

now=$(date +%s)
stale_secs=$((stale_hours * 3600))

# Into TOK, fork-free: 470k, 1.7M.
TOK=""
fmt_tok() {
	local n=$1
	if ((n >= 1000000)); then
		TOK="$((n / 1000000)).$((n % 1000000 / 100000))M"
	elif ((n >= 1000)); then
		TOK="$((n / 1000))k"
	else
		TOK=$n
	fi
}

# One jq over every job: short, state, epoch of its last change, name, needs, result,
# session id. A placeholder in every field, since tab-like folding would shift them.
# Cached against the state files' mtimes (-nt is a builtin): the jq was most of what
# --brief gained from knowing about jobs.
job_rows() {
	local f n=0 stale=false head line
	for f in "$JOBS"/*/state.json; do
		[[ -e $f ]] || continue
		n=$((n + 1))
		# Not strictly newer: a same-second write would otherwise hide a change for good
		[[ $JOB_CACHE -nt $f ]] || stale=true
	done
	if ! $stale && [[ -r $JOB_CACHE ]]; then
		{
			IFS= read -r head
			if [[ $head == "#$n" ]]; then
				while IFS= read -r line; do printf '%s\n' "$line"; done
				return 0
			fi
		} <"$JOB_CACHE"
	fi
	mkdir -p "${JOB_CACHE%/*}" 2>/dev/null
	{ printf '#%s\n' "$n"; job_rows_jq; } >"$JOB_CACHE.$$" &&
		mv -f "$JOB_CACHE.$$" "$JOB_CACHE"
	{ IFS= read -r head; while IFS= read -r line; do printf '%s\n' "$line"; done; } \
		<"$JOB_CACHE"
}

job_rows_jq() {
	((n > 0)) || return 0
	jq -r --arg us "$US" '
		def ep: (. // "") | sub("\\.[0-9]+Z$"; "Z") | (fromdateiso8601? // 0);
		def one: (. // "" | tostring | gsub("[\t\n\u001f]+"; " ")) as $s
			| if $s == "" then "-" else $s end;
		select(.daemonShort or .sessionId)
		| [ (.daemonShort // .sessionId[0:8]), (.state | one),
		    ((.lastTerminalAt // .updatedAt) | ep | tostring), (.name | one),
		    (.needs | one), ((.output.result // .detail) | one), (.sessionId | one) ]
		| join($us)' "$JOBS"/*/state.json 2>/dev/null
}

# Read with --job since it last changed.
job_seen() {
	local short=$1 at=$2 seen=""
	[[ -r $JOB_SEEN/$short ]] && read -r seen <"$JOB_SEEN/$short"
	[[ $seen == "$at" ]]
}

# Stopped on a question for you (state.json's needs) and not read since: it wants you,
# however old. Finished without one, it is unread for JOB_DAYS.
job_wants() {
	[[ $3 != "-" ]] && ! job_seen "$1" "$2"
}
job_unread() {
	local short=$1 at=$2
	((now - at < JOB_DAYS * 86400)) || return 1
	! job_seen "$short" "$at"
}

job_running() {
	case $1 in running | working | starting | busy | queued) return 0 ;; esac
	return 1
}

if [[ -n $job_id ]]; then
	hit=""
	while IFS="$US" read -r j_short j_state j_at j_name j_needs j_result j_sid; do
		[[ $j_short == "$job_id"* || $j_sid == "$job_id"* ]] || continue
		hit=$j_short
		printf '%s  %s (%s)\n' "$j_short" "$j_name" "$j_state"
		[[ $j_needs != "-" ]] && printf 'needs   %s\n' "$j_needs"
		[[ $j_result != "-" ]] && printf 'result  %s\n' "$j_result"
		# Never wake a cold one: its successor reads it from disk instead.
		j_exp=""
		[[ -r $CTX_DIR/$j_sid ]] && IFS=$'\t' read -r _ _ _ j_exp _ <"$CTX_DIR/$j_sid"
		[[ $j_exp =~ ^[0-9]+$ ]] || j_exp=$((j_at + PROMPT_CACHE_TTL))
		if ((now < j_exp)); then
			printf 'resume  claude --resume %s\n' "$j_sid"
		else
			printf 'cold    cc-handover %s --new\n' "$j_sid"
		fi
		mkdir -p "$JOB_SEEN" 2>/dev/null && printf '%s\n' "$j_at" >"$JOB_SEEN/$j_short"
		break
	done < <(job_rows)
	[[ -n $hit ]] || { echo "cc-fleet: no background job $job_id" >&2; exit 1; }
	exit 0
fi

if $want_jobs; then
	if [[ $mode == json ]]; then
		while IFS="$US" read -r j_short j_state j_at j_name j_needs j_rest; do
			u=0
			job_running "$j_state" || ! job_unread "$j_short" "$j_at" || u=1
			job_running "$j_state" || ! job_wants "$j_short" "$j_at" "$j_needs" || u=2
			printf '%s\n' "$j_short$US$j_state$US$j_at$US$j_name$US$j_needs$US$j_rest$US$u"
		done < <(job_rows) | jq -c -Rs --arg us "$US" '
			def u: if . == "-" then null else . end;
			split("\n") | map(select(length > 0) | split($us)
				| { id: .[0], state: .[1], changed_at: (.[2] | tonumber), name: .[3],
				    needs: (.[4] | u), result: (.[5] | u), session_id: .[6],
				    unread: (.[7] != "0"), wants_you: (.[7] == "2") })'
		exit 0
	fi
	any=false
	while IFS="$US" read -r j_short j_state j_at j_name j_needs j_result _; do
		any=true
		mark=" "
		if ! job_running "$j_state"; then
			job_unread "$j_short" "$j_at" && mark="*"
			job_wants "$j_short" "$j_at" "$j_needs" && mark="?"
		fi
		age=$((now - j_at))
		if ((age < 5400)); then age="$((age / 60))m"
		elif ((age < 172800)); then age="$((age / 3600))h"
		else age="$((age / 86400))d"; fi
		printf '%s %s  %-8s %4s  %s\n' "$mark" "$j_short" "$j_state" "$age" "${j_name:0:60}"
		[[ $j_needs != "-" ]] && printf '      needs: %s\n' "${j_needs:0:100}"
	done < <(job_rows | sort -t"$US" -k3,3nr)
	$any || echo "No background jobs."
	$any && echo "? wants you, * unread; cc-fleet --job <id> reads one"
	exit 0
fi

# pane id -> workspace, window, tab, cwd.
pane_table() {
	wezterm cli list --format json 2>/dev/null | jq -r '
		.[] | [ (.pane_id|tostring), .workspace, (.window_id|tostring), (.tab_id|tostring),
		        (.cwd // "" | sub("^file://[^/]*"; "")) ] | join("\u001f")' 2>/dev/null
}

# Rank leads so every consumer can sort on one numeric column: how loudly it asks.
# Its own temp dir, because the --stale-ok refresh outlives the process that started it.
assemble_rows() {
	local dir
	dir=$(mktemp -d) || return
	pane_table >"$dir/panes"
	# session id -> epoch of your last prompt, and how many you have sent.
	jq -r 'select(.sessionId and .timestamp)
		| [ .sessionId, ((.timestamp / 1000) | floor | tostring) ] | @tsv' "$HISTORY" \
		2>/dev/null | awk -F'\t' -v us="$US" '
			{ n[$1]++; if ($2 > last[$1]) last[$1] = $2 }
			END { for (s in n) print s us last[s] us n[s] }
		' >"$dir/prompts"
	"$PEERS" --tsv 2>/dev/null | awk -F'\t' -v now="$now" -v cut="$stale_secs" -v US="$US" \
		-v panefile="$dir/panes" -v promptfile="$dir/prompts" '
BEGIN {
	while ((getline line < panefile) > 0) {
		n = split(line, f, US)
		if (n >= 4) { ws[f[1]] = f[2]; win[f[1]] = f[3]; tb[f[1]] = f[4]; cwd[f[1]] = f[5] }
	}
	while ((getline line < promptfile) > 0) {
		n = split(line, f, US)
		if (n >= 3) { seen[f[1]] = f[2]; turns[f[1]] = f[3] }
	}
	# errored first: asking and waiting resume the moment you answer, a dead turn never.
	need["errored"] = 6
	# shell: the turn is over and a background shell of its own still runs
	need["asking"] = 5; need["waiting"] = 5; need["busy"] = 4; need["shell"] = 4
	need["idle"] = 1
}
{
	name = $1; id = $2; state = $3; pane = $4; dir = $5; title = $6
	# Everything after the first space: waitingFor is a phrase, not a word.
	sp = index(state, " ")
	kind = (sp > 0) ? substr(state, 1, sp - 1) : state
	detail = (sp > 0) ? substr(state, sp + 1) : ""

	# No prompt on record (a handover never typed into) stays unknown, not fresh.
	idle = (id in seen) ? now - seen[id] : -1
	rank = need[kind] + 0
	if (kind == "idle" && idle >= 0 && idle < cut) rank = 3
	print rank US (pane in ws ? ws[pane] : "-") US (pane in win ? win[pane] : "-") \
		US (pane in tb ? tb[pane] : "-") US pane US name US kind US detail US idle \
		US (id in turns ? turns[id] : 0) US dir US title US id \
		US (pane in cwd ? cwd[pane] : "")
}'
	rm -rf "$dir"
}

# Atomic: a half-written cache would read as a truncated roster.
write_cache() {
	[[ -n $1 ]] || return
	mkdir -p "${CACHE%/*}" 2>/dev/null &&
		printf '%s\n' "$1" >"$CACHE.$$" 2>/dev/null &&
		mv -f "$CACHE.$$" "$CACHE" 2>/dev/null
}

rows=""
cache_age=$((CACHE_TTL + 1))
if [[ -r $CACHE ]]; then
	cache_age=$((now - $(stat "${MTIME[@]}" "$CACHE" 2>/dev/null || echo 0)))
fi

if $fresh; then
	rows=$(assemble_rows)
	write_cache "$rows"
elif ((cache_age <= CACHE_TTL)); then
	rows=$(<"$CACHE")
elif $stale_ok && [[ -r $CACHE ]]; then
	rows=$(<"$CACHE")
	# One refresh at a time; mkdir is the atomic lock, cleared after a minute.
	if [[ -d $CACHE.lock ]] &&
		(($(stat "${MTIME[@]}" "$CACHE.lock" 2>/dev/null || echo 0) < now - 60)); then
		rmdir "$CACHE.lock" 2>/dev/null
	fi
	if mkdir "$CACHE.lock" 2>/dev/null; then
		(
			trap 'rmdir "$CACHE.lock" 2>/dev/null' EXIT
			write_cache "$(assemble_rows)"
		) >/dev/null 2>&1 &
		disown 2>/dev/null || true
	fi
else
	rows=$(assemble_rows)
	write_cache "$rows"
fi

[[ -n $rows ]] || {
	echo "No live Claude sessions." >&2
	exit 0
}

# tab_id from wezterm, not the rows: the caller may be a shell pane with no session.
if $tab_only; then
	[[ -n ${WEZTERM_PANE:-} ]] || {
		echo "cc-fleet --tab: WEZTERM_PANE is unset, so there is no tab to scope to." >&2
		exit 2
	}
	my_tab=$(pane_table | awk -F"$US" -v p="$WEZTERM_PANE" '$1 == p { print $4; exit }')
	[[ -n ${my_tab:-} ]] || {
		echo "cc-fleet --tab: wezterm does not know pane $WEZTERM_PANE." >&2
		exit 2
	}
	rows=$(printf '%s\n' "$rows" | awk -F"$US" -v t="$my_tab" '$4 == t')
	[[ -n $rows ]] || {
		echo "No live Claude sessions on this tab." >&2
		exit 0
	}
fi

if [[ $mode == tsv ]]; then
	printf '%s\n' "$rows" | cut -d"$US" -f2-13 | tr "$US" '\t'
	exit 0
fi

# Written by the statusLine: used_pct, window, epoch, then expires_at, ttl, recache tokens
# and hit ratio, `-` where it had none (older files stop at three). Live sessions only,
# and a read builtin rather than an awk: the directory holds every session that ever ran.
# No field is ever empty, so IFS=tab is safe here.
while IFS="$US" read -r _ _ _ _ _ _ _ _ _ _ _ _ c_sid _; do
	[[ -n ${c_sid:-} && -r $CTX_DIR/$c_sid ]] || continue
	c_pct="" c_win="" c_exp="" c_re=""
	IFS=$'\t' read -r c_pct c_win _ c_exp _ c_re _ <"$CTX_DIR/$c_sid" 2>/dev/null
	c_key=${c_sid//-/_}
	printf -v "cx_$c_key" '%s' "${c_pct:-}"
	printf -v "cw_$c_key" '%s' "${c_win:-}"
	printf -v "ce_$c_key" '%s' "${c_exp:-}"
	printf -v "cr_$c_key" '%s' "${c_re:-}"
done <<<"$rows"

# Last reply per session, for whether its prompt cache is still warm. One jq, 5ms.
while IFS='=' read -r k_sid k_at; do
	[[ -n $k_sid && -n $k_at ]] || continue
	printf -v "ck_${k_sid//-/_}" '%s' "$k_at"
done < <(jq -r 'select(.sessionId != null)
	| "\(.sessionId)=\(((.statusUpdatedAt // .updatedAt // 0) / 1000) | floor)"' \
	"$HOME"/.claude/sessions/*.json 2>/dev/null)

# Is this session's prompt cache warm? The statusLine's expires_at when it recorded one,
# else the last reply plus the assumed TTL, else rank 3 (prompted inside the stale window).
is_warm() {
	local key=${1//-/_} rank=$2 k
	k="ce_$key"
	[[ ${!k:-} =~ ^[0-9]+$ ]] && { ((now < ${!k})); return; }
	k="ck_$key"
	[[ ${!k:-0} =~ ^[1-9][0-9]*$ ]] && { ((now - ${!k} < PROMPT_CACHE_TTL)); return; }
	((rank >= 3))
}

# Into COST: tokens a cold resume writes back. The statusLine's own figure when it gave
# one, else used_pct of the window; empty when neither is known.
COST=""
resume_cost() {
	local key=${1//-/_} k p w
	COST=""
	k="cr_$key"
	[[ ${!k:-} =~ ^[0-9]+$ ]] && { COST=${!k}; return; }
	k="cx_$key"; p=${!k:-}
	k="cw_$key"; w=${!k:-}
	[[ $p =~ ^[0-9]+$ && $w =~ ^[0-9]+$ ]] && COST=$((p * w / 100))
}

if [[ $mode == json ]]; then
	# idle_seconds is -1 when you have never prompted it, which is not zero.
	while IFS="$US" read -r j_rank j_rest; do
		j_sid=${j_rest#*"$US"*"$US"*"$US"*"$US"*"$US"*"$US"*"$US"*"$US"*"$US"*"$US"*"$US"}
		j_sid=${j_sid%%"$US"*}
		w=0
		is_warm "$j_sid" "$j_rank" && w=1
		resume_cost "$j_sid"
		printf '%s\n' "$j_rank$US$j_rest$US$w$US${COST:--}"
	done <<<"$rows" | cut -d"$US" -f2-13,15- |
		jq -c -Rs --arg us "$US" 'split("\n") | map(select(length > 0) | split($us))
			| map({ workspace: .[0], window: .[1], tab_id: .[2], pane: .[3], name: .[4],
			        state: .[5], blocked_on: .[6], idle_seconds: (.[7] | tonumber?),
			        your_turns: (.[8] | tonumber?), dir: .[9], title: .[10], id: .[11],
			        cache_warm: (.[12] == "1"), resume_tokens: (.[13] | tonumber?) })'
	exit 0
fi

# Notes and context are read per call rather than cached: a note is the one field you
# change and expect to see at once. A variable per key, not one joined string, which
# would cost the whole map per lookup under a UTF-8 locale.
if [[ -r $NOTES ]]; then
	while IFS=$'\t' read -r n_sid _ n_flags n_prog n_stat; do
		[[ -n $n_sid ]] || continue
		printf -v "nf_${n_sid//-/_}" '%s' "${n_flags:--}"
		printf -v "np_${n_sid//-/_}" '%s' "${n_prog:--}"
		printf -v "ns_${n_sid//-/_}" '%s' "${n_stat:--}"
	done <"$NOTES"
fi


if [[ $mode == brief ]]; then
	# What has asked for you by name comes first: it wants something done away from here.
	needs=""
	while IFS="$US" read -r _ _ _ _ _ nm _ _ _ _ _ _ sid _; do
		[[ -n ${sid:-} ]] || continue
		fkey="nf_${sid//-/_}"
		skey="ns_${sid//-/_}"
		case ",${!fkey:--}," in
		*,needs,*) needs="$needs  $nm: ${!skey:--}"$'\n' ;;
		esac
	done <<<"$rows"
	[[ -n $needs ]] && printf 'needs you:\n%s' "$needs"

	# Background jobs stopped on a question for you join the list; finished ones get a line.
	jobs_want="" jobs_done=""
	while IFS="$US" read -r j_short j_state j_at j_name j_needs j_result _; do
		job_running "$j_state" && continue
		if job_wants "$j_short" "$j_at" "$j_needs"; then
			jobs_want="$jobs_want$j_short$US$((now - j_at))$US${j_name:0:30}$US"
			jobs_want="$jobs_want${j_needs:0:50}"$'\n'
		elif job_unread "$j_short" "$j_at"; then
			jobs_done="$jobs_done  $j_short ${j_name:0:40}"
			[[ $j_result != "-" ]] && jobs_done="$jobs_done: ${j_result:0:60}"
			jobs_done="$jobs_done"$'\n'
		fi
	done < <(job_rows)

	# Busy and parked are not asking anything of you: counted, never listed. The last line
	# is the counts, for the shell to finish.
	brief=$(printf '%s\n' "$rows" | JOBS_WANT=$jobs_want awk -F"$US" -v cut="$stale_secs" '
		# Two buckets rather than a sort: rows arrive in start order, and an errored
		# session must not sit among the asking ones.
		$7 == "errored" { urgent[++u] = $7 "\t" $9 "\t" $6 "\t" $8 "\t" $2; next }
		$7 == "asking" || $7 == "waiting" {
			want[++k] = $7 "\t" $9 "\t" $6 "\t" $8 "\t" $2
			next
		}
		$7 == "busy" || $7 == "shell" { busy++; next }
		{ rest++ }
		$7 == "idle" && ($9 < 0 || $9 >= cut) { old++ }
		END {
			nj = split(ENVIRON["JOBS_WANT"], jl, "\n") - 1
			for (i = 1; i <= nj; i++) {
				split(jl[i], f, "\037")
				want[++k] = "job\t" f[2] "\t" f[1] "\t" f[4] "\t" f[3]
			}
			w = u + k
			if (w == 0) print "nothing wants you"
			else {
				printf "%d want%s you\n", w, (w == 1 ? "s" : "")
				for (i = 1; i <= w; i++) {
					n = split((i <= u ? urgent[i] : want[i - u]), f, "\t")
					age = (f[2] < 0) ? "never" : \
						(f[2] < 5400 ? int(f[2] / 60) "m" : \
						(f[2] < 172800 ? int(f[2] / 3600) "h" : int(f[2] / 86400) "d"))
					printf "  %-8s %5s  %-18s %s%s\n", f[1], age, f[3], f[5],
						(f[4] == "" ? "" : "  (" f[4] ")")
				}
			}
			printf "#%d %d %d\n", busy + 0, rest + 0, old + 0
		}')
	counts=${brief##*$'\n'}
	[[ $brief == *$'\n'* ]] && printf '%s\n' "${brief%$'\n'*}"
	read -r n_busy n_rest n_old <<<"${counts#\#}"

	# Finished since you last left the pane: wezterm.lua's pane-read mirror against each
	# pane's hook record (cc-board's is_unread). The pane you are looking at is read.
	unread="" r_focus="" READ_OK=false
	if [[ -r $PANE_READ ]]; then
		READ_OK=true
		# No empty field in this file, so IFS=tab is safe here.
		while IFS=$'\t' read -r r_p r_at r_mk; do
			if [[ $r_p == focus ]]; then
				[[ $r_mk == 1 ]] && r_focus=$r_at
				continue
			fi
			[[ $r_p =~ ^[0-9]+$ ]] || continue
			printf -v "ra_$r_p" '%s' "$r_at"
			printf -v "rm_$r_p" '%s' "$r_mk"
		done <"$PANE_READ"
	fi

	# One pass for the rest: unread, what resuming the cold ones would write back into the
	# cache, and what is near full. Each extra pass over the rows was a few ms.
	n_cold=0 cold_sum=0 full=""
	while IFS="$US" read -r rk _ _ _ u_pane nm kind _ _ _ _ _ sid _; do
		[[ -n ${sid:-} ]] || continue
		key="cx_${sid//-/_}"
		pct=${!key:-}
		[[ -n $pct ]] && ((pct >= CTX_WARN)) && full="$full  $nm $pct%"$'\n'
		[[ $kind == idle ]] || continue
		if ! is_warm "$sid" "$rk"; then
			resume_cost "$sid"
			if [[ -n $COST ]] && ((COST >= COLD_WORTH)); then
				n_cold=$((n_cold + 1))
				cold_sum=$((cold_sum + COST))
			fi
		fi
		# Finished since you last left the pane: cc-board's is_unread, over wezterm.lua's
		# pane-read mirror and the pane's hook record. The pane you are looking at is read.
		$READ_OK || continue
		[[ $u_pane =~ ^[0-9]+$ && $u_pane != "$r_focus" ]] || continue
		k="rm_$u_pane"
		if [[ ${!k:-} != 1 ]]; then
			[[ -r $PANE_STATE/$u_pane ]] || continue
			IFS= read -r line <"$PANE_STATE/$u_pane" || continue
			u_st=${line%%$'\t'*}
			line=${line#*$'\t'}
			u_at=${line%%$'\t'*}
			u_sid=""
			[[ $line == *$'\t'*$'\t'* ]] && u_sid=${line##*$'\t'}
			[[ $u_st == done || $u_st == parked ]] || continue
			[[ -z $u_sid || $u_sid == "$sid" ]] || continue
			k="ra_$u_pane"
			[[ ${!k:-} =~ ^[0-9]+$ && $u_at =~ ^[0-9]+$ ]] || continue
			((u_at > ${!k})) || continue
		fi
		unread="$unread${unread:+, }$nm"
	done <<<"$rows"

	[[ -n $unread ]] && printf 'unread: %s\n' "$unread"
	line="$n_rest idle"
	((n_busy > 0)) && line="$n_busy working, $line"
	((n_old > 0)) && line="$line, $n_old stale"
	printf '%s\n' "$line"
	if ((n_cold > 0)); then
		fmt_tok "$cold_sum"
		printf '%d cold hold ~%s tokens to resume; hand over or close (--stale)\n' \
			"$n_cold" "$TOK"
	fi
	[[ -n $jobs_done ]] && printf 'background, finished unread (cc-fleet --job <id>):\n%s' \
		"$jobs_done"
	if [[ -n $full ]]; then
		printf 'near full (cc-handover --new):\n'
		# Two leading spaces make the name field 3 and the percentage field 4.
		printf '%s' "$full" | sort -t' ' -k4,4nr
	fi
	exit 0
fi

# Into AGE rather than stdout, so a row costs no subshell.
AGE=""
fmt_age() {
	local s=$1
	if ((s < 0)); then AGE=never
	elif ((s < 90)); then AGE=now
	elif ((s < 5400)); then AGE="$((s / 60))m"
	elif ((s < 172800)); then AGE="$((s / 3600))h"
	else AGE="$((s / 86400))d"; fi
}

# Not doing anything, and not spoken to in stale_hours. busy, shell (its own background
# shell still runs) and asking never qualify.
reapable=$(printf '%s\n' "$rows" | awk -F"$US" -v cut="$stale_secs" '
	$7 == "idle" && ($9 < 0 || $9 >= cut)' | sort -t"$US" -k9,9nr)

if [[ $mode == stale || $mode == reap ]]; then
	if [[ -z $reapable ]]; then
		printf '%sNothing idle beyond %sh.%s\n' "$GREEN" "$stale_hours" "$RESET"
		exit 0
	fi
	count=$(printf '%s\n' "$reapable" | wc -l | tr -d ' ')
	printf '%s%s chats with no prompt from you in over %sh%s\n\n' \
		"$BOLD" "$count" "$stale_hours" "$RESET"
	while IFS="$US" read -r rk ws _ _ pane name _ _ idle turns _ title sid _; do
		fmt_age "$idle"
		# Resuming a cold one writes its context back: what handing over would save.
		TOK="-"
		if ! is_warm "$sid" "$rk"; then
			resume_cost "$sid"
			[[ -n $COST ]] && fmt_tok "$COST"
		fi
		printf '  %s%5s%s  %s%-18s%s %s%-13s %3st %6s%s  %s\n' \
			"$DIM" "$AGE" "$RESET" "$YELLOW" "$name" "$RESET" \
			"$DIM" "${ws:0:13}" "$turns" "$TOK" "$RESET" "${title:0:50}"
	done <<<"$reapable"

	if [[ $mode == stale ]]; then
		printf '\n%sReap them with:  cc-fleet --reap %s%s\n' "$DIM" "$stale_hours" "$RESET"
		exit 0
	fi

	printf '\n%sClosing these frees %s panes; every conversation survives.%s\n' \
		"$DIM" "$count" "$RESET"
	# Stale is hours since your prompt, so nearly all of these are cold, and a cold one is
	# never woken: its successor reads it from disk.
	printf '%s  cc-handover <name> --new   picks any of them up in a fresh session.%s\n' \
		"$DIM" "$RESET"
	if ! $confirm; then
		printf '\n%sDry run. Add --yes to close them.%s\n' "$YELLOW" "$RESET"
		exit 0
	fi
	killed=0
	while IFS="$US" read -r _ _ _ _ pane _ _ _ _ _ _ _ _ _; do
		[[ $pane == "-" ]] && continue
		wezterm cli kill-pane --pane-id "$pane" 2>/dev/null && ((killed++))
	done <<<"$reapable"
	printf '%sClosed %s panes.%s\n' "$GREEN" "$killed" "$RESET"
	exit 0
fi

# Dashboard. Workspaces by their neediest session, then by the most recently prompted,
# then rows within each by rank and idle. One awk prefixes every row with its
# workspace's order and counts, so one sort does the lot.
ordered=$(printf '%s\n' "$rows" | awk -F"$US" -v OFS="$US" -v cut="$stale_secs" '
	{
		line[NR] = $0; w = $2
		idle = ($9 < 0) ? 999999999 : $9
		if (!(w in rank) || $1 > rank[w]) rank[w] = $1
		if (!(w in recent) || idle < recent[w]) recent[w] = idle
		n[w]++
		# Working is not wanting: only what has stopped for you counts.
		if ($7 == "errored" || $7 == "asking" || $7 == "waiting") wants[w]++
		if ($7 == "idle" && ($9 < 0 || $9 >= cut)) old[w]++
	}
	END {
		for (i = 1; i <= NR; i++) {
			split(line[i], f, FS)
			w = f[2]
			print 9 - rank[w], recent[w], w, n[w], wants[w] + 0, old[w] + 0, line[i]
		}
	}' | sort -t"$US" -k1,1n -k2,2n -k3,3 -k7,7nr -k15,15n)

total=0
needy=0
nws=0
cold_n=0
cold_total=0
cur_ws=""
started=false
while IFS="$US" read -r _ _ ws n wants old rank _ _ _ pane name kind detail idle turns _ \
	title id repo; do
	if ! $started || [[ $ws != "$cur_ws" ]]; then
		started=true
		cur_ws=$ws
		nws=$((nws + 1))
		total=$((total + n))
		needy=$((needy + wants))
		# One git call per workspace: its sessions mostly share a checkout.
		gitbit=""
		if [[ -n $repo && -d $repo ]]; then
			branch=$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null)
			if [[ -n $branch ]]; then
				dirty=$(git --no-optional-locks -C "$repo" status --porcelain 2>/dev/null |
					wc -l | tr -d ' ')
				gitbit="  ${branch}"
				((dirty > 0)) && gitbit="${gitbit} ✎${dirty}"
			fi
		fi
		plural=s
		[[ $n == 1 ]] && plural=""
		printf '\n%s%s%s %s%s chat%s' "$BOLD$BLUE" "$ws" "$RESET" "$DIM" "$n" "$plural"
		((wants > 0)) && printf '%s · %s wants you%s' "$MAUVE" "$wants" "$DIM"
		((old > 0)) && printf ' · %s idle >%sh' "$old" "$stale_hours"
		printf '%s%s\n' "$gitbit" "$RESET"
	fi

	case $kind in
	errored)
		glyph="!"
		colour=$RED
		;;
	asking | waiting)
		glyph="⚠"
		colour=$MAUVE
		;;
	busy | shell)
		glyph="◐"
		colour=$GREEN
		;;
	*)
		# Grey once its prompt cache has gone cold: picking it up pays for the context.
		if is_warm "$id" "$rank"; then
			glyph="✳"
			colour=$YELLOW
		else
			glyph="·"
			colour=$DIM
		fi
		;;
	esac
	label=$kind
	[[ -n $detail ]] && label="$kind $detail"
	# What picking a cold one up writes back, where that is worth knowing.
	if [[ $glyph == "·" ]]; then
		resume_cost "$id"
		if [[ -n $COST ]] && ((COST >= COLD_WORTH)); then
			fmt_tok "$COST"
			label="cold ~$TOK"
			cold_n=$((cold_n + 1))
			cold_total=$((cold_total + COST))
		fi
	fi
	body=""
	[[ $glyph == "·" ]] && body=$DIM

	# A note the session left itself says what holds the work up, so it takes the line.
	key=${id//-/_}
	nstat="ns_$key"; nprog="np_$key"; nflag="nf_$key"
	note=${!nstat:--}
	prog=${!nprog:--}
	flags=${!nflag:--}
	if [[ $note != "-" ]]; then
		title="▸ $note"
		body=$YELLOW
	fi
	[[ $prog != "-" ]] && label="$label $prog"
	# Fullness only once it is worth acting on; below that it crowds the state.
	ckey="cx_$key"
	cpct=${!ckey:-}
	if [[ -n $cpct ]] && ((cpct >= CTX_WARN)); then
		label="$label ${cpct}%"
		((cpct >= CTX_FULL)) && colour=$MAUVE
	fi
	case ",$flags," in
	*,mute,*) glyph="◌" ;;
	esac
	id_colour "$id"
	fmt_age "$idle"
	printf '  %s%s %s%-18s%s %s%-13s %5s %3st%s  %s%s%s %s%s%s\n' \
		"$colour" "$glyph" "${IDC_ANSI:-$colour}" "$name" "$RESET" \
		"$DIM" "${label:0:13}" "$AGE" "$turns" "$RESET" \
		"$body" "${title:0:50}" "$RESET" "$DIM" "$pane" "$RESET"
done <<<"$ordered"

stale_count=0
[[ -n $reapable ]] && stale_count=$(printf '%s\n' "$reapable" | wc -l | tr -d ' ')
printf '\n%s%s chats%s %s· %s workspaces' "$BOLD" "$total" "$RESET" "$DIM" "$nws"
((needy > 0)) && printf '%s · %s wants you%s' "$MAUVE" "$needy" "$DIM"
((stale_count > 0)) && printf ' · %s idle >%sh - cc-fleet --stale' "$stale_count" "$stale_hours"
if ((cold_n > 0)); then
	fmt_tok "$cold_total"
	printf ' · %s cold hold ~%s to resume' "$cold_n" "$TOK"
fi
printf '%s\n' "$RESET"

# Background sessions: no pane, so no workspace to sit under.
bg=""
while IFS="$US" read -r j_short j_state j_at j_name j_needs _; do
	if job_running "$j_state"; then
		glyph="◐" colour=$GREEN
	elif job_wants "$j_short" "$j_at" "$j_needs"; then
		glyph="⚠" colour=$MAUVE
	elif job_unread "$j_short" "$j_at"; then
		glyph="✓" colour=$YELLOW
	elif ((now - j_at < JOB_DAYS * 86400)); then
		glyph="·" colour=$DIM
	else
		continue
	fi
	fmt_age "$((now - j_at))"
	note=""
	[[ $j_needs != "-" ]] && note=": ${j_needs:0:40}"
	bg="$bg$(printf '  %s%s %-8s %-8s %5s%s  %s%s' "$colour" "$glyph" "$j_short" \
		"${j_state:0:8}" "$AGE" "$RESET" "${j_name:0:32}" "$note")"$'\n'
done < <(job_rows | sort -t"$US" -k3,3nr)
if [[ -n $bg ]]; then
	printf '\n%sbackground%s %s(cc-fleet --job <id>)%s\n%s' "$BOLD$BLUE" "$RESET" "$DIM" \
		"$RESET" "$bg"
fi
