#!/bin/bash
# Move work from a session that is full to one that is empty, out of what is already on
# disk: the transcript and cc-note. The brief goes inline, so work starts without a tool
# call, and to a file, so it can be reread or handed on again. It names the transcript,
# because a successor that can go and look beats one holding a summary.

set -u

readonly FLEET="$HOME/.claude/fleet"
readonly OUT="$FLEET/handover"
# A gather (.tab, or several sources) records its sources here, keyed by the receiving
# pane: `pane\tsid\tname` per line. ccx reads it to close them once Jacob is satisfied
readonly GATHERED="$FLEET/gathered"
# What a gather types, unsent, into the receiver: Enter on it closes the sources
readonly PREFILL='!ccx'
# A fresh session is polled until it is busy on the brief; typing before its prompt is up
# loses the keys
readonly PREFILL_POLL=0.5
readonly PREFILL_TRIES=120
# Transcripts reach 13MB; the useful part is the end.
readonly TAIL_BYTES=400000
# Past this inline, the new session is handed the file path instead.
readonly INLINE_MAX=12000
# Shorter assistant messages are scaffolding between tool calls, not findings.
readonly TRIVIAL_TEXT=160
# A prompt can be a pasted document. Head and tail, because the instruction sits before
# a paste about as often as after it.
readonly CLIP_MAX=1100
readonly CLIP_HEAD=650
readonly CTX_DIR="$HOME/.claude/cache/context"
# Assumed when the statusLine has not recorded an expiry. Must match cc-board and cc-fleet
readonly PROMPT_CACHE_TTL=3600

usage() {
	cat <<'USAGE'
cc-handover - hand a session's work to a fresh one

  cc-handover [T]                    print the brief for a session (default: this one)
  cc-handover [T] --new [--right|--down|--tab|--window]
                                     open a fresh session, seeded with it
  cc-handover [T] --new --in <pane>  open it split from that pane, in that pane's tab
  cc-handover [T] --to <pane>        paste the brief into a session already open
  cc-handover .tab --to <pane>       gather: send it, then type !ccx there (unsent) to
                                     close the sources once you are satisfied; refused
                                     when that one is idle and cold, since pasting wakes it
  cc-handover [T] --save             just write the file and print its path
  cc-handover [T] --new --dry-run    print the command it would run, and stop

  --turns N     how many substantive replies to carry (default 3)
  --why <text>  a line saying why the work moved

T is a session name, a session id, a pane id, "." for this session, or ".tab" for every
other live session on this pane's tab.

The brief carries the last prompt, the last few replies, the working directory and
branch, the files recently touched, and anything cc-note is holding. It also names the
source transcript, so the new session can read the rest of the conversation rather than
work from a summary of it.

  cc-handover --new                      hand this session over, fresh pane to the right
  cc-handover d5-lca-48 --new --tab      the same for another session, on its own tab
  cc-handover --why 'context full' --new
  cc-handover .tab                       catch up on the rest of this tab, print only
  cc-handover .tab --new --window        the whole tab's work continuing in one session
USAGE
}

die() {
	echo "cc-handover: $*" >&2
	exit 1
}

clip() {
	local text=$1 n=${#1} tail_len
	if ((n <= CLIP_MAX)); then
		printf '%s' "$text"
		return
	fi
	tail_len=$((CLIP_MAX - CLIP_HEAD))
	printf '%s\n\n[... %s characters omitted, they are in the transcript ...]\n\n%s' \
		"${text:0:CLIP_HEAD}" "$((n - CLIP_MAX))" "${text:$((n - tail_len))}"
}

targets=()
action=print
split="--right"
to=""
in_pane=""
turns=3
why=""
dry=false
while (($#)); do
	case $1 in
	--new) action=new ;;
	--dry-run) dry=true ;;
	--save) action=save ;;
	--to) shift; to=${1:-}; action=to; [[ -n $to ]] || die "--to needs a pane" ;;
	--in) shift; in_pane=${1:-}; [[ $in_pane =~ ^[0-9]+$ ]] || die "--in needs a pane id" ;;
	--right | --left | --top | --bottom) split=$1 ;;
	--down) split="--bottom" ;;
	--up) split="--top" ;;
	--tab) split="tab" ;;
	--window) split="window" ;;
	--turns) shift; turns=${1:-3} ;;
	--why) shift; why=${1:-} ;;
	-h | --help) usage; exit 0 ;;
	-*) die "unknown option $1" ;;
	*) targets+=("$1") ;;
	esac
	shift
done
case $turns in '' | *[!0-9]*) die "--turns needs a number" ;; esac

# --- who ----------------------------------------------------------------------------

# One cc-roster call per target, which settles the address and gives the row at once.
# A session id or "." that is no longer live still hands over, from its transcript.
row_for() {
	local t=$1 row
	if [[ -z $t || $t == . ]]; then
		[[ -n ${CLAUDE_CODE_SESSION_ID:-} ]] ||
			die "no target given and CLAUDE_CODE_SESSION_ID is unset"
		t=$CLAUDE_CODE_SESSION_ID
	fi
	row=$(cc-roster --row "$t")
	if [[ -z $row ]]; then
		case $t in
		????????-????-????-????-????????????)
			printf -v row '%s\t%s\t\t\t-\t%s' "$t" "$t" "$PWD"
			;;
		*) die "no live session called \"$t\" (try: cc-roster)" ;;
		esac
	fi
	printf '%s' "$row"
}

# ".tab": every other live session on this pane's tab, in wezterm's order for the tab.
tab_siblings() {
	local tab panes out
	[[ -n ${WEZTERM_PANE:-} ]] || die ".tab needs WEZTERM_PANE; run it from a wezterm pane"
	panes=$(wezterm cli list --format json 2>/dev/null |
		jq -r --argjson me "${WEZTERM_PANE}" '
			(map(select(.pane_id == $me)) | first | .tab_id) as $t
			| .[] | select(.tab_id == $t and .pane_id != $me) | .pane_id')
	[[ -n $panes ]] || die ".tab: pane $WEZTERM_PANE is the only pane on its tab"
	# awk -v cannot carry a newline.
	panes=${panes//$'\n'/,}
	out=$(cc-roster 2>/dev/null | awk -F'\t' -v list="$panes" '
		BEGIN { n = split(list, want, ",") }
		{ nm[$5] = $2 }
		END {
			for (i = 1; i <= n; i++)
				if (want[i] != "" && want[i] in nm) print nm[want[i]]
		}')
	[[ -n $out ]] || die ".tab: no other live sessions on this tab"
	printf '%s\n' "$out"
}

# One session's section of the brief, from its roster row. LEAD_* is the first target:
# the new pane opens beside it and takes its directory.
LEAD_CWD=""
LEAD_PANE=""
LEAD_NAME=""

render_session() {
	local sid name cwd pane transcript title last_prompt last_prompt_at queued
	local replies files branch dirty note tailfile outputs

	IFS=$'\x1f' read -r sid name cwd pane < <(
		printf '%s\n' "$1" | awk -F'\t' '{ printf "%s\x1f%s\x1f%s\x1f%s", $1, $2, $6, $5 }'
	)
	: "${name:=$sid}" "${cwd:=$PWD}" "${pane:=-}"
	if [[ -z $LEAD_CWD ]]; then
		LEAD_CWD=$cwd
		LEAD_PANE=$pane
		LEAD_NAME=$name
	fi

	transcript="$HOME/.claude/projects/${cwd//[^A-Za-z0-9]/-}/$sid.jsonl"
	[[ -r $transcript ]] ||
		transcript=$(ls -t "$HOME"/.claude/projects/*/"$sid.jsonl" 2>/dev/null | head -1)
	[[ -r $transcript ]] || die "no transcript for $name ($sid)"

	tailfile=$(mktemp) || exit 1
	tail -c "$TAIL_BYTES" "$transcript" | tail -n +2 >"$tailfile"

	title=$(awk '/"type":"custom-title"/ { c = $0 } /"type":"ai-title"/ { a = $0 }
		END { if (c != "") print c; else if (a != "") print a }' "$tailfile" |
		jq -r '.customTitle // .aiTitle // empty' 2>/dev/null)

	# The real user turn, not the "last-prompt" record, which arrives truncated. From the
	# whole transcript: a long turn pushes its prompt well past the tail.
	grep '"type":"user"' "$transcript" 2>/dev/null | tail -400 >"$tailfile.users"
	last_prompt=$(jq -r 'select((.isMeta // false) | not)
		| .message.content
		| if type == "string" then . elif type == "array" then
			([ .[] | select(.type == "text") | .text ] | join("")) else empty end
		| select(type == "string") | select(startswith("<") | not) | select(length > 0)
		' "$tailfile.users" 2>/dev/null | tail -1)
	last_prompt_at=$(jq -r 'select((.isMeta // false) | not)
		| select(.message.content | if type == "string" then (startswith("<") | not)
			elif type == "array" then ([ .[] | select(.type == "text") ] | length) > 0
			else false end)
		| .timestamp // empty' "$tailfile.users" 2>/dev/null | tail -1)
	[[ -n $last_prompt ]] || last_prompt=$(grep '"type":"last-prompt"' "$tailfile" |
		tail -1 | jq -r '.lastPrompt // empty' 2>/dev/null)

	# Typed mid-turn lands as a queue-operation, not a user turn, and is usually the steer
	# that changed the work. Your words are kept as yours; another agent's are attributed,
	# since a peer handover read as your instruction misstates who decided; anything else
	# opening with "<" (task notifications) is dropped.
	queued=$(grep '"type":"queue-operation"' "$transcript" 2>/dev/null | tail -100 |
		jq -r --arg since "$last_prompt_at" \
			--argjson max "$CLIP_MAX" --argjson head "$CLIP_HEAD" '
			# Rendered in jq: a shell read would split a many-line message.
			def clip: if (length <= $max) then .
				else .[0:$head]
					+ "\n\n[... " + ((length - $max) | tostring)
					+ " characters omitted, they are in the transcript ...]\n\n"
					+ .[(length - ($max - $head)):] end;
			def quote: split("\n") | map("> " + .) | join("\n");
			select(.operation == "enqueue")
			| select((.content // "") != "")
			| select($since == "" or (.timestamp // "") > $since)
			| .content
			| if startswith("<cross-session-message") then
				((capture("from-name=\"(?<who>[^\"]+)\"") // {who: "another session"}).who) as $who
				| (split(">") | .[1:] | join(">")
				   | sub("</cross-session-message>"; "") | sub("^\\s+"; "")
				   | sub("\\s+$"; "")) as $body
				| select($body != "")
				| "_from \($who):_\n\n" + ($body | clip | quote) + "\n"
			  elif startswith("<") then empty
			  else (clip | quote) + "\n" end' 2>/dev/null | awk '!seen[$0]++')

	replies=$(jq -r --argjson min "$TRIVIAL_TEXT" 'select(.type == "assistant")
		| [ .message.content[]? | select(.type == "text") | .text ] | join("")
		| select(length > $min) | tojson' "$tailfile" 2>/dev/null | tail -n "$turns" |
		jq -rs 'join("\n\n---\n\n")' 2>/dev/null)

	files=$(jq -r 'select(.type == "assistant") | .message.content[]?
		| select(.type == "tool_use")
		| select(.name == "Edit" or .name == "Write" or .name == "NotebookEdit")
		| .input.file_path // .input.notebook_path // empty' "$tailfile" 2>/dev/null |
		awk '{ at[$0] = NR } END { for (f in at) print at[f] "\t" f }' |
		sort -n | tail -12 | cut -f2-)

	branch=""
	dirty=""
	if [[ -d $cwd ]]; then
		branch=$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null)
		# no optional locks: a session committing in that repo must not hit index.lock
		[[ -n $branch ]] && dirty=$(git --no-optional-locks -C "$cwd" status --porcelain \
			2>/dev/null | wc -l | tr -d ' ')
	fi

	note=$(cc-note show --for "$sid" --bare 2>/dev/null)
	outputs=$(task_outputs "$transcript")
	cache_note "$sid"
	[[ -n $CACHE_NOTE ]] && printf '%s: %s\n' "$name" "$CACHE_NOTE" >&2

	{
		printf '## From %s' "$name"
		[[ -n $title ]] && printf ' - %s' "$title"
		printf '\n\n'
		printf '`%s`' "$cwd"
		[[ -n $branch ]] && printf '  ·  branch `%s`' "$branch"
		[[ -n $dirty && $dirty != 0 ]] && printf ' (%s uncommitted)' "$dirty"
		printf '\n\n'
		[[ -n $note ]] && printf '**Tracking**\n\n```\n%s\n```\n\n' "$note"
		[[ -n $last_prompt ]] && printf '**Last asked**\n\n%s\n\n' "$(clip "$last_prompt")"
		if [[ -n $queued ]]; then
			printf '**Then, mid-turn**\n\n%s\n\n' "$queued"
		fi
		[[ -n $replies ]] && printf '**Where it got to**\n\n%s\n\n' "$replies"
		if [[ -n $files ]]; then
			printf '**Files it edited**\n\n'
			printf '%s\n' "$files" | sed 's/^/- `/; s/$/`/'
			printf '\n'
		fi
		printf '**Its transcript** (read this rather than guessing)\n\n    %s\n\n' "$transcript"
		if [[ -n $outputs ]]; then
			printf '**What its background tasks wrote** '
			printf '(a subagent'"'"'s is its JSONL transcript: tail it)\n\n'
			printf '%s\n' "$outputs" |
				awk -F'\t' '{ printf "- `%s` (%d KB)\n", $1, ($2 + 1023) / 1024 }'
			printf '\n'
		fi
		if [[ $pane != "-" ]]; then
			printf 'Its pane is still open: `wz read %s -n 200` gives the scrollback.\n\n' "$pane"
		fi
		# Never point a successor at resuming a cold session: that re-reads it all
		if [[ $CACHE_WARM == warm ]]; then
			printf 'Reopen it with `claude --resume %s` (%s).\n\n' "$sid" "$CACHE_NOTE"
		elif [[ $CACHE_WARM == cold ]]; then
			printf 'Do not resume it: its prompt cache is cold%s. This brief replaces that.\n\n' \
				"${CACHE_COST:+ and a resume would re-read $CACHE_COST}"
		else
			printf 'This brief replaces resuming it.\n\n'
		fi
	} >>"$file"

	rm -f "$tailfile" "$tailfile.users"
}

# Whether resuming a session would hit its prompt cache. A cold one is never woken or
# resumed: a fresh session reading its transcript costs a brief, a resume re-reads the
# whole context. The statusLine records the expiry and recache price (fields 4 and 6 of
# cache/context/<sid>); without them the last reply plus PROMPT_CACHE_TTL. Sets CACHE_WARM
# (warm, cold or empty for unknown), CACHE_COST ("~40k tokens" or empty) and CACHE_NOTE.
cache_note() {
	local sid=$1 now expires recache pct window at left
	CACHE_NOTE=""
	CACHE_WARM=""
	CACHE_COST=""
	now=$(date +%s)
	IFS=$'\x1f' read -r pct window expires recache < <(awk -F'\t' 'NR == 1 {
		printf "%s\x1f%s\x1f%s\x1f%s", $1, $2, $4, $6 }' "$CTX_DIR/$sid" 2>/dev/null)
	case ${expires:-} in '' | - | *[!0-9]*) expires="" ;; esac
	if [[ -z $expires ]]; then
		at=$(jq -r --arg s "$sid" 'select(.sessionId == $s)
			| ((.statusUpdatedAt // .updatedAt // 0) / 1000 | floor)' \
			"$HOME"/.claude/sessions/*.json 2>/dev/null | head -1)
		[[ $at =~ ^[0-9]+$ ]] && ((at > 0)) && expires=$((at + PROMPT_CACHE_TTL))
	fi
	case ${recache:-} in '' | - | *[!0-9]*) recache="" ;; esac
	if [[ -z $recache && ${pct:-} =~ ^[0-9]+$ && ${window:-} =~ ^[0-9]+$ ]]; then
		recache=$((pct * window / 100))
	fi
	[[ -n $recache ]] && CACHE_COST="~$(((recache + 500) / 1000))k tokens"
	if [[ -n $expires ]] && ((expires > now)); then
		CACHE_WARM=warm
		left=$(((expires - now + 59) / 60))
		CACHE_NOTE="prompt cache warm for ${left}m more: resuming is cheap"
	elif [[ -n $expires ]]; then
		CACHE_WARM=cold
		CACHE_NOTE="prompt cache cold since $(date -r "$expires" '+%a %H:%M' 2>/dev/null ||
			date -d "@$expires" '+%a %H:%M')"
		CACHE_NOTE+="${CACHE_COST:+: a resume would re-read $CACHE_COST}; hand over instead"
	elif [[ -n $CACHE_COST ]]; then
		CACHE_NOTE="cache state unknown; a cold resume re-reads $CACHE_COST"
	fi
	return 0
}

# Output a background task of the session wrote to disk, newest last: the paths its tool
# results name (`<tmp>/tasks/<id>.output`) that still exist. Whole transcript, since a task
# can be started long before the tail.
task_outputs() {
	local transcript=$1 f size
	grep -o '/[^" ]*/tasks/[A-Za-z0-9_-]*\.output' "$transcript" 2>/dev/null |
		awk '!seen[$0]++' | tail -8 | while IFS= read -r f; do
		[[ -f $f ]] || continue
		size=$(wc -c <"$f" | tr -d ' ')
		printf '%s\t%s\n' "$f" "$size"
	done
}

# --- the brief ------------------------------------------------------------------------

((${#targets[@]})) || targets=(.)

# Expanded first, so the section count is real. Command substitution, not process
# substitution: die in the latter would leave an empty target list.
gather=false
if [[ " ${targets[*]} " == *" .tab "* ]]; then
	gather=true
	sibs=$(tab_siblings) || exit 1
	expanded=()
	for t in "${targets[@]}"; do
		if [[ $t == .tab ]]; then
			while IFS= read -r nm; do
				[[ -n $nm ]] && expanded+=("$nm")
			done <<<"$sibs"
		else
			expanded+=("$t")
		fi
	done
	targets=("${expanded[@]}")
fi

rows=()
for t in "${targets[@]}"; do
	row=$(row_for "$t") || exit 1
	rows+=("$row")
done
((${#rows[@]} > 1)) && gather=true

# The sources, minus the receiver, for ccx
write_gathered() {
	local receiver=$1 row
	mkdir -p "$GATHERED" 2>/dev/null
	for row in "${rows[@]}"; do
		printf '%s\n' "$row"
	done | awk -F'\t' -v r="$receiver" '$5 != r && $5 != "-" && $5 != "" {
		print $5 "\t" $1 "\t" $2 }' >"$GATHERED/$receiver"
}

# Detached: once the receiver is busy on the brief, type PREFILL into its prompt as keys,
# so the leading ! switches it to bash mode. Gives up silently
prefill_later() {
	local receiver=$1
	(
		for ((i = 0; i < PREFILL_TRIES; i++)); do
			if cc-roster 2>/dev/null |
				awk -F'\t' -v p="$receiver" '$5 == p && $3 == "busy" { f = 1 } END { exit !f }'
			then
				wezterm cli send-text --no-paste --pane-id "$receiver" -- "$PREFILL"
				exit 0
			fi
			sleep "$PREFILL_POLL"
		done
	) </dev/null >/dev/null 2>&1 &
	disown 2>/dev/null
}

# --to: settle the target before writing anything. Pasting wakes it, and an idle one gone
# cold pays its whole context to read the brief
if [[ $action == to ]]; then
	pane_to=$to
	case $to in
	*[!0-9]*) pane_to=$(cc-roster --pane "$to") ;;
	esac
	[[ -n $pane_to && $pane_to != "-" ]] || die "--to: no pane for \"$to\""
	to_row=$(cc-roster 2>/dev/null | awk -F'\t' -v p="$pane_to" '$5 == p { print; exit }')
	if [[ -n $to_row ]]; then
		to_sid=$(printf '%s' "$to_row" | cut -f1)
		to_status=$(printf '%s' "$to_row" | cut -f3)
		cache_note "$to_sid"
		if [[ $to_status == idle && $CACHE_WARM == cold ]]; then
			die "--to: pane $pane_to is idle with a cold prompt cache${CACHE_COST:+ \
($CACHE_COST to wake)}; use --new for a fresh session"
		fi
	fi
fi

mkdir -p "$OUT" 2>/dev/null
stamp=$(date '+%Y%m%d-%H%M%S')
first_name=$(printf '%s\n' "${rows[0]}" | cut -f2)
file="$OUT/$first_name-$stamp.md"
[[ -e $file ]] && file="$OUT/$first_name-$stamp-$$.md"
: >"$file"

{
	if ((${#targets[@]} > 1)); then
		printf '# Handover from %s sessions\n\n' "${#targets[@]}"
	else
		printf '# Handover\n\n'
	fi
	printf 'You are picking this work up fresh. '
	if [[ -n $why ]]; then
		printf 'It was handed over: %s.\n\n' "$why"
	else
		printf 'It was handed over.\n\n'
	fi
	if ((${#targets[@]} > 1)); then
		printf 'Two or more sessions were working on this and their work continues here as '
		printf 'one. Each section below is one of them.\n\n'
	fi
} >>"$file"

for row in "${rows[@]}"; do
	render_session "$row"
done

printf 'This brief is saved at `%s`.\n' "$file" >>"$file"

cwd=$LEAD_CWD
pane=$LEAD_PANE
name=$LEAD_NAME

# --- doing something with it ----------------------------------------------------------

brief=$(<"$file")
if ((${#brief} > INLINE_MAX)); then
	brief="Read $file and continue that work. It is a handover brief from a session
that ran out of room; it names the source transcript if you need more than it carries."
fi

case $action in
save)
	printf '%s\n' "$file"
	;;
print)
	printf '%s\n' "$(<"$file")"
	;;
to)
	wezterm cli send-text --pane-id "$pane_to" -- "$brief"
	if $gather; then
		# chosen as the receiver on purpose, so sent: the prefill needs an empty prompt
		sleep 0.3
		wezterm cli send-text --no-paste --pane-id "$pane_to" -- $'\r'
		write_gathered "$pane_to"
		prefill_later "$pane_to"
		echo "gathered ${#rows[@]} sessions into pane $pane_to; $PREFILL there closes them"
	else
		echo "handover pasted into pane $pane_to (press enter there to send it)"
	fi
	;;
new)
	[[ $pane != "-" || $split == window ]] ||
		die "$name has no pane to split from; use --window"
	# cc-spawn clears the inherited Claude environment. It must get --tab, not tab: its
	# parser takes the first bare word as the start of the prompt.
	spawn_where=$split
	case $split in tab | window) spawn_where="--$split" ;; esac
	spawn=(cc-spawn --cwd "$cwd" "$spawn_where")
	[[ $pane != "-" ]] && spawn=(cc-spawn --cwd "$cwd" --from "$pane" "$spawn_where")
	# --in: split from a pane elsewhere, so the new session lands in that pane's tab
	[[ -n $in_pane ]] && spawn=(cc-spawn --cwd "$cwd" --from "$in_pane" "$spawn_where")
	$dry && spawn+=(--dry-run)
	new=$("${spawn[@]}" -- "$brief") || exit 1
	if $dry; then
		printf '%s\n' "$new"
		printf 'brief: %s\n' "$file"
		exit 0
	fi
	[[ -n $new ]] || die "could not open a pane for the handover"
	if $gather; then
		write_gathered "$new"
		prefill_later "$new"
		echo "gathered ${#rows[@]} sessions into pane $new; $PREFILL is typed there to close them"
	else
		echo "handed $name over to pane $new"
	fi
	echo "brief: $file"
	;;
esac
