#!/bin/bash
# What a session says about itself, which is the one thing nothing else here can hold.
#
# Every other surface is derived: the registry is Claude's, the hook files are Claude's,
# the transcript is Claude's. None of them can carry "waiting on the DNS change", "step 3
# of 7", or "do not interrupt me". So this is the writable layer, and the four readers
# that already draw a session - the statusLine, cc-fleet, cc-board and the tab bar - draw
# from it.
#
# Keyed by session id, not by pane: a note follows the conversation through a pane move,
# a --resume and a reboot, and /clear mints a new id, which is exactly when a note should
# stop applying.
#
# CLAUDE_CODE_SESSION_ID is set inside every Claude session's shell, so a session
# annotating itself costs no lookup at all. --for takes a name, a session id or a pane.

set -u

readonly FLEET="$HOME/.claude/fleet"
readonly NOTES="$FLEET/notes.tsv"
readonly LOGDIR="$FLEET/log"
readonly LOCK="$FLEET/.lock"
# Past this the file is swept of sessions that have ended. Sweeping costs a cc-roster,
# so it is not worth doing on a write that is already the common case.
readonly SWEEP_AT=200
readonly LOG_KEEP=200

usage() {
	cat <<'USAGE'
cc-note - what a session says about itself

  cc-note                          this session's note
  cc-note show [--for T]           one session's note, in full
  cc-note list [--json]            every session that has one
  cc-note clear [--for T]          drop the note and its log

  cc-note status <text>            one line: what it is doing, or waiting on
  cc-note status --clear
  cc-note needs <text>             it needs you to do something. Shows on its own line,
                                   on cc-fleet --brief, and nowhere noisy
  cc-note needs --now <text>       the same, and raise a notification now
  cc-note needs --clear
  cc-note progress <done> <total>  3 of 7; --clear to drop it
  cc-note mute | unmute            stop it competing for attention when it stops
  cc-note log <text>               append a line worth keeping
  cc-note log --tail [n]

--for takes a session name, a session id, or a wezterm pane id. Without it every verb
acts on the calling session, which is free: no lookup, no roster.

  cc-note needs --now 'log in to the DigitalFive dashboard'
  cc-note status 'waiting on the staging deploy'
  cc-note progress 3 7
  cc-note status --for d5-lca-48 'blocked on the DNS change'
  cc-note list --json
USAGE
}

die() {
	echo "cc-note: $*" >&2
	exit 1
}

# A name or a pane resolves through cc-roster; a session id is already the key. Left
# empty, the answer is the calling session, which needs nothing.
resolve_sid() {
	local target=${1:-}
	if [[ -z $target || $target == . ]]; then
		[[ -n ${CLAUDE_CODE_SESSION_ID:-} ]] ||
			die "no --for given and CLAUDE_CODE_SESSION_ID is unset"
		printf '%s' "$CLAUDE_CODE_SESSION_ID"
		return
	fi
	# A session id is 36 characters with dashes in the uuid places. Cheaper to spot
	# than to look up, and it is what the store is keyed by anyway.
	case $target in
	????????-????-????-????-????????????) printf '%s' "$target"; return ;;
	esac
	local sid
	case $target in
	*[!0-9]*) sid=$(cc-roster 2>/dev/null | awk -F'\t' -v n="$target" '$2 == n { print $1; exit }') ;;
	*) sid=$(cc-roster 2>/dev/null | awk -F'\t' -v p="$target" '$5 == p { print $1; exit }') ;;
	esac
	[[ -n $sid ]] || die "no live session called \"$target\" (try: cc-roster)"
	printf '%s' "$sid"
}

# mkdir is the atomic primitive that exists everywhere; there is no flock on macOS.
# A lock older than a minute belonged to something that died holding it.
take_lock() {
	local waited=0
	while ! mkdir "$LOCK" 2>/dev/null; do
		if [[ -d $LOCK ]] &&
			(($(stat -f %m "$LOCK" 2>/dev/null || echo 0) < $(date +%s) - 60)); then
			rmdir "$LOCK" 2>/dev/null
			continue
		fi
		((waited++ > 50)) && die "could not take the lock"
		sleep 0.1
	done
	trap 'rmdir "$LOCK" 2>/dev/null' EXIT INT TERM
}

# Fields are tabs, so nothing written into one may contain a tab or a newline. Empty
# reads better as "-" than as a folded column, and every reader here understands it.
clean() {
	printf '%s' "$1" | tr '\t\n' '  ' | sed -e 's/  */ /g' -e 's/^ //' -e 's/ $//'
}

read_row() {
	local sid=$1
	[[ -r $NOTES ]] || return 1
	awk -F'\t' -v s="$sid" '$1 == s { print; found = 1; exit } END { exit !found }' "$NOTES"
}

# Replace this session's row and leave every other one alone. Written to a temp file
# and moved into place: a half-written notes file is read as a truncated fleet.
write_row() {
	local sid=$1 flags=$2 progress=$3 status=$4 now
	now=$(date +%s)
	mkdir -p "$FLEET" 2>/dev/null
	take_lock
	local keep=""
	if [[ -r $NOTES ]]; then
		keep=$(awk -F'\t' -v s="$sid" '$1 != s' "$NOTES")
	fi
	{
		[[ -n $keep ]] && printf '%s\n' "$keep"
		# A row with nothing on it is not a row. Dropping it here is what --clear and
		# every "--clear" flag actually do.
		if [[ $flags != "-" || $progress != "-" || $status != "-" ]]; then
			printf '%s\t%s\t%s\t%s\t%s\n' "$sid" "$now" "$flags" "$progress" "$status"
		fi
	} >"$NOTES.$$" && mv -f "$NOTES.$$" "$NOTES"
	rmdir "$LOCK" 2>/dev/null
	trap - EXIT INT TERM
	sweep
}

# Sessions end and their notes do not. Swept only past SWEEP_AT rows, because the sweep
# needs a roster and a roster is 90ms against the microsecond the write itself costs.
sweep() {
	[[ -r $NOTES ]] || return 0
	local n
	n=$(wc -l <"$NOTES" 2>/dev/null || echo 0)
	((n > SWEEP_AT)) || return 0
	local live
	live=$(cc-roster 2>/dev/null | cut -f1)
	[[ -n $live ]] || return 0
	take_lock
	awk -F'\t' 'NR == FNR { live[$1] = 1; next } $1 in live' \
		<(printf '%s\n' "$live") "$NOTES" >"$NOTES.$$" && mv -f "$NOTES.$$" "$NOTES"
	rmdir "$LOCK" 2>/dev/null
	trap - EXIT INT TERM
}

# The current row, or the empty one, so every setter is a read-modify-write of five
# fields rather than five separate stores.
load() {
	local sid=$1 row
	F_FLAGS="-"; F_PROGRESS="-"; F_STATUS="-"; F_AT=0
	row=$(read_row "$sid") || return 0
	IFS=$'\t' read -r _ F_AT F_FLAGS F_PROGRESS F_STATUS <<<"$row"
	: "${F_FLAGS:=-}" "${F_PROGRESS:=-}" "${F_STATUS:=-}" "${F_AT:=0}"
}

has_flag() {
	case ",$1," in *,"$2",*) return 0 ;; esac
	return 1
}

add_flag() {
	has_flag "$1" "$2" && { printf '%s' "$1"; return; }
	[[ $1 == "-" ]] && { printf '%s' "$2"; return; }
	printf '%s,%s' "$1" "$2"
}

drop_flag() {
	local out
	out=$(printf '%s' "$1" | tr ',' '\n' | grep -v "^$2\$" | paste -sd, -)
	printf '%s' "${out:--}"
}

# --- the log ----------------------------------------------------------------------
#
# Not in notes.tsv: that file is read in full by three surfaces on a timer and a log
# grows without bound. Read only when something asks for it.
#
# There was a todo store here too, matched off cmux. Claude Code has its own todo list
# and nothing ever wrote to this one, so it was carrying documentation weight in the
# skill and nothing else.

log_file() { printf '%s/%s' "$LOGDIR" "$1"; }

cmd_log() {
	local sid=$1
	shift
	local file
	file=$(log_file "$sid")
	if [[ ${1:-} == --tail ]]; then
		local n=${2:-20}
		[[ -r $file ]] || return 0
		tail -n "$n" "$file"
		return
	fi
	(($#)) || die "log: need something to say"
	mkdir -p "$LOGDIR" 2>/dev/null
	printf '%s\t%s\n' "$(date '+%Y-%m-%d %H:%M')" "$(clean "$*")" >>"$file"
	# Bounded, and trimmed rarely: a rewrite races nothing here but costs a fork.
	local n
	n=$(wc -l <"$file" 2>/dev/null || echo 0)
	if ((n > LOG_KEEP * 2)); then
		tail -n "$LOG_KEEP" "$file" >"$file.$$" && mv -f "$file.$$" "$file"
	fi
}

# --- showing ----------------------------------------------------------------------

readonly DIM=$'\033[38;2;108;112;134m'
readonly RESET=$'\033[0m'

# "done" is a bash reserved word, so it cannot be a variable name. And the block glyph
# has to be braced off the expansion: bash 3.2 in a UTF-8 locale reads "$out█" as one
# identifier and dies under set -u.
bar() {
	local have=$1 total=$2 width=12 filled=0 i out=""
	((total > 0)) || { printf ''; return; }
	filled=$((have * width / total))
	((filled > width)) && filled=$width
	for ((i = 0; i < width; i++)); do
		if ((i < filled)); then out="${out}█"; else out="${out}░"; fi
	done
	printf '%s' "$out"
}

cmd_show() {
	local sid=$1 name
	load "$sid"
	name=$(cc-roster 2>/dev/null | awk -F'\t' -v s="$sid" '$1 == s { print $2; exit }')
	printf '%s%s%s\n' "${DIM}" "${name:-$sid}" "$RESET"
	[[ $F_STATUS != "-" ]] && printf '  status    %s\n' "$F_STATUS"
	if [[ $F_PROGRESS != "-" ]]; then
		printf '  progress  %s %s\n' "$(bar "${F_PROGRESS%%/*}" "${F_PROGRESS##*/}")" "$F_PROGRESS"
	fi
	[[ $F_FLAGS != "-" ]] && printf '  flags     %s\n' "$F_FLAGS"
	local logs
	logs=$(cmd_log "$sid" --tail 5)
	[[ -n $logs ]] && printf '  log\n%s\n' "$(printf '%s\n' "$logs" | sed 's/^/    /')"
	return 0
}

cmd_list() {
	local json=${1:-false}
	[[ -r $NOTES ]] || { $json && echo '[]'; return 0; }
	if $json; then
		# Joined against the roster so a reader gets the name it addresses by, not
		# just the id the store is keyed on.
		awk -F'\t' 'NR == FNR { name[$1] = $2; next }
			{ print $0 "\t" (($1 in name) ? name[$1] : "") }' \
			<(cc-roster 2>/dev/null) "$NOTES" |
			jq -R -s 'split("\n") | map(select(length > 0) | split("\t"))
				| map({ id: .[0], updated_at: (.[1] | tonumber?),
				        flags: (if .[2] == "-" then [] else (.[2] | split(",")) end),
				        progress: (if .[3] == "-" then null else .[3] end),
				        status: (if .[4] == "-" then null else .[4] end),
				        name: (if (.[5] // "") == "" then null else .[5] end) })'
		return 0
	fi
	awk -F'\t' 'NR == FNR { name[$1] = $2; next }
		{ printf "%-18s %-8s %-6s %s\n", (($1 in name) ? name[$1] : substr($1, 1, 8)),
		         ($3 == "-" ? "" : $3), ($4 == "-" ? "" : $4), ($5 == "-" ? "" : $5) }' \
		<(cc-roster 2>/dev/null) "$NOTES"
}

# --- dispatch ---------------------------------------------------------------------

verb=${1:-show}
case $verb in
-h | --help) usage; exit 0 ;;
esac
(($#)) && shift

# --for may sit anywhere after the verb, so it is pulled out before the verb reads
# what is left. Everything else stays in order.
target=""
args=()
while (($#)); do
	case $1 in
	--for) shift; target=${1:-}; [[ -n $target ]] || die "--for needs a session" ;;
	*) args+=("$1") ;;
	esac
	shift
done
set -- ${args[@]+"${args[@]}"}

case $verb in
list)
	json=false
	[[ ${1:-} == --json ]] && json=true
	cmd_list $json
	exit 0
	;;
esac

sid=$(resolve_sid "$target") || exit 1

case $verb in
show) cmd_show "$sid" ;;
status)
	load "$sid"
	if [[ ${1:-} == --clear ]]; then
		write_row "$sid" "$F_FLAGS" "$F_PROGRESS" "-"
	else
		(($#)) || die "status: need a line of text (or --clear)"
		write_row "$sid" "$F_FLAGS" "$F_PROGRESS" "$(clean "$*")"
	fi
	;;
progress)
	load "$sid"
	if [[ ${1:-} == --clear ]]; then
		write_row "$sid" "$F_FLAGS" "-" "$F_STATUS"
	else
		(($# >= 1)) || die "progress: need <done> <total>, or 3/7"
		local_done=${1%%/*}
		local_total=${2:-${1##*/}}
		case $local_done$local_total in *[!0-9]*) die "progress: numbers only" ;; esac
		((local_total > 0)) || die "progress: total must be more than zero"
		write_row "$sid" "$F_FLAGS" "$local_done/$local_total" "$F_STATUS"
	fi
	;;
mute | unmute)
	load "$sid"
	case $verb in
	mute) F_FLAGS=$(add_flag "$F_FLAGS" mute) ;;
	unmute) F_FLAGS=$(drop_flag "$F_FLAGS" mute) ;;
	esac
	write_row "$sid" "$F_FLAGS" "$F_PROGRESS" "$F_STATUS"
	;;
needs)
	# Two levels on purpose. A pane that wants something is nearly always content to
	# wait, and a notification for every one of those trains you to ignore them; the
	# quiet channel puts it on the pane's own statusLine and one line of
	# `cc-fleet --brief`, which is where you look anyway. --now is for the ones with a
	# clock on them: a login, an approval, a card to tap.
	load "$sid"
	notify=false
	[[ ${1:-} == --now ]] && { notify=true; shift; }
	if [[ ${1:-} == --clear ]]; then
		write_row "$sid" "$(drop_flag "$F_FLAGS" needs)" "$F_PROGRESS" "-"
		exit 0
	fi
	(($#)) || die "needs: say what you need (or --clear)"
	F_FLAGS=$(add_flag "$F_FLAGS" needs)
	write_row "$sid" "$F_FLAGS" "$F_PROGRESS" "$(clean "$*")"
	if $notify; then
		name=$(cc-roster 2>/dev/null | awk -F'\t' -v s="$sid" '$1 == s { print $2; exit }')
		wz notify "${name:-a session} needs you" "$(clean "$*")" 2>/dev/null ||
			echo "cc-note: could not raise a notification" >&2
	fi
	;;
log) cmd_log "$sid" "$@" ;;
clear)
	write_row "$sid" "-" "-" "-"
	rm -f "$(log_file "$sid")"
	;;
*) usage >&2; exit 2 ;;
esac
