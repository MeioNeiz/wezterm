#!/bin/bash
# Live Claude Code sessions, newest last: cc-roster plus a title per session, memoised
# against the transcript's mtime.

set -u
# file mtime: BSD stat on macOS; GNU elsewhere, where `stat -f` means the filesystem
if [[ $OSTYPE == darwin* ]]; then MTIME=(-f %m); else MTIME=(-c %Y); fi

readonly TITLE_CACHE="$HOME/.claude/cache/statusline"
readonly TITLE_MEMO="$HOME/.claude/cache/titles"
# A busy transcript moves every turn; without a floor it would rescan on every call.
readonly TITLE_TTL=60

usage() {
	cat <<'USAGE'
cc-peers - live Claude Code sessions on this machine

  cc-peers         aligned table: NAME, STATE, PANE, DIR, TITLE
  cc-peers --tsv   name, session id, state, pane, dir, title

NAME is the address SendMessage routes by: SendMessage({to: "<name>", message: "..."}).
Match a window by TITLE rather than asking which one is meant.

Names default to the cwd basename plus a random suffix, so panes in one repo all look
alike. /rename <name> in a pane sets a real one, bare /rename derives it from the
conversation, and either way it is unique among live sessions. Each pane's statusLine
ends with its own @name; in wezterm, LEADER+@ types another session's name at the
cursor and CTRL+SHIFT+SPACE lifts one off the screen.

cc-roster is this without the titles. Anything resolving an address wants that instead.
USAGE
}

tsv=false
case ${1:-} in
--tsv) tsv=true ;;
-h | --help)
	usage
	exit 0
	;;
"") ;;
*)
	usage >&2
	exit 2
	;;
esac

# Same priority and 256KB tail as the statusLine. Untitled falls back to the opening
# prompt, then to a peer handover's sender and first line (it lands as isMeta).
session_title() {
	local id=$1 transcript=$2 title=""
	if [[ -r $transcript ]]; then
		title=$(tail -c 262144 "$transcript" | awk '
			/"type":"custom-title"/ { custom = $0 }
			/"type":"ai-title"/     { ai = $0 }
			END { if (custom != "") print custom; else if (ai != "") print ai }
		' | jq -r '.customTitle // .aiTitle // empty' 2>/dev/null)
	fi
	[[ -z $title && -r $TITLE_CACHE/$id ]] && title=$(<"$TITLE_CACHE/$id")
	if [[ -z $title && -r $transcript ]]; then
		title=$(grep -m 60 '"type":"user"' "$transcript" | jq -r '
			select((.isMeta // false) | not)
			| .message.content
			| if type == "string" then .
			  elif type == "array" then [ .[] | select(.type == "text") | .text ] | join(" ")
			  else empty end
			| select(type == "string" and (startswith("<") | not))
			| gsub("\\s+"; " ")
		' 2>/dev/null | head -1 | cut -c1-60)
	fi
	# Splitting on ">" and rejoining survives a body containing one.
	if [[ -z $title && -r $transcript ]]; then
		title=$(grep -m 40 'cross-session-message from=' "$transcript" | jq -r '
			.message.content
			| select(type == "string")
			| (capture("from-name=\"(?<who>[^\"]+)\"") // {who: "peer"}).who as $who
			| (split(">") | .[1:] | join(">") | sub("^\\s+"; "") | split("\n")[0]
			   | gsub("\\s+"; " ")) as $body
			| select($body != "")
			| "\($who): \($body)"
		' 2>/dev/null | head -1 | cut -c1-60)
	fi
	printf '%s' "${title:-untitled}"
}

# Fork-free on a memo hit, which is the common case: TITLE is a global, not stdout.
# An untitled memo is never reused, or a new pane would look broken for a minute.
TITLE=""
cached_title() {
	local id=$1 dir=$2 now=$3
	local file transcript mtime cached_mtime cached_at cached_title
	file="$TITLE_MEMO/$id"
	transcript="$HOME/.claude/projects/${dir//[^A-Za-z0-9]/-}/$id.jsonl"

	if [[ -r $file ]]; then
		IFS=$'\x1f' read -r cached_mtime cached_at cached_title <"$file"
		if [[ -n ${cached_title:-} && $cached_title != untitled ]]; then
			if ((now - ${cached_at:-0} < TITLE_TTL)); then
				TITLE=$cached_title
				return
			fi
			if [[ -r $transcript ]]; then
				mtime=$(stat "${MTIME[@]}" "$transcript" 2>/dev/null || echo 0)
				if [[ ${cached_mtime:-0} == "$mtime" ]]; then
					printf '%s\x1f%s\x1f%s\n' "$mtime" "$now" "$cached_title" \
						>"$file" 2>/dev/null
					TITLE=$cached_title
					return
				fi
			fi
		fi
	fi

	# The registry cwd can differ from the one the transcript was filed under.
	[[ -r $transcript ]] ||
		transcript=$(ls -t "$HOME"/.claude/projects/*/"$id.jsonl" 2>/dev/null | head -1)
	mtime=$(stat "${MTIME[@]}" "$transcript" 2>/dev/null || echo 0)
	TITLE=$(session_title "$id" "$transcript")
	mkdir -p "$TITLE_MEMO" 2>/dev/null &&
		printf '%s\x1f%s\x1f%s\n' "$mtime" "$now" "$TITLE" >"$file" 2>/dev/null
}

now=$(date +%s)
rows=""
# Unit separator: tab is IFS whitespace, so read would fold an empty detail.
while IFS=$'\x1f' read -r sid name status detail pane cwd pid seen started; do
	[[ -n $sid ]] || continue
	state=$status
	[[ -n $detail ]] && state="$status $detail"
	cached_title "$sid" "$cwd" "$now"
	rows="$rows$name	$sid	$state	$pane	${cwd##*/}	$TITLE"$'\n'
done < <(cc-roster 2>/dev/null | tr '\t' '\037')

if [[ -z $rows ]]; then
	$tsv || echo "No live Claude sessions." >&2
	exit 0
fi

printf '%s' "$rows" |
	if $tsv; then
		cat
	else
		awk -F'\t' -v self="${CLAUDE_CODE_SESSION_ID:-}" '
			BEGIN { print "NAME\tSTATE\tPANE\tDIR\tTITLE" }
			{ mark = ($2 == self) ? " ←you" : ""
			  print $1 mark "\t" $3 "\t" $4 "\t" $5 "\t" $6 }
		' | column -t -s $'\t'
	fi
