#!/bin/bash
# Who is alive, what state, which pane. No titles: cc-peers adds those on top.
#
# Columns: sid, name, status, detail, pane, cwd, pid, seen_ms, started_ms
# pane is "-" when no wezterm pane holds the session; detail is empty unless blocked.

set -u
# The GUI runs these with PATH=/usr/bin:/bin:/usr/sbin:/sbin: no wezterm, no cc-*
PATH="$HOME/.claude/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

readonly REGISTRY="$HOME/.claude/sessions"
# Between former names inside one field: tab is taken and a name can hold a space.
readonly US=$'\x1f'
readonly PANE_MAP="$HOME/.claude/wezterm-sessions"
readonly PANE_STATE="$HOME/.claude/wezterm-state"
readonly DIGEST="$HOME/.claude/cache/fleet-digest"
# Nothing else ever deletes these. Per-session caches go a week after their session.
readonly REAP_STAMP="$HOME/.claude/cache/reap-stamp"
readonly REAP_EVERY=3600
readonly REAP_CACHES="$HOME/.claude/cache/titles $HOME/.claude/cache/context"
# file mtime: BSD stat on macOS; GNU elsewhere, where `stat -f` means the filesystem
if [[ $OSTYPE == darwin* ]]; then MTIME=(-f %m); else MTIME=(-c %Y); fi

usage() {
	cat <<'USAGE'
cc-roster - live Claude sessions, their state and their pane, without titles

  cc-roster            sid, name, status, detail, pane, cwd, pid, seen, started
  cc-roster --pane <target>  just the pane id holding <target>
  cc-roster --sid <target>   just the session id of <target>
  cc-roster --row <target>   the whole row for <target>
  cc-roster --name <pane>    just the session name in <pane>
  cc-roster --digest         write the registry half, keyed by pane, for ~/.wezterm.lua

A <target> is a session name, a name that session used to have, a pane id or a session
id. Names match the way Claude matches them - case-insensitively, with runs of spaces
folded to hyphens - so `bash-command-execution` reaches a session called "bash command
execution", and an address that has since been renamed still lands.

--digest writes ~/.claude/cache/fleet-digest and prints nothing:

  #<epoch>
  <pane>  <sid>  <status>  <waitingFor>  <seen_ms>

The hook states are left out: wezterm.lua reads those per pane already.
USAGE
}

mode=all
want=""
aliases=""
case ${1:-} in
--pane | --sid | --row | --name)
	mode=${1#--}
	want=${2:-}
	[[ -n $want ]] || { echo "cc-roster: $1 needs a target" >&2; exit 2; }
	;;
--digest) mode=digest ;;
-h | --help) usage; exit 0 ;;
"") ;;
*) usage >&2; exit 2 ;;
esac

# Former names ride as a tenth column only where they are resolved: cc-peers reads nine.
case $mode in
pane | sid | row) aliases=1 ;;
esac

# Mirrors Claude's resolver, which SendMessage uses too: names are keyed trimmed,
# lowercased, whitespace folded to hyphens, and a former name (only those from the
# conversation the session is still in; the jq cuts to those) resolves when nothing
# current does. A current name beats a former one; a former name two live sessions
# share resolves to neither, because picking one silently briefs the wrong pane.
match_name() {
	awk -F'\t' -v want="$1" -v out="$2" -v us="$US" '
	function norm(s) {
		gsub(/^[ \t]+|[ \t]+$/, "", s); s = tolower(s); gsub(/[ \t]+/, "-", s); return s
	}
	function pick() {
		if (out > 0) return $out
		return $1 "\t" $2 "\t" $3 "\t" $4 "\t" $5 "\t" $6 "\t" $7 "\t" $8 "\t" $9
	}
	BEGIN { w = norm(want) }
	{
		if (hit == "" && norm($2) == w) hit = pick()
		if ($10 == "") next
		n = split($10, a, us)
		for (i = 1; i <= n; i++)
			if (norm(a[i]) == w) { alias = pick(); who = $2; nalias++; break }
	}
	END {
		if (hit != "") { print hit; exit 0 }
		if (nalias == 1) {
			printf "cc-roster: \"%s\" is now \"%s\"\n", want, who > "/dev/stderr"
			print alias
			exit 0
		}
		if (nalias > 1)
			printf "cc-roster: \"%s\" is a former name of %d live sessions; say which\n", \
				want, nalias > "/dev/stderr"
		exit 1
	}'
}

# Pane and session ids cannot drift, so they match as themselves. out 0 is the row.
resolve() {
	local want=$1 out=$2
	local col=""
	case $want in
	*[!0-9]*) ;;
	*) col=5 ;;
	esac
	case $want in
	????????-????-????-????-????????????) col=1 ;;
	esac
	[[ -n $col ]] || { match_name "$want" "$out"; return; }
	awk -F'\t' -v v="$want" -v c="$col" -v out="$out" -v OFS='\t' '
		$c == v {
			if (out > 0) print $out
			else print $1, $2, $3, $4, $5, $6, $7, $8, $9
			found = 1; exit
		}
		END { if (!found) exit 1 }'
}

# waitingFor is what a "waiting" session is asking. The name is emitted as its key, so
# nothing downstream shows an address with a space in it.
registry=$(jq -r '
	def key: (. // "") | ascii_downcase
		| sub("^\\s+"; "") | sub("\\s+$"; "") | gsub("\\s+"; "-");
	. as $r
	| select(.pid and .sessionId and .name)
	| [ (.sessionId), (.name | key), (.status // "?"), (.waitingFor // ""),
	    (.cwd // ""), (.pid | tostring),
	    ((.statusUpdatedAt // .updatedAt // 0) | tostring),
	    ((.startedAt // 0) | tostring),
	    ([ (.formerNames // [])[]
	       | select(.sessionId == $r.sessionId) | .name | key ] | join("\u001f")) ]
	| @tsv' "$REGISTRY"/*.json 2>/dev/null)

[[ -n $registry ]] || exit 0

# A dead pid leaves its registry file behind. One ps joined in awk rather than kill -0
# in a bash loop, which cannot read tab-separated rows with an empty field.
work=$(mktemp -d) || exit 1
trap 'rm -rf "$work"' EXIT

ps -axo pid= | tr -d ' ' >"$work/pids"
printf '%s\n' "$registry" >"$work/registry"

# sid -> pane. A stale pane can still name a session that has moved, so newest file wins.
(cd "$PANE_MAP" 2>/dev/null && ls -t 2>/dev/null | tr '\n' '\0' |
	xargs -0 awk 'FNR == 1 { print $0 "\t" FILENAME }' 2>/dev/null) >"$work/panes"

case $mode in
all | row)
	(cd "$PANE_STATE" 2>/dev/null && ls 2>/dev/null | tr '\n' '\0' |
		xargs -0 awk 'FNR == 1 { print FILENAME "\t" $0 }' 2>/dev/null) >"$work/states"
	;;
*) : >"$work/states" ;;
esac

# A hook record wins while it is newer than the registry: nothing fires when a prompt
# is answered. An idle registry never overrules errored or parked, since idle is what
# both look like from outside. Hook stamps seconds, registry ms: +1 so a same-second
# hook wins the tie. parked reports as busy: the turn is over, its background work is not.
# The registry's shell (turn over, a background shell running) is level-triggered and
# passes through: it is the better word for what parked guesses at. asking is only ever
# honoured while newer, so an Esc on a dialog, which fires no Stop, cannot strand it.
awk -F'\t' -v OFS='\t' -v panefile="$work/panes" \
	-v statefile="$work/states" -v pidfile="$work/pids" -v aliases="$aliases" '
BEGIN {
	srand(); now = srand()
	while ((getline line < pidfile) > 0) alive[line + 0] = 1
	while ((getline line < panefile) > 0) {
		if (split(line, f, "\t") < 2) continue
		if (!(f[1] in pane)) pane[f[1]] = f[2]
	}
	while ((getline line < statefile) > 0) {
		n = split(line, f, "\t")
		if (n < 3) continue
		hook_state[f[1]] = f[2]; hook_at[f[1]] = f[3]; hook_detail[f[1]] = f[4]
		# parked has no writer when the background work ends, so it expires (CLAUDE.md):
		# the most each kind can live. Must match PARKED_* in wezterm.lua and cc-board.
		cap = (f[4] == "monitor") ? 1800 : (f[4] == "shell" ? 7200 : 14400)
		if (f[2] == "parked" && now - f[3] > cap)
			hook_state[f[1]] = "done"
		# No sid on records older than the stamp: trusted rather than dropped.
		hook_sid[f[1]] = (n >= 5) ? f[5] : ""
	}
}
{
	sid = $1; name = $2; status = $3; detail = $4; cwd = $5; pid = $6
	seen = $7; started = $8; former = $9
	if (!(pid + 0 in alive)) next
	pn = (sid in pane) ? pane[sid] : "-"
	if (pn != "-" && (pn in hook_state) && (hook_sid[pn] == "" || hook_sid[pn] == sid)) {
		hs = hook_state[pn]
		newer = (hook_at[pn] + 1) * 1000 > seen
		quiet = (status == "idle" || status == "shell")
		if ((hs == "asking" && newer) || (hs == "errored" && (newer || quiet))) {
			status = hs
			if (hook_detail[pn] != "") detail = hook_detail[pn]
		} else if (hs == "parked" && status != "shell" && (newer || status == "idle")) {
			status = "busy"
		}
	}
	if (aliases) print sid, name, status, detail, pn, cwd, pid, seen, started, former
	else print sid, name, status, detail, pn, cwd, pid, seen, started
}' "$work/registry" | sort -t$'\t' -k9,9n |
	case $mode in
	pane) resolve "$want" 5 ;;
	sid) resolve "$want" 1 ;;
	row) resolve "$want" 0 ;;
	name) awk -F'\t' -v p="$want" '$5 == p { print $2; found = 1; exit }
	      END { if (!found) exit 1 }' ;;
	digest)
		# Written whole then renamed, so the one-second Lua reader never sees half a file.
		mkdir -p "${DIGEST%/*}" 2>/dev/null
		{
			printf '#%s\n' "$(date +%s)"
			awk -F'\t' -v OFS='\t' '$5 != "-" { print $5, $1, $3, $4, $8 }'
		} >"$DIGEST.$$" && mv -f "$DIGEST.$$" "$DIGEST" || rm -f "$DIGEST.$$"
		;;
	*) cat ;;
	esac
rc=$?

# Hourly, from the digest: state and map files for panes wezterm no longer has, and the
# same for live panes still naming a session the registry has never heard of a day on
# (pane ids restart at 0 with the GUI, so an old pair can sit on a new pane). Per-session
# caches a week after the session is gone. Never the registry or notes.tsv.
reap() {
	local now at live f p sid k
	now=$(date +%s)
	if [[ -f $REAP_STAMP ]]; then
		at=$(stat "${MTIME[@]}" "$REAP_STAMP" 2>/dev/null || echo 0)
		((now - at < REAP_EVERY)) && return 0
	fi
	mkdir -p "${REAP_STAMP%/*}" 2>/dev/null
	touch "$REAP_STAMP"
	# No answer from wezterm is not "no panes": skip rather than reap the lot.
	live=$(wezterm cli list --format json 2>/dev/null | jq -r '.[].pane_id' 2>/dev/null)
	[[ -n $live ]] || return 0
	for p in $live; do printf -v "lp_$p" 1; done
	while IFS=$'\t' read -r sid _; do
		[[ -n $sid ]] && printf -v "rs_${sid//-/_}" 1
	done <"$work/registry"
	for f in "$PANE_STATE"/* "$PANE_MAP"/*; do
		p=${f##*/}
		[[ $p =~ ^[0-9]+$ ]] || continue
		k="lp_$p"
		if [[ -z ${!k:-} ]]; then
			rm -f "$PANE_STATE/$p" "$PANE_MAP/$p"
			continue
		fi
		[[ $f == "$PANE_MAP/$p" ]] || continue
		IFS= read -r sid <"$f" || continue
		k="rs_${sid//-/_}"
		[[ -n ${!k:-} || ! $sid =~ ^[0-9a-f-]+$ ]] && continue
		at=$(stat "${MTIME[@]}" "$f" 2>/dev/null || echo "$now")
		((now - at > 86400)) && rm -f "$PANE_STATE/$p" "$PANE_MAP/$p"
	done
	for f in $(find $REAP_CACHES -type f -mtime +7 2>/dev/null); do
		sid=${f##*/}
		k="rs_${sid//-/_}"
		[[ -n ${!k:-} ]] || rm -f "$f"
	done
	return 0
}

[[ $mode == digest ]] && reap
exit "$rc"
