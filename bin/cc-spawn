#!/bin/bash
# Start a Claude session in a new pane, with a task. Every launcher comes through here:
# a session spawned inside another inherits CLAUDE_CODE_CHILD_SESSION and saves no
# transcript (see docs/tools.md). Permissions are bypassed unless --ask.

set -u
wzcli() { "$HOME/.claude/bin/wzcli" "$@"; } # 5s deadline, --no-auto-start
# shellcheck source=/dev/null
source "$HOME/.claude/bin/cc-account" --lib

# Cleared, not filtered: the session a human would have started from a plain shell.
# TERM_PROGRAM=kitty as in the zsh alias: as WezTerm, claude wraps frames in synchronized
# updates and the mux freezes the pane on an unclosed one; FORCE_HYPERLINK keeps OSC 8 links
readonly CLEAN_ENV=(env
	-u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT -u CLAUDE_CODE_SESSION_ID
	-u CLAUDE_CODE_CHILD_SESSION -u CLAUDE_CODE_MESSAGING_SOCKET
	-u CLAUDE_CODE_MESSAGING_TOKEN -u CLAUDE_CODE_EXECPATH
	-u CLAUDE_PID -u CLAUDE_EFFORT -u AI_AGENT
	TERM_PROGRAM=kitty FORCE_HYPERLINK=1)
# Narrowest a Claude pane split beside another may be; wz's REFLOW_MIN is the same number
readonly MIN_COLS=90

usage() {
	cat <<'USAGE'
cc-spawn - start a Claude session in a new pane, with a task

  cc-spawn [options] <prompt...>
  cc-spawn [options] --fork <session> [prompt...]

  --cwd <dir>        where it runs (default: this pane's directory)
  --from <target>    the pane to split from (default: this one)
  --right | --left | --top | --bottom     split (default: right). A Claude split
                     --right or --left that would leave a pane under 90 columns opens a
                     new tab instead: four across on the big monitor, two on the laptop
  --squeeze          split anyway
  --tab | --window   a new tab right of this one, or a new window in this pane's
                     workspace (outside wezterm: --workspace, never "default")
  --workspace <name> a new tab in that workspace's window; a new window only when the
                     workspace has none, so it is made if it does not exist
  --shell            a plain shell rather than Claude, for a pane to watch things in
  --ask              leave permission prompts on (default: bypassed)
  --effort <level>   low | medium | high | xhigh | max (default: settings, xhigh). Pick it
                     from the brief: low for a lookup, a verifier or a standby, the
                     default for real work. Effort is per session, so this is the only
                     moment it can be chosen
  --model <model>    opus, sonnet, fable or a full id (default: settings)
  --account <name>   the claude.ai account it runs on (default: the one --cwd's folder
                     gets in ~/.claude/accounts; cc-account)
  --worktree[=<name>]  give the session its own git worktree, so it cannot collide with
                     whatever else is working in that repo. Claude Code makes it at
                     <repo>/.claude/worktrees/<name> on a branch of its own; a bare
                     --worktree lets it pick the name
  --fork <session>   a copy of a session, its whole conversation, in a new pane; the
                     source carries on untouched. Only for a warm one: forking a cold
                     session pays for its whole context again (cc-handover --fork checks)
  --resume <session> carry on that session itself, same id. Never while it is open
                     elsewhere: both would write one transcript (--replace closes it)
  --replace <pane>   start in that pane's place: split from it, close it, and start once
                     the claude in it has exited. How cc-account switch moves a session
  --print-sid        print the new session's id after the pane id, tab-separated
  --name <name>      the session's name (claude --name); Claude lets two live sessions
                     share one, and SendMessage then reaches whichever is listed first.
                     Default for a fresh session: <folder>-<2 hex> that none live holds
  --dry-run          print what it would run

Prints the new pane id. The session id is chosen here and passed as --session-id, so it
is known before the session has started. The environment is cleaned first, which is the
whole point: without it the new session inherits CLAUDE_CODE_CHILD_SESSION and saves no
transcript.

  cc-spawn --cwd ~/work/api 'read src/auth.ts and list every path that skips the guard'
  cc-spawn --tab --cwd ~/work/api 'run the failing test and tell me why it fails'
  cc-spawn --worktree=auth-guard 'fix the guard in src/auth.ts'

Worktrees are opt-in on purpose. Several sessions in one checkout is the normal way of
working here and mostly fine; it stops being fine when two of them edit at once, and
then nothing in the tree says which dirty file belongs to whom.
USAGE
}

die() {
	echo "cc-spawn: $*" >&2
	exit 1
}

cwd=""
from=""
where="--right"
shell=false
ask=false
dry=false
worktree=false
wtname=""
effort=""
model=""
fork=""
resume=""
replace=""
account=""
print_sid=false
name=""
workspace=""
squeeze=false
while (($#)); do
	case $1 in
	--cwd) shift; cwd=${1:-}; [[ -n $cwd ]] || die "--cwd needs a directory" ;;
	--from) shift; from=${1:-}; [[ -n $from ]] || die "--from needs a pane" ;;
	--right | --left | --top | --bottom) where=$1 ;;
	--down) where="--bottom" ;;
	--up) where="--top" ;;
	--tab) where="tab" ;;
	--window) where="window" ;;
	--workspace) shift; workspace=${1:-}; where="window"
		[[ -n $workspace ]] || die "--workspace needs a name" ;;
	--shell) shell=true ;;
	--ask) ask=true ;;
	--effort) shift; effort=${1:-}; [[ -n $effort ]] || die "--effort needs a level" ;;
	--model) shift; model=${1:-}; [[ -n $model ]] || die "--model needs a model" ;;
	--worktree) worktree=true ;;
	--worktree=*) worktree=true; wtname=${1#--worktree=} ;;
	--fork) shift; fork=${1:-}; [[ -n $fork ]] || die "--fork needs a session id" ;;
	--resume) shift; resume=${1:-}; [[ -n $resume ]] || die "--resume needs a session id" ;;
	--replace) shift; replace=${1:-}; [[ -n $replace ]] || die "--replace needs a pane" ;;
	--account) shift; account=${1:-}; [[ -n $account ]] || die "--account needs a name" ;;
	--print-sid) print_sid=true ;;
	--name) shift; name=${1:-}; [[ -n $name ]] || die "--name needs a name" ;;
	--squeeze) squeeze=true ;;
	--dry-run) dry=true ;;
	-h | --help) usage; exit 0 ;;
	--) shift; break ;;
	-*) die "unknown option $1" ;;
	*) break ;;
	esac
	shift
done

case $effort in
"" | low | medium | high | xhigh | max) ;;
*) die "--effort is low, medium, high, xhigh or max, not \"$effort\"" ;;
esac
$shell || [[ -n $fork$resume ]] || (($#)) || die "need a prompt (or --shell)"
[[ -n $fork && -n $resume ]] && die "--fork or --resume, not both"
[[ -n $resume ]] && $shell && die "--resume needs a Claude session, not --shell"
[[ -z $resume || $resume =~ ^[0-9a-f-]{36}$ ]] ||
	die "--resume needs a full session id, not \"$resume\""
$worktree && $shell && die "--worktree needs a Claude session, not --shell"
[[ -n $fork ]] && $shell && die "--fork needs a Claude session, not --shell"
[[ -z $fork || $fork =~ ^[0-9a-f-]{36}$ ]] ||
	die "--fork needs a full session id, not \"$fork\""

pane=""
# --replace splits from the pane it replaces
[[ -n $replace ]] && from=$replace
if [[ -n $from ]]; then
	case $from in
	*[!0-9]*) pane=$(cc-roster --pane "$from") ;;
	*) pane=$from ;;
	esac
	[[ -n $pane && $pane != "-" ]] || die "no pane for \"$from\""
else
	pane=${WEZTERM_PANE:-}
fi

split_x=false
case $where in
--right | --left) $shell || [[ -n $replace ]] || $squeeze || split_x=true ;;
esac
listing=""
if [[ -n $pane ]] && { [[ -z $cwd ]] || $split_x; }; then
	listing=$(wzcli list --format json 2>/dev/null)
fi

if [[ -z $cwd ]]; then
	if [[ -n $listing ]]; then
		cwd=$(jq -r --arg p "$pane" '.[] | select(.pane_id == ($p | tonumber))
			| .cwd // "" | sub("^file://[^/]*"; "")' <<<"$listing" 2>/dev/null | head -1)
	fi
	[[ -n $cwd ]] || cwd=$PWD
fi
[[ -d $cwd ]] || die "no such directory: $cwd"

# A split halves the pane, less a column for the divider. A floor in columns, not a share
# of the tab: the big monitor (429) fits four across, the laptop (211) two.
# Not for --replace: its split is closed again at once
if $split_x && [[ -n $listing ]]; then
	cols=$(jq -r --arg p "$pane" '.[] | select(.pane_id == ($p | tonumber)) | .size.cols' \
		<<<"$listing" 2>/dev/null)
	if [[ $cols =~ ^[0-9]+$ ]] && (((cols - 1) / 2 < MIN_COLS)); then
		echo "cc-spawn: a split of pane $pane ($cols columns) would leave under $MIN_COLS" \
			"each; a new tab instead (--squeeze splits anyway)" >&2
		where="tab"
	fi
fi

# Fail here rather than in a new pane nobody is watching.
if $worktree && ! git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1; then
	die "--worktree needs a git repo, and $cwd is not in one"
fi

# Explicit or by folder (its fallback while the folder's account is capped), always set: a
# session spawned from another inherits its CLAUDE_CONFIG_DIR, which is the other account's
# whenever the folders differ
acct_load
acct_env_args=()
if [[ -n $ACCT_NAMES ]]; then
	if [[ -z $account ]]; then
		acct_start "$cwd"
		account=$ACCT
	fi
	acct_env "$account" || die "no account \"$account\" in $ACCT_FILE"
	acct_env_args=("${ACCT_ENV[@]}")
elif [[ -n $account ]]; then
	die "--account: no accounts set up ($ACCT_FILE, cc-account --help)"
fi

prompt="$*"
sid=""
if [[ -n $resume ]]; then
	sid=$resume
else
	$shell || sid=$(uuidgen | tr 'A-F' 'a-f')
fi

# Claude derives <folder>-<2 hex> and its uniqueness check sits behind a flag, so with
# fifteen live sessions in one folder two shared a name (meiolol-57, 2026-10-29). A fresh
# session gets a free one of the same shape instead; a resume or fork keeps Claude's, and
# a worktree's folder is not known yet
if [[ -z $name && -z $resume && -z $fork ]] && ! $shell && ! $worktree; then
	base=${cwd##*/}
	base=$(printf '%s' "$base" | tr 'A-Z ' 'a-z-')
	taken=" $(cc-roster 2>/dev/null | cut -f2 | tr '\n' ' ') "
	for len in 2 3; do
		for hex in $(printf '%s' "$sid$len" | shasum -a 256 | fold -w "$len" | head -40); do
			[[ $taken == *" $base-$hex "* ]] || { name=$base-$hex; break 2; }
		done
	done
fi
perm=" --dangerously-skip-permissions"
$ask && perm=" --permission-mode default"

if $shell; then
	# cleaned too: wezterm hands the pane our env, and a claude typed there would inherit it
	cmd=("${CLEAN_ENV[@]}" "$SHELL")
else
	# built in pieces: an empty array expansion is unbound under bash 3.2 and set -u
	# env takes no option after an assignment, so the unset goes in front of CLEAN_ENV's
	if ((${#acct_env_args[@]})); then
		cmd=(env -u CLAUDE_CONFIG_DIR "${CLEAN_ENV[@]:1}")
		[[ ${acct_env_args[0]} != -u ]] && cmd+=("${acct_env_args[@]}")
	else
		cmd=("${CLEAN_ENV[@]}")
	fi
	cmd+=(claude)
	# with no mode named, Claude starts in auto mode, which is not prompts on
	if $ask; then cmd+=(--permission-mode default); else cmd+=(--dangerously-skip-permissions); fi
	[[ -n $effort ]] && cmd+=(--effort "$effort")
	[[ -n $model ]] && cmd+=(--model "$model")
	[[ -n $name ]] && cmd+=(--name "$name")
	# a resume never restores bypass, which is why the mode above is always passed
	if [[ -n $resume ]]; then
		cmd+=(--resume "$resume")
	else
		[[ -n $fork ]] && cmd+=(--resume "$fork" --fork-session)
		cmd+=(--session-id "$sid")
	fi
	if $worktree; then
		cmd+=(--worktree)
		[[ -n $wtname ]] && cmd+=("$wtname")
	fi
	# --worktree takes an optional value and would swallow a bare prompt as its name;
	# -- also keeps a prompt that opens with a dash from reading as a flag.
	[[ -n $prompt ]] && cmd+=(-- "$prompt")
fi

if [[ $where != window ]]; then
	[[ -n $pane ]] ||
		die "no pane to split from (run this inside wezterm, or pass --from, or --window)"
fi
# wezterm puts a new window without one in "default", a workspace Jacob does not use
window_ws=$workspace
if [[ $where == window && -z $window_ws && -n $pane ]]; then
	window_ws=$(wzcli list --format json 2>/dev/null | jq -r --arg p "$pane" \
		'.[] | select(.pane_id == ($p | tonumber)) | .workspace // empty' 2>/dev/null)
fi
[[ $where != window || -n $window_ws ]] ||
	die "--window needs a workspace: pass --workspace <name>, or --from a pane in it"

# --replace: the new pane waits for the old claude to exit, or the two would share a
# transcript for a moment. The pane is killed below, once the new one exists
if [[ -n $replace ]]; then
	old_pid=$(cc-roster --row "$pane" 2>/dev/null | cut -f7)
	if [[ $old_pid =~ ^[0-9]+$ ]]; then
		cmd=(/bin/sh -c 'while kill -0 "$0" 2>/dev/null; do sleep 0.2; done; exec "$@"' \
			"$old_pid" "${cmd[@]}")
	fi
fi

# One window per workspace: the GUI shows every window of the active workspace at once,
# so a second one is a second OS window over the first
tab_at=(--pane-id "$pane")
if [[ -n $workspace ]]; then
	ws_window=$(wzcli list --format json 2>/dev/null | jq -r --arg ws "$workspace" \
		'map(select(.workspace == $ws))[0].window_id // empty' 2>/dev/null)
	if [[ $ws_window =~ ^[0-9]+$ ]]; then
		where="tab"
		tab_at=(--window-id "$ws_window")
	fi
fi

if $dry; then
	printf 'would spawn %s%s in %s%s\n' "$where" "${window_ws:+ in workspace $window_ws}" "$cwd" "${replace:+, closing pane $pane}"
	if $shell; then
		printf '  %s\n' "$SHELL"
	else
		wt=""
		$worktree && wt=" --worktree${wtname:+ $wtname}"
		opts="${effort:+ --effort $effort}${model:+ --model $model}${name:+ --name $name}"
		if [[ -n $resume ]]; then
			opts+=" --resume $resume"
		else
			opts+="${fork:+ --resume $fork --fork-session} --session-id $sid"
		fi
		launch="${cmd[*]}"
		printf '  %s claude%s%s%s -- <prompt, %s chars>\n' "${launch%% claude *}" "$perm" \
			"$opts" "$wt" "${#prompt}"
	fi
	exit 0
fi

case $where in
tab) new=$(wzcli spawn "${tab_at[@]}" --cwd "$cwd" -- "${cmd[@]}") ;;
window) new=$(wzcli spawn --new-window --workspace "$window_ws" --cwd "$cwd" \
	-- "${cmd[@]}") ;;
*) new=$(wzcli split-pane --pane-id "$pane" "$where" --cwd "$cwd" -- "${cmd[@]}") ;;
esac

[[ -n $new ]] || die "wezterm would not open a pane"
# wezterm appends a tab after the window's last and the CLI cannot move one, so the GUI
# does it through the action queue (wz's format): beside the tab it was opened from
if [[ $where == tab && ${tab_at[0]} == --pane-id && $new =~ ^[0-9]+$ ]]; then
	actions="$HOME/.claude/fleet/actions.d"
	mkdir -p "$actions" 2>/dev/null
	tmp="${actions%/*}/.action.$$.$RANDOM"
	printf 'tabbeside\t%s\t%s\n' "$new" "$pane" >"$tmp" &&
		mv -f "$tmp" "$actions/$(date +%s)-$$-$RANDOM" || rm -f "$tmp"
fi
if $print_sid && [[ -n $sid ]]; then
	printf '%s\t%s\n' "$new" "$sid"
else
	printf '%s\n' "$new"
fi
# Last: with --replace from inside the session being replaced, this kills our own parent
[[ -n $replace ]] && wzcli kill-pane --pane-id "$pane" >/dev/null 2>&1
exit 0
