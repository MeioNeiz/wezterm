#!/bin/bash
# cc-tint - paint a Claude pane in its own identity colour, from the inside
#
# wezterm has no per-pane colour setting, but each pane is its own terminal with its own
# palette, so OSC 10/11 (text and ground, always together), 12 (cursor) and 17
# (selection) written to one pane's tty move that pane alone. Why, and the numbers, in
# docs/colour.md.
#
#   cc-tint --level off|whisper|faint|subtle|full   how much background, and remember it
#   cc-tint              paint this pane; reads session_id from stdin, for a SessionStart hook
#   cc-tint --all        paint every live Claude pane, for panes that started before this
#   cc-tint --pane N     paint one pane
#   cc-tint --reset      undo it everywhere (OSC 111/112/117 restore the defaults)
#
# Silent on stdout on purpose: a SessionStart hook's stdout is injected into the session.

set -u
# shellcheck source=bin/cc-colour
source "$HOME/.claude/bin/cc-colour" --lib

readonly MAP="$HOME/.claude/wezterm-sessions"
# What this last painted onto each pane, `<session id>\t<hue name>`. There is no reading a
# pane's colour back: an OSC 11 query is answered onto stdin, into Claude's input box.
readonly PAINTED="$HOME/.claude/cache/cc-tint-painted"

# ESC-backslash terminated, not BEL, which can reach the bell from a hook. The whole
# compound is wrapped because the redirection is what fails, and bash reports it itself.
paint() {
	local tty=$1 sid=$2 pane=${3-}
	id_colour "$sid" || return 0
	# off restores rather than skips, so turning it down reaches painted panes too
	if [[ -n $IDC_TINT ]]; then
		{ printf '\033]11;%s\033\\\033]10;%s\033\\' "$IDC_TINT" "$IDC_FG" >"$tty"; } 2>/dev/null
	else
		{ printf '\033]111\033\\\033]110\033\\' >"$tty"; } 2>/dev/null
	fi
	{ printf '\033]12;%s\033\\\033]17;%s\033\\' "#$IDC_HEX" "$IDC_SEL" >"$tty"; } 2>/dev/null
	if [[ -n $pane ]]; then
		mkdir -p "$PAINTED" 2>/dev/null
		printf '%s\t%s\n' "$sid" "$IDC_NAME" >"$PAINTED/$pane" 2>/dev/null
	fi
	return 0
}

unpaint() {
	local tty=$1 pane=${2-}
	[[ -n $pane ]] && rm -f "$PAINTED/$pane" 2>/dev/null
	{ printf '\033]110\033\\\033]111\033\\\033]112\033\\\033]117\033\\' >"$tty"; } 2>/dev/null
	return 0
}

# The tty of one pane, by pane id. Hooks run detached, so /dev/tty is not the pane.
pane_tty() {
	wezterm cli list --format json 2>/dev/null | python3 -c '
import json, sys
want = int(sys.argv[1])
for p in json.load(sys.stdin):
    if p["pane_id"] == want:
        print(p.get("tty_name") or "")
        break
' "$1" 2>/dev/null
}

# The pane tty, out of the claude this hook belongs to: its controlling terminal is the
# pane. `none` for a claude with no terminal, one nested inside another session's Bash
# tool, which inherits WEZTERM_PANE and would repaint a pane that is not its own. Empty
# if ps gave nothing, for the slower pane_tty. Hooks are detached, so one shell up at most.
claude_tty() {
	local ppid tty comm
	read -r ppid tty comm < <(ps -o ppid=,tty=,comm= -p "$PPID" 2>/dev/null)
	case ${comm##*/} in
	sh | bash | zsh | dash) read -r ppid tty comm < <(ps -o ppid=,tty=,comm= -p "$ppid" 2>/dev/null) ;;
	esac
	# no tty: ?? on macOS, ? on Linux
	if [[ $tty == "??" || $tty == "?" ]]; then
		printf 'none'
	elif [[ -n $tty ]]; then
		printf '/dev/%s' "$tty"
	fi
}

# pane id, tty, tab-relative order. Only panes the SessionStart hook has claimed, so a
# plain shell split keeps the colours it came with.
claude_panes() {
	wezterm cli list --format json 2>/dev/null | python3 -c '
import json, sys, os
home = os.path.expanduser("~")
for p in json.load(sys.stdin):
    pane = p["pane_id"]
    try:
        sid = open(f"{home}/.claude/wezterm-sessions/{pane}").read().strip()
    except OSError:
        continue
    if sid:
        print(pane, p["tty_name"], sid)
' 2>/dev/null
}

case ${1-} in
--level)
	[[ $# -eq 2 ]] || {
		printf 'usage: cc-tint --level off|whisper|faint|subtle|full\n' >&2
		exit 1
	}
	case $2 in
	off | whisper | faint | subtle | full) ;;
	*)
		printf 'cc-tint: no such level: %s\n' "$2" >&2
		exit 1
		;;
	esac
	printf '%s\n' "$2" >"$HOME/.claude/tint-level" || exit 1
	# Repaint now, so the level you just chose is the one on screen.
	while read -r pane tty sid; do
		paint "$tty" "$sid" "$pane"
	done < <(claude_panes)
	printf 'tint level: %s\n' "$2"
	;;
--all)
	while read -r pane tty sid; do
		paint "$tty" "$sid" "$pane"
	done < <(claude_panes)
	;;
--reset)
	while read -r pane tty _; do
		unpaint "$tty" "$pane"
	done < <(claude_panes)
	;;
--pane)
	[[ $# -eq 2 ]] || {
		printf 'usage: cc-tint --pane <pane-id>\n' >&2
		exit 1
	}
	while read -r pane tty sid; do
		[[ $pane == "$2" ]] && paint "$tty" "$sid" "$pane"
	done < <(claude_panes)
	;;
-h | --help)
	sed -n '/^#   cc-tint /,/^#$/p' "$0" | sed 's/^# \{0,2\}//'
	;;
"")
	# Hook mode, for SessionStart. The sid comes from the payload: the map is written by a
	# sibling hook running in parallel. A pane's palette outlives the program in it, so a
	# missed paint (a /clear, say) reads as the wrong colour, not as none.
	[[ -n ${WEZTERM_PANE:-} ]] || exit 0
	sid=$(sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([0-9a-fA-F-]*\)".*/\1/p')
	[[ -n $sid ]] || sid=$(cat "$MAP/$WEZTERM_PANE" 2>/dev/null)
	[[ -n $sid ]] || exit 0

	# A new session in a pane that had one lands at least ID_MIN_RING hues from the colour
	# it replaces. Not on resume or compact, which fire SessionStart with the same id.
	prev_sid=""
	prev_hue=""
	[[ -r $PAINTED/$WEZTERM_PANE ]] &&
		IFS=$'\t' read -r prev_sid prev_hue <"$PAINTED/$WEZTERM_PANE"
	if [[ -n $prev_hue && $prev_sid != "$sid" ]]; then
		hue=$(id_rehue "$sid" "$prev_hue") && [[ -n $hue ]] && id_autopin "$sid" "$hue"
	fi

	tty=$(claude_tty)
	[[ $tty == none ]] && exit 0
	[[ -n $tty ]] || tty=$(pane_tty "$WEZTERM_PANE")
	[[ -n $tty ]] && paint "$tty" "$sid" "$WEZTERM_PANE"
	;;
*)
	printf 'cc-tint: unknown option: %s\n' "$1" >&2
	exit 1
	;;
esac
exit 0
